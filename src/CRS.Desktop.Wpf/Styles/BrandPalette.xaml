<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- 小财牛视觉令牌：以保险库认证页为单一品牌源；控件与页面只引用键，不重复书写颜色。 -->
 <SolidColorBrush x:Key="BrandAccentBrush" Color="#C13D24"/>
 <SolidColorBrush x:Key="BrandAccentDarkBrush" Color="#A83A24"/>
 <SolidColorBrush x:Key="BrandAccentPaleBrush" Color="#FFF1E8"/>
 <SolidColorBrush x:Key="BrandAccentSoftBrush" Color="#FFF4E9"/>
 <SolidColorBrush x:Key="BrandCanvasBrush" Color="#FBF7F2"/>
 <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="BrandSurfaceAltBrush" Color="#FFFCF9"/>
 <SolidColorBrush x:Key="BrandHoverSurfaceBrush" Color="#FFF6EF"/>
 <SolidColorBrush x:Key="BrandPressedSurfaceBrush" Color="#FCE8DB"/>
 <SolidColorBrush x:Key="BrandBorderBrush" Color="#EADFD5"/>
 <SolidColorBrush x:Key="BrandBorderSubtleBrush" Color="#F0E6DC"/>
 <SolidColorBrush x:Key="BrandBorderStrongBrush" Color="#E5AD95"/>
 <SolidColorBrush x:Key="BrandScrollThumbBrush" Color="#CDBAAE"/>
 <SolidColorBrush x:Key="BrandTextPrimaryBrush" Color="#38251F"/>
 <SolidColorBrush x:Key="BrandTextSecondaryBrush" Color="#865F4B"/>
 <SolidColorBrush x:Key="BrandTextMutedBrush" Color="#846F60"/>
 <!-- 语义状态色：不能将涨跌、审核与业务风险误认为品牌强调色。 -->
 <SolidColorBrush x:Key="BrandStatusInfoBrush" Color="#475569"/>
 <SolidColorBrush x:Key="BrandStatusInfoSurfaceBrush" Color="#F1F5F9"/>
 <SolidColorBrush x:Key="BrandStatusSuccessBrush" Color="#166534"/>
 <SolidColorBrush x:Key="BrandStatusSuccessSurfaceBrush" Color="#F0FDF4"/>
 <SolidColorBrush x:Key="BrandStatusWarningBrush" Color="#92400E"/>
 <SolidColorBrush x:Key="BrandStatusWarningSurfaceBrush" Color="#FFFBEB"/>
 <SolidColorBrush x:Key="BrandStatusErrorBrush" Color="#B42318"/>
 <SolidColorBrush x:Key="BrandStatusErrorSurfaceBrush" Color="#FEF2F2"/>
 <!-- 面板说明、数据质量状态与通用标签共用的辅助文本资源。 -->
 <SolidColorBrush x:Key="BrandTextHintBrush" Color="#64748B"/>
</ResourceDictionary>
