<Window Icon="pack://application:,,,/CRS.Desktop.Wpf;component/Assets/Brand/XiaoCaiNiu.ico" x:Class="CRS.DesktopClient.Views.VaultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:services="clr-namespace:CRS.DesktopClient.Services" Title="{x:Static services:ProductIdentity.SecurityAccessTitle}" Width="620" Height="740" MinWidth="540" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{DynamicResource BrandCanvasBrush}" Foreground="{DynamicResource BrandTextPrimaryBrush}">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="ShowWhenTrue"/>
  <!-- 窗口内统一输入与按钮样式，保留原生密码控件和既有认证命令。 -->
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="16"/><Setter Property="AutomationProperties.Name" Value="密码或验证凭证"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,30" MaxWidth="500" HorizontalAlignment="Center" IsEnabled="{Binding IsIdle}">
  <!-- 使用交付的原始品牌素材，名称与口号集中取自 ProductIdentity。 -->
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
   <Image Source="pack://application:,,,/CRS.Desktop.Wpf;component/Assets/Brand/XiaoCaiNiu_256.png" Width="68" Height="68" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="小财牛品牌图标"/>
   <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
    <TextBlock Text="{x:Static services:ProductIdentity.Name}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource BrandTextPrimaryBrush}"/>
    <TextBlock Text="{x:Static services:ProductIdentity.Slogan}" FontSize="14" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,5,0,0"/>
   </StackPanel>
  </StackPanel>
  <Border Background="White" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="28">
  <StackPanel>
  <Border Background="{DynamicResource BrandAccentPaleBrush}" CornerRadius="10" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,16">
   <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="LockClosed24" Foreground="{DynamicResource BrandAccentDarkBrush}" FontSize="14" VerticalAlignment="Center"/><TextBlock Text="安全访问" Foreground="{DynamicResource BrandAccentDarkBrush}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"/></StackPanel>
  </Border>
  <TextBlock Text="{Binding PageHeading}" FontSize="26" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding PageDescription}" Foreground="#64748B" Margin="0,8,0,22" TextWrapping="Wrap" LineHeight="22"/>
  <!-- 日常手机验证不展示数据库路径；首次创建和用户主动选择位置时才展开。 -->
  <StackPanel x:Name="DirectoryPanel" Visibility="{Binding ShowDirectoryEntry,Converter={StaticResource ShowWhenTrue}}">
   <TextBlock Text="保险库目录（新建必须是空目录）"/><TextBox Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>
  </StackPanel>
  <!-- 主密码只在首次设置或本机凭证恢复时显示，日常登录不重复要求输入。 -->
  <StackPanel Visibility="{Binding ShowPasswordEntry,Converter={StaticResource ShowWhenTrue}}">
   <TextBlock Text="{Binding PasswordEntryLabel}" TextWrapping="Wrap"/><PasswordBox x:Name="PasswordInput" PasswordChanged="OnPassword" Margin="0,6"/>
   <TextBlock Text="主密码用于保护数据库资料和换电脑恢复，请离线妥善保存。" TextWrapping="Wrap" Foreground="#64748B"/>
  </StackPanel>
  <Button Content="首次创建并加密" Style="{StaticResource PrimaryAction}" Command="{Binding CreateCommand}" Visibility="{Binding IsNewVault,Converter={StaticResource ShowWhenTrue}}" Margin="0,12,0,8"/>
  <!-- 首次扫码只显示内存素材，不提供二维码保存或复制按钮。 -->
  <Border Background="{DynamicResource BrandSurfaceAltBrush}" BorderBrush="{DynamicResource BrandBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16"><StackPanel>
   <TextBlock Text="{Binding AuthenticationHint}" Foreground="#475569" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,8"/>
   <!-- 只有首次未绑定状态出现替代方式；验证器故障不会自动降级。 -->
   <StackPanel Visibility="{Binding ShowHelloChoice,Converter={StaticResource ShowWhenTrue}}" Margin="0,6,0,12">
    <TextBlock Text="默认使用下方 TOTP。首次没有验证器时，请先保存下方数据库恢复密钥，再明确选择 Windows Hello（PIN、指纹或人脸）。" TextWrapping="Wrap"/>
    <Button Content="首次没有验证器：选择 Windows Hello" Command="{Binding ChooseWindowsHelloCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
   </StackPanel>
   <Button Content="使用 Windows Hello 验证" Style="{StaticResource PrimaryAction}" Command="{Binding VerifyWindowsHelloCommand}" Visibility="{Binding ShowHelloVerification,Converter={StaticResource ShowWhenTrue}}" Margin="0,8"/>
   <StackPanel Visibility="{Binding ShowTotp,Converter={StaticResource ShowWhenTrue}}">
   <Image Source="{Binding EnrollmentQr}" Width="210" MaxHeight="210" Stretch="Uniform" HorizontalAlignment="Center"/>
   <TextBlock Text="手机验证码" FontWeight="SemiBold" Margin="0,8,0,8"/>
   <PasswordBox x:Name="CodeInput" PasswordChanged="OnCode" MaxLength="6" FontSize="24" Height="54" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="六位手机验证码" ToolTip="请输入验证器中的六位代码"/>
   <Button Content="验证并解锁" Style="{StaticResource PrimaryAction}" Command="{Binding VerifyCodeCommand}" Margin="0,14,0,12"/>
   <TextBlock Text="请打开手机验证器，输入当前六位代码。同一代码只能使用一次。" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" LineHeight="19"/>
   <StackPanel Visibility="{Binding HasMfaRecoveryCodes,Converter={StaticResource ShowWhenTrue}}">
    <TextBox Text="{Binding MfaRecoveryCodes,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8"/>
    <CheckBox Content="我已离线保存八条手机恢复码" IsChecked="{Binding MfaRecoverySaved}"/>
   </StackPanel>
   <Button Content="重新显示绑定二维码" Command="{Binding BeginEnrollmentCommand}" Visibility="{Binding ShowEnrollmentPanel,Converter={StaticResource ShowWhenTrue}}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
   </StackPanel>
  </StackPanel></Border>
  <!-- 反馈保留在验证区下方；准备与进入命令继续沿用原有权限及可执行条件。 -->
  <Border Background="{DynamicResource BrandAccentSoftBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" Visibility="{Binding ShowStatus,Converter={StaticResource ShowWhenTrue}}"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#475569" LineHeight="20"/></Border>
  <!-- 已经准备好的日常验证不再重复显示准备按钮；可进入时才显示工作区入口。 -->
  <WrapPanel Visibility="{Binding IsExistingVault,Converter={StaticResource ShowWhenTrue}}">
   <Button Content="{Binding UnlockLabel}" Command="{Binding UnlockCommand}" Margin="0,0,8,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
    <DataTrigger Binding="{Binding ShowTotp}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    <DataTrigger Binding="{Binding ShowHelloVerification}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    <DataTrigger Binding="{Binding ShowPasswordEntry}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
   </Style.Triggers></Style></Button.Style></Button>
  </WrapPanel>
  <Button Content="进入工作区" Command="{Binding ContinueCommand}" Margin="0,0,0,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryAction}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button>
  <!-- 恢复密钥只在创建时显示，离开向导必须确认已离线保存。 -->
  <StackPanel Visibility="{Binding HasDatabaseRecovery,Converter={StaticResource ShowWhenTrue}}">
   <TextBlock Text="新建恢复密钥（仅本次显示，请离线保存）"/><TextBox Text="{Binding RecoveryKey, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6"/>
   <CheckBox Content="我已离线保存恢复密钥，知道主密码与恢复密钥全部丢失后无法在新电脑恢复" IsChecked="{Binding RecoverySaved}" Margin="0,6"/>
  </StackPanel>
  <Expander Header="更换手机、恢复与加密备份" Visibility="{Binding ShowMaintenance,Converter={StaticResource ShowWhenTrue}}" IsExpanded="False" Margin="0,18,0,8"><StackPanel Margin="0,12,0,0">
   <CheckBox Content="选择其他数据库位置" IsChecked="{Binding ShowDirectoryOptions}" Margin="0,6"/>
   <CheckBox Content="本机凭证异常：使用原主密码重新启用本机登录" IsChecked="{Binding UseMasterPassword}" Margin="0,6"/>
   <TextBlock Text="主密码（改密及恢复时填写；不会用于日常登录）" TextWrapping="Wrap"/><PasswordBox x:Name="MaintenancePasswordInput" PasswordChanged="OnMaintenancePassword" Margin="0,6"/>
   <!-- Hello 用户只保留数据库恢复与改密，手机维护属于 TOTP 模式。 -->
   <StackPanel Visibility="{Binding ShowTotp,Converter={StaticResource ShowWhenTrue}}">
   <Button Content="验证当前密码与手机代码，更换绑定" Command="{Binding ReplacePhoneCommand}" HorizontalAlignment="Left" Margin="0,6"/>
   <TextBlock Text="手机丢失：填写主密码和一条未使用的手机恢复码" TextWrapping="Wrap"/>
   <PasswordBox x:Name="MfaRecoveryInput" PasswordChanged="OnMfaRecovery" Margin="0,6"/>
   <Button Content="消费恢复码并绑定新手机" Command="{Binding RecoverPhoneCommand}" HorizontalAlignment="Left" Margin="0,6"/>
   </StackPanel>
   <TextBlock Text="新主密码（修改或恢复时填写）"/><PasswordBox x:Name="NewPasswordInput" PasswordChanged="OnNewPassword" Margin="0,6"/>
   <TextBlock Text="恢复凭证（恢复密钥，或备份时的主密码）"/><PasswordBox x:Name="SecretInput" PasswordChanged="OnSecret" Margin="0,6"/>
   <WrapPanel Margin="0,8"><Button Content="验证旧密码并改密" Command="{Binding ChangePasswordCommand}" Margin="0,0,8,0"/><Button Content="用恢复密钥重设主密码" Command="{Binding ResetPasswordCommand}"/></WrapPanel>
   <!-- 容量只在已认证会话显示，接近上限时明确提示，避免直到升级时才发现无法备份。 -->
   <TextBlock Text="{Binding BackupCapacityHint}" TextWrapping="Wrap" Foreground="#92400E" Margin="0,6"/>
   <TextBlock Text="备份路径（.crsbak）"/><DockPanel Margin="0,6"><Button DockPanel.Dock="Right" Content="选择" Click="OnSelectBackup" Margin="8,0,0,0"/><TextBox Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
   <Button Content="创建加密备份（不覆盖已有文件）" Command="{Binding BackupCommand}" HorizontalAlignment="Left" Margin="0,6"/>
   <TextBlock Text="恢复目标（新的空目录）"/><TextBox Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>
   <CheckBox Content="使用恢复密钥解封备份；未勾选时使用备份时主密码" IsChecked="{Binding UseRecovery}" Margin="0,6"/>
   <Button Content="验证并恢复到新位置" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,6"/>
   <TextBlock Text="旧备份会带回当时的手机绑定和恢复码记录，不能保证旧凭证全局撤销。" TextWrapping="Wrap" Foreground="#64748B"/>
  </StackPanel></Expander>
  <TextBlock Text="旧明文库不会迁移或删除。原始报表、Excel 和结转导出仍需自行妥善管理。" Visibility="{Binding ShowMaintenance,Converter={StaticResource ShowWhenTrue}}" TextWrapping="Wrap" Foreground="#64748B"/>
  <Button Content="锁定保险库" Visibility="{Binding IsUnlocked,Converter={StaticResource ShowWhenTrue}}" Command="{Binding LockCommand}" HorizontalAlignment="Left" Margin="0,14"/>
  </StackPanel></Border>
  <TextBlock Text="验证身份后，开启你的小财牛工作区" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextMutedBrush}" FontSize="12" Margin="0,20,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
