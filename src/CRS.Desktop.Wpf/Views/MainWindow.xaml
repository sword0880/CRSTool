<ui:FluentWindow Icon="pack://application:,,,/CRS.Desktop.Wpf;component/Assets/Brand/XiaoCaiNiu.ico" x:Class="CRS.DesktopClient.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:pages="clr-namespace:CRS.DesktopClient.Views.Pages" xmlns:services="clr-namespace:CRS.DesktopClient.Services" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="{x:Static services:ProductIdentity.Name}" Width="1280" Height="880" MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{DynamicResource BrandCanvasBrush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BrandBorderBrush}">
   <ui:NavigationView x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="206" CompactPaneLength="56" IsPaneToggleVisible="False" IsBackButtonVisible="Collapsed" IsPaneOpen="False">
    <ui:NavigationView.MenuItems>
     <ui:NavigationViewItem Content="概览" TargetPageType="{x:Type pages:DashboardPage}" Icon="{ui:SymbolIcon Grid24}"/>
     <!-- 分类只组织导航；折叠态使用分类浮层，展开态使用内联菜单树。 -->
     <ui:NavigationViewItem x:Name="InvestmentGroup" Content="投资与数据" Icon="{ui:SymbolIcon Money24}" IsExpanded="False" Click="OnNavigationGroupClick" ToolTip="投资与数据">
      <ui:NavigationViewItem.MenuItems>
       <ui:NavigationViewItem Content="投资绩效" TargetPageType="{x:Type pages:PerformancePage}" Icon="{ui:SymbolIcon Money24}"/>
       <ui:NavigationViewItem Content="数据导入" TargetPageType="{x:Type pages:ImportPage}" Icon="{ui:SymbolIcon ArrowUpload24}"/>
       <ui:NavigationViewItem Content="交易记录" TargetPageType="{x:Type pages:TradesPage}" Icon="{ui:SymbolIcon DocumentText24}"/>
      </ui:NavigationViewItem.MenuItems>
     </ui:NavigationViewItem>
     <ui:NavigationViewItem x:Name="TaxGroup" Content="税务与报表" Icon="{ui:SymbolIcon Calculator24}" Click="OnNavigationGroupClick" ToolTip="税务与报表">
      <ui:NavigationViewItem.MenuItems>
       <ui:NavigationViewItem Content="FIFO 计算" TargetPageType="{x:Type pages:FifoPage}" Icon="{ui:SymbolIcon Calculator24}"/>
       <ui:NavigationViewItem Content="汇率管理" TargetPageType="{x:Type pages:ExchangeRatesPage}" Icon="{ui:SymbolIcon Money24}"/>
       <ui:NavigationViewItem Content="税务核算" TargetPageType="{x:Type pages:TaxCalculationPage}" Icon="{ui:SymbolIcon Calculator24}"/>
       <ui:NavigationViewItem Content="核对与复核" TargetPageType="{x:Type pages:ReconciliationPage}" Icon="{ui:SymbolIcon ClipboardTask24}"/>
       <ui:NavigationViewItem Content="报表导出" TargetPageType="{x:Type pages:ReportsPage}" Icon="{ui:SymbolIcon DocumentTable24}"/>
      </ui:NavigationViewItem.MenuItems>
     </ui:NavigationViewItem>
     <ui:NavigationViewItem x:Name="TasksGroup" Content="任务与服务" Icon="{ui:SymbolIcon CalendarClock24}" Click="OnNavigationGroupClick" ToolTip="任务与服务">
      <ui:NavigationViewItem.MenuItems>
       <ui:NavigationViewItem Content="导入历史" TargetPageType="{x:Type pages:HistoryPage}" Icon="{ui:SymbolIcon History24}"/>
      </ui:NavigationViewItem.MenuItems>
     </ui:NavigationViewItem>
     <ui:NavigationViewItem x:Name="ExtensionsGroup" Content="插件与扩展" Icon="{ui:SymbolIcon Apps24}" Click="OnNavigationGroupClick" ToolTip="插件与扩展"/>
    </ui:NavigationView.MenuItems>
    <ui:NavigationView.FooterMenuItems>
     <ui:NavigationViewItem Content="设置" Icon="{ui:SymbolIcon Settings24}" Click="OnSettings" IsEnabled="{Binding State.IsIdle}" ToolTip="设置" AutomationProperties.Name="打开统一设置"/>
     <!-- 数据库与备份统一从设置进入；主动锁定不能被后台忙碌状态挡住。 -->
     <ui:NavigationViewItem Content="锁定" Icon="{ui:SymbolIcon LockClosed24}" Click="OnLock"/>
    </ui:NavigationView.FooterMenuItems>
   </ui:NavigationView>
  </Border>
  <!-- NavigationView 在前，品牌栏的数据触发器才能稳定解析 ElementName。 -->
  <!-- 首次进入默认折叠侧栏，Logo及产品名不占首屏；顶栏压缩至40，展开后仍可查看品牌。 -->
  <!-- 非客户区命中区隔离：标题栏保留拖动及窗口按钮，左侧品牌按钮独立可交互。 -->
  <Grid Grid.Row="0" Height="40">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <!-- 品牌区与原生标题栏使用不同网格列，避免标题栏的拖拽命中覆盖点击。 -->
  <Grid x:Name="BrandHeader" Grid.Column="0" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center">
   <Grid.Style><Style TargetType="Grid"><Setter Property="Width" Value="56"/><Style.Triggers>
    <DataTrigger Binding="{Binding IsPaneOpen,ElementName=Navigation}" Value="True"><Setter Property="Width" Value="206"/></DataTrigger>
   </Style.Triggers></Style></Grid.Style>
   <!-- 保持导航按钮命中区，折叠态只显示展开符号，不显示Logo与品牌文字。 -->
   <Button x:Name="NavigationToggleButton" Click="OnNavigationToggleClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"
           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
           Width="Auto" Height="40">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource BrandNavigationToggle}">
     <Setter Property="ToolTip" Value="收起侧边栏"/>
     <Setter Property="AutomationProperties.Name" Value="收起侧边栏"/>
     <Style.Triggers><DataTrigger Binding="{Binding IsPaneOpen,ElementName=Navigation}" Value="False">
      <Setter Property="ToolTip" Value="展开侧边栏"/>
      <Setter Property="AutomationProperties.Name" Value="展开侧边栏"/>
     </DataTrigger></Style.Triggers>
    </Style></Button.Style>
    <Grid Height="40">
     <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Path Grid.Column="0" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"
           Stroke="{DynamicResource BrandTextSecondaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
           StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False">
      <Path.Style><Style TargetType="Path">
       <Setter Property="Data" Value="M4,3 H16 Q18,3 18,5 V15 Q18,17 16,17 H4 Q2,17 2,15 V5 Q2,3 4,3 Z M8,3 V17 M14,7 L11,10 L14,13"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsPaneOpen,ElementName=Navigation}" Value="False">
        <Setter Property="Data" Value="M4,3 H16 Q18,3 18,5 V15 Q18,17 16,17 H4 Q2,17 2,15 V5 Q2,3 4,3 Z M8,3 V17 M11,7 L14,10 L11,13"/>
       </DataTrigger></Style.Triggers>
      </Style></Path.Style>
     </Path>
     <StackPanel x:Name="BrandIdentity" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
       <DataTrigger Binding="{Binding IsPaneOpen,ElementName=Navigation}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers></Style></StackPanel.Style>
      <Image Source="pack://application:,,,/CRS.Desktop.Wpf;component/Assets/Brand/XiaoCaiNiu_256.png" Width="30" Height="30" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="{x:Static services:ProductIdentity.Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource BrandTextPrimaryBrush}"/>
     </StackPanel>
    </Grid>
   </Button>
  </Grid>
   <ui:TitleBar Grid.Column="1" Title="" AutomationProperties.Name="{x:Static services:ProductIdentity.Name}" Height="40" ShowClose="True" ShowMinimize="True" ShowMaximize="True" ForceShutdown="False"/>
  </Grid>
  <!-- 扩展页面跟随侧栏实时伸缩，不能保留打开页面时的旧偏移。 -->
  <Border x:Name="PluginSurface" Grid.Row="1" Background="{DynamicResource BrandCanvasBrush}" Visibility="Collapsed">
   <Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="56,0,0,0"/><Style.Triggers>
    <DataTrigger Binding="{Binding IsPaneOpen,ElementName=Navigation}" Value="True"><Setter Property="Margin" Value="206,0,0,0"/></DataTrigger>
   </Style.Triggers></Style></Border.Style>
   <ContentControl x:Name="PluginContent"/>
  </Border>
  <!-- 全局状态栏只展示 Worker 可验证的公开运行状态；不与当前业务页的取消令牌混用。 -->
  <Border x:Name="ShellFooter" Grid.Row="2" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,1,0,0"
          Background="{DynamicResource BrandSurfaceBrush}" Padding="12,3" MinHeight="36">
   <Grid VerticalAlignment="Center">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <ui:Button x:Name="FooterHealthButton" Grid.Column="0" Appearance="Transparent"
               Click="OnFooterServiceStatusClick" ToolTip="{Binding StatusBar.HealthDetail}"
               AutomationProperties.Name="查看后台服务健康详情" Padding="8,3">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse Width="8" Height="8" Margin="0,0,7,0">
       <Ellipse.Style>
        <Style TargetType="Ellipse">
         <Setter Property="Fill" Value="{DynamicResource BrandStatusWarningBrush}"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding StatusBar.HealthTone}" Value="Success">
           <Setter Property="Fill" Value="{DynamicResource BrandStatusSuccessBrush}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding StatusBar.HealthTone}" Value="Error">
           <Setter Property="Fill" Value="{DynamicResource BrandStatusErrorBrush}"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Ellipse.Style>
      </Ellipse>
      <TextBlock Text="{Binding StatusBar.HealthLabel}" Foreground="{DynamicResource BrandTextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
     </StackPanel>
    </ui:Button>
    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource BrandBorderSubtleBrush}" Margin="8,4,0,4">
     <ui:Button x:Name="FooterTasksButton" Appearance="Transparent" Click="OnFooterTaskCenterClick"
                Content="{Binding StatusBar.TaskLabel}" ToolTip="{Binding StatusBar.TaskDetail}"
                AutomationProperties.Name="查看后台运行与排队任务" Padding="10,3" FontSize="12"/>
    </Border>
    <ui:Button x:Name="FooterLastSyncButton" Grid.Column="3" Appearance="Transparent"
               Click="OnFooterRecentSyncClick" Content="{Binding StatusBar.LastSyncLabel}"
               ToolTip="{Binding StatusBar.LastSyncDetail}" AutomationProperties.Name="查看最近成功同步的执行记录"
               Padding="10,3" FontSize="12"/>
    <ui:Button x:Name="FooterIssuesButton" Grid.Column="4" Appearance="Transparent"
               Click="OnFooterIssuesClick" ToolTip="{Binding StatusBar.AttentionDetail}"
               AutomationProperties.Name="查看后台运行异常" Padding="10,3" FontSize="12">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding StatusBar.AttentionLabel}" Foreground="{DynamicResource BrandStatusWarningBrush}" VerticalAlignment="Center"/>
      <TextBlock Text="  ›" Foreground="{DynamicResource BrandTextMutedBrush}" VerticalAlignment="Center"/>
     </StackPanel>
    </ui:Button>
   </Grid>
  </Border>
 </Grid>
</ui:FluentWindow>
