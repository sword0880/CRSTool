<ui:FluentWindow x:Class="CRS.DesktopClient.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:pages="clr-namespace:CRS.DesktopClient.Views.Pages" Title="CRS Tax Manager" Width="1280" Height="880" MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#FBFCFD">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="CRS Tax Manager" Height="64" FontSize="23" FontWeight="Bold" ShowClose="True" ShowMinimize="True" ShowMaximize="True" ForceShutdown="False"/>
  <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB">
   <ui:NavigationView x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="206" CompactPaneLength="56" IsPaneToggleVisible="True" IsBackButtonVisible="Collapsed" IsPaneOpen="True">
    <ui:NavigationView.MenuItems>
     <ui:NavigationViewItem Content="概览" TargetPageType="{x:Type pages:DashboardPage}" Icon="{ui:SymbolIcon Grid24}"/>
     <ui:NavigationViewItem Content="数据导入" TargetPageType="{x:Type pages:ImportPage}" Icon="{ui:SymbolIcon ArrowUpload24}"/>
     <ui:NavigationViewItem Content="交易记录" TargetPageType="{x:Type pages:TradesPage}" Icon="{ui:SymbolIcon DocumentText24}"/>
     <ui:NavigationViewItem Content="FIFO 计算" TargetPageType="{x:Type pages:FifoPage}" Icon="{ui:SymbolIcon Calculator24}"/>
     <ui:NavigationViewItem Content="汇率管理" TargetPageType="{x:Type pages:ExchangeRatesPage}" Icon="{ui:SymbolIcon Money24}"/>
     <ui:NavigationViewItem Content="税务核算" TargetPageType="{x:Type pages:TaxCalculationPage}" Icon="{ui:SymbolIcon Calculator24}"/>
     <ui:NavigationViewItem Content="核对与复核" TargetPageType="{x:Type pages:ReconciliationPage}" Icon="{ui:SymbolIcon ClipboardTask24}"/>
     <ui:NavigationViewItem Content="报表导出" TargetPageType="{x:Type pages:ReportsPage}" Icon="{ui:SymbolIcon DocumentTable24}"/>
    </ui:NavigationView.MenuItems>
    <ui:NavigationView.FooterMenuItems>
     <ui:NavigationViewItem Content="历史任务" TargetPageType="{x:Type pages:HistoryPage}" Icon="{ui:SymbolIcon History24}"/>
     <ui:NavigationViewItem Content="设置" Icon="{ui:SymbolIcon Settings24}" Click="OnSettings" IsEnabled="{Binding State.IsIdle}" ToolTip="设置" AutomationProperties.Name="打开日志和数据库设置"/>
    </ui:NavigationView.FooterMenuItems>
   </ui:NavigationView>
  </Border>
  <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="18,10"><DockPanel>
   <ui:Button DockPanel.Dock="Right" Content="取消操作" Command="{Binding Import.CancelCommand}" Appearance="Transparent" Margin="10,0,0,0"/>
   <StackPanel><TextBlock Text="{Binding State.Status}" TextWrapping="Wrap" Foreground="#64748B"/>
    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" Visibility="{Binding State.IsBusy, Converter={StaticResource BooleanVisibility}}"/>
   </StackPanel>
  </DockPanel></Border>
 </Grid>
</ui:FluentWindow>
