<ui:FluentWindow Icon="pack://application:,,,/CRS.Desktop.Wpf;component/Assets/Brand/XiaoCaiNiu.ico" x:Class="CRS.DesktopClient.Views.ExecutionLogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 Title="运行日志" Width="980" Height="700" MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource BrandCanvasBrush}" Foreground="{DynamicResource BrandTextPrimaryBrush}">
 <ui:FluentWindow.Resources>
  <!-- 日志滚动条始终可见，独立于主题的自动隐藏样式；支持拖动、滚轮及翻页。 -->
  <Style x:Key="LogScrollBar" TargetType="ScrollBar">
   <Setter Property="Width" Value="18"/><Setter Property="Background" Value="{DynamicResource BrandHoverSurfaceBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" CornerRadius="7" Margin="0,4,2,4">
    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.Resources><sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">80</sys:Double></Track.Resources>
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
     <Track.Thumb><Thumb MinHeight="40"><Thumb.Style><Style TargetType="Thumb"><Setter Property="Background" Value="{DynamicResource BrandScrollThumbBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2,1"/></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BrandScrollThumbBrush}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{DynamicResource BrandAccentBrush}"/></Trigger></Style.Triggers></Style></Thumb.Style></Thumb></Track.Thumb>
    </Track>
   </Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LogScrollViewer" TargetType="ScrollViewer">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="False" Margin="{TemplateBinding Padding}"/>
    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource LogScrollBar}" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset,RelativeSource={RelativeSource TemplatedParent},Mode=OneWay}" Visibility="Visible" Scroll="OnLogScroll"/>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LogButton" TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#475569"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
  </Style>
 </ui:FluentWindow.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="运行日志" ShowClose="True" ShowMaximize="True" ShowMinimize="False" ForceShutdown="False"/>
  <Border Grid.Row="1" Margin="24,8,24,16" Padding="16,12" Background="White" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="14">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource BrandAccentPaleBrush}" Margin="0,0,14,0"><ui:SymbolIcon Symbol="CalendarClock24" FontSize="24" Foreground="{DynamicResource BrandAccentBrush}"/></Border>
     <StackPanel Grid.Column="1"><TextBlock Text="任务运行日志" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding TaskLabel}" FontSize="12" Foreground="#64748B" Margin="0,5,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TaskLabel}"/></StackPanel>
     <Border Grid.Column="2" Background="{Binding StateBackground}" CornerRadius="12" Padding="12,5" VerticalAlignment="Top"><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateForeground}" FontWeight="SemiBold"/></Border>
    </Grid>
    <StackPanel Grid.Row="1" Margin="0,6,0,0"><Expander Header="执行详情"><TextBlock Text="{Binding ExecutionId,StringFormat=执行 ID：{0}}" Foreground="#64748B" FontSize="12"/></Expander>
     <Border Background="{DynamicResource BrandAccentPaleBrush}" CornerRadius="8" Padding="12,9" Margin="0,6,0,0"><TextBlock Text="{Binding ProgressLabel}" Foreground="{DynamicResource BrandTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="19"/></Border>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="2" Margin="24,0" Background="White" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0,0,4,4">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource BrandBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,8"><StackPanel>
     <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource LogButton}" Content="开头" Click="OnScrollStart" Padding="10,5" MinHeight="30" Margin="0,0,6,0"/><Button x:Name="LatestButton" Style="{StaticResource LogButton}" Content="回到最新" Click="OnScrollEnd" Padding="10,5" MinHeight="30" Margin="0,0,6,0"/><Button Style="{StaticResource LogButton}" Content="复制全部" Click="OnCopy" Padding="10,5" MinHeight="30"/></StackPanel><TextBlock x:Name="FollowLabel" Text="正在跟随最新日志" Foreground="#64748B" VerticalAlignment="Center"/></DockPanel>
     <WrapPanel Margin="0,8,0,0"><TextBlock Text="搜索" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Width="220" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索日志" ToolTip="输入关键词搜索本次执行日志" Margin="0,0,12,0"/><CheckBox Content="只看异常与等待" IsChecked="{Binding OnlyIssues}" VerticalAlignment="Center"/><TextBlock Text="北京时间 · 每3秒刷新" Foreground="#94A3B8" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"/></WrapPanel>
    </StackPanel></Border>
    <!-- 原生只读文本仍可选择复制；固定可用高度，长日志在区域内滚动。 -->
    <TextBox x:Name="LogEditor" Grid.Row="1" Text="{Binding LogText,Mode=OneWay}" PreviewMouseWheel="OnLogWheel" PreviewKeyDown="OnLogKeyDown" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas, Microsoft YaHei" FontSize="13" TextBlock.LineHeight="22" TextBlock.LineStackingStrategy="BlockLineHeight" Foreground="#334155" Background="White" BorderThickness="0" Padding="16,12" AutomationProperties.Name="本次任务运行日志">
     <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource LogScrollViewer}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Focusable="False" ScrollChanged="OnViewportChanged"/></ControlTemplate></TextBox.Template>
    </TextBox>
   </Grid>
  </Border>
  <Grid Grid.Row="3" Margin="24,16,24,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding Status}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource LogButton}" Content="刷新日志" Background="{DynamicResource BrandAccentBrush}" Foreground="White" BorderBrush="{DynamicResource BrandAccentBrush}" Command="{Binding RefreshCommand}"/><Button x:Name="CloseButton" Style="{StaticResource LogButton}" Content="关闭" Click="OnClose" Margin="10,0,0,0"/></StackPanel>
  </Grid>
 </Grid>
</ui:FluentWindow>
