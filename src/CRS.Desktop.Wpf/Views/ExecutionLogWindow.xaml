<ui:FluentWindow x:Class="CRS.DesktopClient.Views.ExecutionLogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="运行日志" Width="860" Height="580" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FBFCFD">
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="运行日志" ShowClose="True" ShowMaximize="True" ShowMinimize="False" ForceShutdown="False"/>
  <StackPanel Grid.Row="1" Margin="24,12,24,16"><TextBlock Text="{Binding TaskLabel}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding ExecutionId,StringFormat=执行 ID：{0}}" Foreground="#64748B" Margin="0,8,0,4"/>
   <TextBlock Text="所有时间均为北京时间（UTC+08:00）" Foreground="#64748B"/></StackPanel>
  <!-- 文本可选中复制，刷新只查询该执行，不触发新任务。 -->
  <TextBox Grid.Row="2" Margin="24,0" Text="{Binding LogText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="16" FontFamily="Consolas, Microsoft YaHei" AutomationProperties.Name="本次任务运行日志"/>
  <DockPanel Grid.Row="3" Margin="24,16,24,20"><Button DockPanel.Dock="Right" Content="关闭" Click="OnClose" Margin="8,0,0,0" Padding="14,6"/><Button DockPanel.Dock="Right" Content="刷新日志" Command="{Binding RefreshCommand}" Padding="14,6"/>
   <TextBlock Text="{Binding Status}" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel>
 </Grid>
</ui:FluentWindow>
