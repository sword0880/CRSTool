<ui:FluentWindow Icon="pack://application:,,,/CRS.Desktop.Wpf;component/Assets/Brand/XiaoCaiNiu.ico" x:Class="CRS.DesktopClient.Views.MaintenancePlanWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="任务详情" Width="720" Height="600" MinWidth="620" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource BrandCanvasBrush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="任务详情" ShowClose="True" ShowMaximize="False" ShowMinimize="False" ForceShutdown="False"/>
  <StackPanel Grid.Row="1" Margin="24,10,24,14">
   <TextBlock Text="{Binding Name}" Style="{StaticResource TaskPlanHeading}"/>
   <TextBlock Style="{StaticResource TaskPlanIdentity}">
    <TextBlock.Text><MultiBinding StringFormat="{}{0} / {1}"><Binding Path="PluginId"/><Binding Path="JobId"/></MultiBinding></TextBlock.Text>
   </TextBlock>
   <TextBlock Text="{Binding Cleanup.AutomaticPlanStatus,FallbackValue=状态未确认}" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="24,0,18,0" Padding="0,0,6,0">
   <StackPanel>
    <Border Style="{StaticResource TaskPlanCard}"><StackPanel>
     <TextBlock Text="清理规则" Style="{StaticResource TaskPlanCaption}"/>
     <TextBlock x:Name="PlanRetention" Text="{Binding Cleanup.AutomaticPlanPolicy,FallbackValue=计划详情未确认}" TextWrapping="Wrap" LineHeight="20"/>
    </StackPanel></Border>
    <TextBlock Text="Cron 表达式" Style="{StaticResource TaskPlanCaption}" Margin="0,16,0,6"/>
    <TextBox x:Name="PlanCron" Text="{Binding Cron,Mode=OneWay}" Style="{StaticResource TaskPlanCron}" AutomationProperties.Name="任务 Cron 表达式"/>
    <TextBlock Text="时区" Style="{StaticResource TaskPlanCaption}" Margin="0,14,0,6"/>
    <TextBlock Text="北京时间（UTC+08:00）" AutomationProperties.Name="任务计划时区" Margin="0,6"/>
    <Border Style="{StaticResource TaskPlanTimesCard}"><StackPanel>
     <TextBlock Text="执行时间（北京时间）" FontWeight="SemiBold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
     <Grid Margin="0,8,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="上次执行" Margin="0,2,16,2"/>
      <TextBlock x:Name="PlanLastStarted" Grid.Column="1" Text="{Binding LastStartedText}" FontFamily="Consolas, Microsoft YaHei" Margin="0,2"/>
      <TextBlock Grid.Row="1" Text="下次执行" Margin="0,2,16,2"/>
      <TextBlock x:Name="PlanNextDue" Grid.Row="1" Grid.Column="1" Text="{Binding NextDueText}" FontFamily="Consolas, Microsoft YaHei" Margin="0,2"/>
     </Grid>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="3" Margin="24,14,24,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="自动清理由后台管理。可在设置中提交一次清理任务。" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
   <Button Grid.Column="1" Content="关闭" IsCancel="True" Padding="18,8" Click="OnClose"/>
  </Grid>
 </Grid>
</ui:FluentWindow>
