<UserControl x:Class="CRS.DesktopClient.Views.AI.AiAssistantPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:CRS.DesktopClient.Views.AI">
 <UserControl.Resources><local:ScreenshotPreviewConverter x:Key="ScreenshotPreview"/></UserControl.Resources>
 <Grid Background="{DynamicResource BrandSurfaceBrush}" Margin="14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel LastChildFill="True" Margin="0,0,0,10">
   <!-- 常用窗口操作采用图标，悬停提示与辅助技术仍可读出操作名称。 -->
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
    <ui:Button x:Name="NewChatButton" Icon="{ui:SymbolIcon ChatAdd20}" Appearance="Transparent"
               Width="32" Height="32" Padding="0" Command="{Binding NewChatCommand}"
               ToolTip="新对话" AutomationProperties.Name="新对话"/>
    <ui:Button x:Name="DetachButton" Icon="{ui:SymbolIcon WindowNew20}" Appearance="Transparent"
               Width="32" Height="32" Padding="0" Click="OnDetach"
               ToolTip="弹出置顶窗口" AutomationProperties.Name="弹出置顶窗口"/>
    <ui:Button x:Name="CollapseButton" Icon="{ui:SymbolIcon ChevronDown20}" Appearance="Transparent"
               Width="32" Height="32" Padding="0" Click="OnCollapse"
               ToolTip="收起助手" AutomationProperties.Name="收起助手"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="小财牛助手" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding DefaultModelLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DefaultModelLabel}"
               Foreground="{DynamicResource BrandTextHintBrush}" Margin="0,4,4,0"/>
   </StackPanel>
  </DockPanel>
  <local:AiChatTranscript Grid.Row="1" Entries="{Binding Entries}"/>
  <StackPanel Grid.Row="2" Margin="0,6">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding Usage}" FontSize="11" Foreground="{DynamicResource BrandTextHintBrush}" TextWrapping="Wrap"/>
  </StackPanel>
  <!-- 截图在发送前始终显示，保留选项随每次附件重置。 -->
  <Border Grid.Row="3" Padding="8" Margin="0,0,0,6" BorderThickness="1" CornerRadius="5"
          BorderBrush="{DynamicResource BrandBorderBrush}" Visibility="{Binding HasScreenshot, Converter={StaticResource BooleanVisibility}}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Image Source="{Binding Screenshot, Converter={StaticResource ScreenshotPreview}}" MaxHeight="80"
           HorizontalAlignment="Left" AutomationProperties.Name="待发送截图"/>
    <StackPanel Grid.Column="1" Margin="8,0,0,0">
     <TextBlock Text="截图随本条消息发给当前模型" TextWrapping="Wrap"/>
     <CheckBox Content="在历史中保留截图" IsChecked="{Binding KeepScreenshot}" IsEnabled="{Binding CanEditDraft}" Margin="0,4"/>
     <WrapPanel>
      <ui:Button Icon="{ui:SymbolIcon Crop20}" Appearance="Transparent" Width="32" Height="32" Padding="0"
                 Click="OnCrop" IsEnabled="{Binding CanEditDraft}" ToolTip="裁剪截图" AutomationProperties.Name="裁剪截图"/>
      <ui:Button Icon="{ui:SymbolIcon DismissCircle20}" Appearance="Transparent" Width="32" Height="32" Padding="0"
                 Command="{Binding RemoveScreenshotCommand}" ToolTip="移除截图" AutomationProperties.Name="移除截图"/>
     </WrapPanel>
    </StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="4">
   <TextBlock Text="问题、近期对话和所选截图会发给当前模型。" FontSize="11"
              Foreground="{DynamicResource BrandTextHintBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
   <!-- 组合式输入区：文字区域随内容增长，截图/粘贴与发送操作固定在底部。 -->
   <Border Padding="12,8,10,10" CornerRadius="20" BorderThickness="1">
    <Border.Style>
     <Style TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBorderBrush}"/>
      <Setter Property="Background" Value="{DynamicResource BrandSurfaceAltBrush}"/>
      <Style.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}"/>
       </Trigger>
      </Style.Triggers>
     </Style>
    </Border.Style>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBox x:Name="PromptInput" Grid.Row="0"
              Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="问小财牛"
              ToolTip="输入问题，Enter 换行，Ctrl+Enter 发送" PreviewKeyDown="OnPromptKey"
              AcceptsReturn="True" TextWrapping="Wrap" MinLines="1" MaxLines="6" MinHeight="44" MaxHeight="132"
              BorderThickness="0" Background="Transparent" Padding="4,2"
              IsEnabled="{Binding CanEditDraft}" MaxLength="4000"
              VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
     <TextBlock Text="向小财牛提问…" Margin="4,4" Foreground="{DynamicResource BrandTextHintBrush}"
                IsHitTestVisible="False" VerticalAlignment="Top">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding Prompt}" Value="">
          <Setter Property="Visibility" Value="Visible"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
     <Grid Grid.Row="1" Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding CanEditDraft}">
       <ui:Button x:Name="CaptureButton" Icon="{ui:SymbolIcon Cut24}" Appearance="Transparent" Width="36" Height="36" Padding="0"
                  Click="OnCapture" ToolTip="截取当前页面选区" AutomationProperties.Name="截取当前页面选区"/>
       <ui:Button Icon="{ui:SymbolIcon ClipboardImage20}" Appearance="Transparent" Width="36" Height="36" Padding="0"
                  Click="OnPaste" ToolTip="粘贴截图" AutomationProperties.Name="粘贴截图"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <ui:Button Content="取消" Command="{Binding CancelCommand}" Margin="0,0,6,0"
                  Visibility="{Binding Busy, Converter={StaticResource BooleanVisibility}}"/>
       <ui:Button Content="↑" FontSize="20" Width="38" Height="38" Padding="0"
                  Command="{Binding AskCommand}" Appearance="Primary" ToolTip="发送消息"
                  AutomationProperties.Name="发送消息"/>
      </StackPanel>
     </Grid>
    </Grid>
   </Border>
  </StackPanel>
 </Grid>
</UserControl>
