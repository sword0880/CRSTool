<UserControl x:Class="CRS.DesktopClient.Views.AI.AiChatTranscript"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CRS.DesktopClient.Views.AI" x:Name="Transcript">
 <UserControl.Resources>
  <local:ScreenshotPreviewConverter x:Key="ScreenshotPreview"/>
 </UserControl.Resources>
 <!-- 问答保留为纯文本，截图只在用户曾选择保留时展示。 -->
 <ListBox x:Name="MessageList" ItemsSource="{Binding Entries, ElementName=Transcript}"
          BorderThickness="0" Background="Transparent" Padding="0"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="聊天消息"
          HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True">
  <ListBox.ItemTemplate>
   <DataTemplate>
    <StackPanel Margin="0,0,8,12">
     <TextBlock Text="你" FontWeight="SemiBold" Foreground="{DynamicResource BrandAccentBrush}"/>
     <TextBox Text="{Binding Question, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
              TextWrapping="Wrap" Padding="0,4,0,5"/>
     <Image Source="{Binding Screenshot, Converter={StaticResource ScreenshotPreview}}" MaxHeight="160"
            Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="已保留的截图">
      <Image.Style><Style TargetType="Image"><Style.Triggers><Trigger Property="Source" Value="{x:Null}">
       <Setter Property="Visibility" Value="Collapsed"/>
      </Trigger></Style.Triggers></Style></Image.Style>
     </Image>
     <TextBlock Text="小财牛助手" FontWeight="SemiBold" Margin="0,8,0,0"/>
     <TextBox Text="{Binding Answer, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
              TextWrapping="Wrap" Padding="0,4,0,4"/>
    </StackPanel>
   </DataTemplate>
  </ListBox.ItemTemplate>
 </ListBox>
</UserControl>
