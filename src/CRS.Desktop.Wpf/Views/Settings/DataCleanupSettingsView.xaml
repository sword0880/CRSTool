<UserControl x:Class="CRS.DesktopClient.Views.Settings.DataCleanupSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <StackPanel DataContext="{Binding Cleanup}">
  <TextBlock Text="提交后台清理任务" FontSize="18" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding TaskAccessMessage}" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextHintBrush}" FontSize="12" Margin="0,10,0,16"/>
  <ui:Button x:Name="SubmitCleanupTaskButton" Content="提交清理任务" Command="{Binding SubmitTaskCommand}" Appearance="Primary" HorizontalAlignment="Left"/>
  <TextBlock Text="{Binding TaskMessage}" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextHintBrush}" FontSize="12" Margin="0,12,0,0"/>
 </StackPanel>
</UserControl>
