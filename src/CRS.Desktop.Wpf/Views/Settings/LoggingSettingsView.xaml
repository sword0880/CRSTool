<UserControl x:Class="CRS.DesktopClient.Views.Settings.LoggingSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <StackPanel>
  <TextBlock Text="桌面日志" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,0"/>
  <TextBlock Text="桌面日志设置保存后立即生效。" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextHintBrush}" Margin="0,8,0,0"/>
     <CheckBox Content="启用日志" IsChecked="{Binding LoggingEnabled}" Margin="0,12,0,4"/>
     <TextBlock Text="日志目录" Style="{StaticResource InputLabel}"/>
     <DockPanel><ui:Button DockPanel.Dock="Right" Content="浏览" Command="{Binding BrowseLogsCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
     <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="最低日志级别" Style="{StaticResource InputLabel}"/><ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="保留归档数" Style="{StaticResource InputLabel}"/><ui:NumberBox Value="{Binding LogRetentionFiles, Mode=TwoWay}" Minimum="1" Maximum="365" MaxDecimalPlaces="0"/></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="单文件上限（MB）" Style="{StaticResource InputLabel}"/><ui:NumberBox Value="{Binding LogFileSizeMb, Mode=TwoWay}" Minimum="1" Maximum="100" MaxDecimalPlaces="0"/></StackPanel>
     </Grid>
  <Separator Margin="0,20,0,12"/>
  <TextBlock Text="后台服务日志" FontWeight="SemiBold" FontSize="16"/>
  <TextBlock Text="资料清理会移除超过保留期的后台诊断文件。任务执行记录可在任务中心查看。" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextHintBrush}" Margin="0,6,0,0"/>
  <TextBlock Text="保留天数" Style="{StaticResource InputLabel}"/>
  <StackPanel Orientation="Horizontal">
   <ui:NumberBox x:Name="WorkerLogRetentionBox" Value="{Binding WorkerLogRetentionDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditWorkerLogSettings}" Minimum="1" Maximum="365" MaxDecimalPlaces="0" Width="128" AutomationProperties.Name="后台日志保留天数"/>
   <ui:Button Content="刷新" Command="{Binding RefreshWorkerLogSettingsCommand}" Margin="8,0,0,0"/>
  </StackPanel>
  <TextBlock Text="{Binding WorkerLogSettingsMessage}" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextHintBrush}" Margin="0,8,0,0"/>
 </StackPanel>
</UserControl>
