<ui:FluentWindow Icon="pack://application:,,,/CRS.Desktop.Wpf;component/Assets/Brand/XiaoCaiNiu.ico" x:Class="CRS.DesktopClient.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:CRS.DesktopClient.ViewModels" xmlns:settings="clr-namespace:CRS.DesktopClient.Views.Settings" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="设置" Width="1040" Height="780" MinWidth="860" MinHeight="640" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource BrandCanvasBrush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="系统设置" ShowClose="True" ShowMaximize="True" ShowMinimize="False" ForceShutdown="False"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <!-- 分类目录固定在左侧，新增设置不再增加整页的纵向查找成本。 -->
   <Border Background="{DynamicResource BrandSurfaceAltBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,0,1,0" Padding="16,20,16,16">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="设置" Style="{DynamicResource UiPageTitle}" Margin="8,0,0,16"/>
      <ui:TextBox x:Name="SectionSearchBox" Text="{Binding SectionSearch,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索设置分类" AutomationProperties.Name="搜索设置分类" ToolTip="按分类名称或关键词查找，例如 SMTP、备份、密码" Margin="0,0,0,16"/>
     </StackPanel>
     <TextBlock DockPanel.Dock="Bottom" Text="切换分类会保留未保存的输入。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource BrandTextHintBrush}" Margin="8,16,8,0"/>
     <TreeView x:Name="SectionNavigation" ItemsSource="{Binding NavigationGroups}" SelectedItemChanged="OnSectionSelected" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="设置分类目录">
      <TreeView.Resources>
       <HierarchicalDataTemplate DataType="{x:Type vm:SettingsGroup}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/></HierarchicalDataTemplate>
       <DataTemplate DataType="{x:Type vm:SettingsSection}"><TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap"/></DataTemplate>
      </TreeView.Resources>
      <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True"/><Setter Property="IsSelected" Value="{Binding IsSelected,Mode=TwoWay}"/><Setter Property="Padding" Value="6,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></TreeView.ItemContainerStyle>
     </TreeView>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="28,20,24,16">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoSectionMatches,Converter={StaticResource BooleanVisibility}}"><TextBlock Text="没有匹配的设置分类" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="试试“邮件”“备份”或“日志”，也可以清空搜索。" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextHintBrush}" Margin="0,12,0,0"/></StackPanel>
    <Grid Visibility="{Binding HasSelectedSection,Converter={StaticResource BooleanVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20"><TextBlock Text="{Binding SelectedSection.Breadcrumb}" Foreground="{DynamicResource BrandTextHintBrush}" FontSize="12" Margin="0,0,0,12"/><TextBlock Text="{Binding SelectedSection.Title}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedSection.Description}" Foreground="{DynamicResource BrandTextHintBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
     <ScrollViewer x:Name="SectionContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <Border Padding="24" VerticalAlignment="Top" Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="8"><Grid IsEnabled="{Binding State.IsIdle}">
<settings:StorageSettingsView x:Name="StorageSection">
 <settings:StorageSettingsView.Style>
  <Style TargetType="settings:StorageSettingsView">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding SelectedSection.Key}" Value="storage"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </settings:StorageSettingsView.Style>
</settings:StorageSettingsView>
<settings:SecuritySettingsView x:Name="SecuritySection">
 <settings:SecuritySettingsView.Style>
  <Style TargetType="settings:SecuritySettingsView">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding SelectedSection.Key}" Value="security"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </settings:SecuritySettingsView.Style>
</settings:SecuritySettingsView>
<settings:DocumentSettingsView x:Name="DocumentsSection">
 <settings:DocumentSettingsView.Style>
  <Style TargetType="settings:DocumentSettingsView">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding SelectedSection.Key}" Value="documents"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </settings:DocumentSettingsView.Style>
</settings:DocumentSettingsView>
<settings:EmailSettingsView x:Name="NotificationsSection">
 <settings:EmailSettingsView.Style>
  <Style TargetType="settings:EmailSettingsView">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding SelectedSection.Key}" Value="notifications"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </settings:EmailSettingsView.Style>
</settings:EmailSettingsView>
<settings:DingTalkSettingsView x:Name="DingTalkSection">
 <settings:DingTalkSettingsView.Style>
  <Style TargetType="settings:DingTalkSettingsView">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding SelectedSection.Key}" Value="dingtalk"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </settings:DingTalkSettingsView.Style>
</settings:DingTalkSettingsView>
<settings:WeChatSettingsView x:Name="WeChatSection">
 <settings:WeChatSettingsView.Style>
  <Style TargetType="settings:WeChatSettingsView">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding SelectedSection.Key}" Value="wechat"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </settings:WeChatSettingsView.Style>
</settings:WeChatSettingsView><settings:LoggingSettingsView x:Name="LoggingSection">
 <settings:LoggingSettingsView.Style><Style TargetType="settings:LoggingSettingsView">
  <Setter Property="Visibility" Value="Collapsed"/>
  <Style.Triggers><DataTrigger Binding="{Binding SelectedSection.Key}" Value="logging"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
 </Style></settings:LoggingSettingsView.Style>
</settings:LoggingSettingsView>
      </Grid></Border>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
  <!-- 底部保存区常驻；保存继续处理跨分类改动，测试通知必须单独点击。 -->
  <Border Grid.Row="2" Padding="24,14" Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextHintBrush}" FontSize="12"/><TextBlock Text="保存设置会处理所有分类的改动；测试通知需单独发送。" Foreground="{DynamicResource BrandTextHintBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ui:Button x:Name="SaveSettingsButton" Content="保存设置" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,10,0"/><ui:Button Content="关闭" Click="OnClose"/></StackPanel>
  </Grid></Border>
 </Grid>
</ui:FluentWindow>
