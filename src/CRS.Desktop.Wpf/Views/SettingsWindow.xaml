<ui:FluentWindow x:Class="CRS.DesktopClient.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="设置" Width="680" Height="600" MinWidth="620" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FBFCFD">
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="设置" ShowClose="True" ShowMaximize="False" ShowMinimize="False" ForceShutdown="False"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,8,24,12" IsEnabled="{Binding State.IsIdle}">
   <TextBlock Text="数据库" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock Text="数据库目录（目录中的 crs.db）" Style="{StaticResource InputLabel}"/>
   <DockPanel><ui:Button DockPanel.Dock="Right" Content="浏览" Command="{Binding BrowseDatabaseCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding DatabaseDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
   <TextBlock Text="选择已有数据库目录可继续使用历史；新目录会创建空数据库。原数据库不会自动迁移或删除。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,16"/>
   <TextBlock Text="日志" FontSize="20" FontWeight="SemiBold"/>
   <CheckBox Content="启用日志" IsChecked="{Binding LoggingEnabled}" Margin="0,12,0,4"/>
   <TextBlock Text="日志目录" Style="{StaticResource InputLabel}"/>
   <DockPanel><ui:Button DockPanel.Dock="Right" Content="浏览" Command="{Binding BrowseLogsCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
   <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="最低日志级别" Style="{StaticResource InputLabel}"/><ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="保留归档数" Style="{StaticResource InputLabel}"/><ui:NumberBox Value="{Binding LogRetentionFiles, Mode=TwoWay}" Minimum="1" Maximum="365" MaxDecimalPlaces="0"/></StackPanel>
    <StackPanel Grid.Column="4"><TextBlock Text="单文件上限（MB）" Style="{StaticResource InputLabel}"/><ui:NumberBox Value="{Binding LogFileSizeMb, Mode=TwoWay}" Minimum="1" Maximum="100" MaxDecimalPlaces="0"/></StackPanel>
   </Grid>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="2" Padding="24,12" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"><StackPanel>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,12"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ui:Button Content="保存设置" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,10,0"/><ui:Button Content="关闭" Click="OnClose"/></StackPanel>
  </StackPanel></Border>
 </Grid>
</ui:FluentWindow>
