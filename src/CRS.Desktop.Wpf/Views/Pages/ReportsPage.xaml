<Page x:Class="CRS.DesktopClient.Views.Pages.ReportsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,26,32,24">
  <TextBlock Text="报表导出" Style="{StaticResource PageTitle}"/><TextBlock Text="输出当前计算或历史任务的冻结底稿，保存到你选择的位置。" Style="{StaticResource Subtitle}"/>
  <!-- 独立导出密码不与数据库主密码绑定，解密恢复会明确提示产生明文。 -->
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <TextBlock Text="加密底稿与恢复" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock Text="用独立密码保护 Excel 底稿及可用的年末结转。密码遗失后无法恢复，请妥善保管。解密时会新建文件夹。" TextWrapping="Wrap" Margin="0,12,0,16"/>
   <TextBlock Text="导出密码（至少 12 个字符；解密时输入原导出密码）" Margin="0,0,0,6"/>
   <PasswordBox x:Name="ExportSecret" MaxLength="1024" PasswordChanged="PasswordChanged" Margin="0,0,0,12" IsEnabled="{Binding State.IsIdle}"/>
   <TextBlock Text="再次输入密码（仅导出时需要）" Margin="0,0,0,6"/>
   <PasswordBox x:Name="ConfirmSecret" MaxLength="1024" PasswordChanged="ConfirmationChanged" Margin="0,0,0,18" IsEnabled="{Binding State.IsIdle}"/>
   <WrapPanel><ui:Button Content="保存加密底稿" Command="{Binding ExportEncryptedCommand}" Appearance="Primary" Margin="0,0,12,8"/>
    <ui:Button Content="解密到新文件夹" Command="{Binding RestoreEncryptedCommand}" Margin="0,0,12,8"/>
    <ui:Button Content="取消加密导出" Command="{Binding ExportEncryptedCancelCommand}" Margin="0,0,12,8"/>
    <ui:Button Content="取消解密" Command="{Binding RestoreEncryptedCancelCommand}" Margin="0,0,0,8"/></WrapPanel>
  </StackPanel></Border>
  <!-- 导出期间可主动取消；跨页面忙碌门槛不阻断本次取消命令。 -->
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Excel 核算底稿" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="包含税务汇总、FIFO 明细、核对问题、实际汇率和人工复核依据。" TextWrapping="Wrap" Margin="0,12,0,18"/><WrapPanel><ui:Button Content="导出 Excel 底稿" Command="{Binding ExportCommand}" Appearance="Primary" Margin="0,0,12,0"/><ui:Button Content="取消导出" Command="{Binding ExportCancelCommand}"/></WrapPanel></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="年末 LOT 结转" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="后台确认年末成本可信后才能保存，用于下一年度导入。" TextWrapping="Wrap" Margin="0,12,0,18"/><WrapPanel><ui:Button Content="导出 C# LOT 结转" Command="{Binding ExportCarryCommand}" Margin="0,0,12,0"/><ui:Button Content="取消导出" Command="{Binding ExportCarryCancelCommand}"/></WrapPanel></StackPanel></Border>
  <TextBlock Text="{Binding State.Status}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,18,0,0"/>
 </StackPanel></ScrollViewer>
</Page>
