<Page x:Class="CRS.DesktopClient.Views.Pages.ReportsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,26,32,24">
  <TextBlock Text="报表导出" Style="{StaticResource PageTitle}"/><TextBlock Text="输出当前计算或历史任务的冻结底稿，保存到你选择的位置。" Style="{StaticResource Subtitle}"/>
  <!-- 独立导出密码不与数据库主密码绑定，解密恢复会明确提示产生明文。 -->
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <TextBlock Text="加密底稿与恢复（推荐）" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock Text="用独立密码保护 Excel 底稿及可用的年末结转。密码遗失后无法恢复，请妥善保管。解密时会新建文件夹。" TextWrapping="Wrap" Margin="0,12,0,16"/>
   <TextBlock Text="加密和解密统一使用设置中的文档加密密码；打开旧文件时，可在设置中切换为其原密码。" TextWrapping="Wrap" Margin="0,0,0,16"/>
   <WrapPanel><ui:Button Content="保存加密底稿" Command="{Binding ExportEncryptedCommand}" Appearance="Primary" Margin="0,0,12,8"/>
    <ui:Button Content="解密到新文件夹" Command="{Binding RestoreEncryptedCommand}" Margin="0,0,12,8"/>
    <ui:Button Content="取消加密导出" Command="{Binding ExportEncryptedCancelCommand}" Margin="0,0,12,8"/>
    <ui:Button Content="取消解密" Command="{Binding RestoreEncryptedCancelCommand}" Margin="0,0,0,8"/></WrapPanel>
  </StackPanel></Border>
  <!-- 导出期间可主动取消；跨页面忙碌门槛不阻断本次取消命令。 -->
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="普通 Excel 底稿（明文）" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="包含账户、税务汇总、FIFO 明细和复核依据。文件不受数据库加密保护，请保存到可信的普通目录；临时目录不支持明文导出。" TextWrapping="Wrap" Margin="0,12,0,18"/><WrapPanel><ui:Button Content="导出普通 Excel" Command="{Binding ExportCommand}" Margin="0,0,12,0"/><ui:Button Content="取消导出" Command="{Binding ExportCancelCommand}"/></WrapPanel></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="年末 LOT 结转（明文）" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="后台确认年末成本可信后才能保存，用于下一年度导入。文件包含账户和成本资料，不受数据库加密保护；加密归档会附带可用结转。" TextWrapping="Wrap" Margin="0,12,0,18"/><WrapPanel><ui:Button Content="导出 C# LOT 结转" Command="{Binding ExportCarryCommand}" Margin="0,0,12,0"/><ui:Button Content="取消导出" Command="{Binding ExportCarryCancelCommand}"/></WrapPanel></StackPanel></Border>
  <TextBlock Text="{Binding State.Status}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,18,0,0"/>
 </StackPanel></ScrollViewer>
</Page>
