<UserControl x:Class="CRS.DesktopClient.Views.Pages.WorkerStatusPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- 此入口只展示宿主健康，业务计划和执行操作集中在任务中心。 -->
 <StackPanel Margin="24">
  <TextBlock Text="后台服务状态" FontSize="24" FontWeight="Bold"/>
  <TextBlock Text="独立 Windows 服务负责执行公开采集任务，桌面窗口仅通过本机管道连接。" TextWrapping="Wrap" Margin="0,12"/>
  <Button Content="刷新服务状态" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,12"/>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding SnapshotTime}" Margin="0,8"/>
  <TextBlock Text="计划、手动执行和运行历史请到“任务中心”查看。未安装或已停止服务时，桌面不会启动替代采集器。" TextWrapping="Wrap" Margin="0,16"/>
 </StackPanel>
</UserControl>
