<UserControl x:Class="CRS.DesktopClient.Views.Pages.WorkerStatusPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource UiPageRoot}">
 <UserControl.Resources>
  <!-- 状态色遵循共享语义令牌；未知/超时不可继续显示为在线绿色。 -->
  <Style x:Key="WorkerHealthBadge" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource BrandStatusWarningSurfaceBrush}"/>
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="HorizontalAlignment" Value="Left"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding HealthTone}" Value="Success"><Setter Property="Background" Value="{DynamicResource BrandStatusSuccessSurfaceBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding HealthTone}" Value="Error"><Setter Property="Background" Value="{DynamicResource BrandStatusErrorSurfaceBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="WorkerHealthText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource BrandStatusWarningBrush}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="14"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding HealthTone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource BrandStatusSuccessBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding HealthTone}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource BrandStatusErrorBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24,26,32,24">
   <Grid Margin="0,0,0,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="后台服务状态" Style="{StaticResource UiPageTitle}"/>
     <TextBlock Text="检查独立 Windows 服务的连接、运行健康与最近一次采样。" Style="{StaticResource UiHintText}" FontSize="14"/>
    </StackPanel>
    <Button Grid.Column="1" Content="刷新服务状态" Command="{Binding RefreshCommand}"
            Style="{StaticResource UiPrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
            AutomationProperties.Name="刷新后台服务健康状态"/>
   </Grid>
   <Border Style="{StaticResource UiSurfaceCard}" Padding="20" Margin="0,0,0,16">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" Margin="0,0,20,0">
      <TextBlock Text="服务健康" Style="{StaticResource UiHintText}"/>
      <Border Style="{StaticResource WorkerHealthBadge}" Margin="0,12,0,10">
       <TextBlock Text="{Binding HealthLabel}" Style="{StaticResource WorkerHealthText}" AutomationProperties.LiveSetting="Polite"/>
      </Border>
      <TextBlock Text="{Binding SnapshotTime}" Style="{StaticResource UiHintText}"/>
     </StackPanel>
     <Border Grid.Column="1" BorderBrush="{DynamicResource BrandBorderSubtleBrush}" BorderThickness="1,0,0,0" Padding="20,0,0,0">
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="已加载服务计划" Style="{StaticResource UiHintText}"/>
       <TextBlock Text="{Binding Jobs.Count}" Style="{StaticResource MetricValue}" Margin="0,8,0,4"/>
       <TextBlock Text="非服务总计划数" Style="{StaticResource UiHintText}"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="2" BorderBrush="{DynamicResource BrandBorderSubtleBrush}" BorderThickness="1,0,0,0" Padding="20,0,0,0">
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="已加载执行记录" Style="{StaticResource UiHintText}"/>
       <TextBlock Text="{Binding History.Count}" Style="{StaticResource MetricValue}" Margin="0,8,0,4"/>
       <TextBlock Text="仅代表当前筛选页" Style="{StaticResource UiHintText}"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
   <Border Style="{StaticResource UiStatusBanner}" Margin="0,0,0,16">
    <StackPanel>
     <TextBlock Text="服务反馈" Style="{StaticResource UiSectionTitle}" FontSize="15" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding Status}" Style="{StaticResource UiBodyText}" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                  Visibility="{Binding Busy, Converter={StaticResource BooleanVisibility}}"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource UiSurfaceCard}" Padding="20">
    <StackPanel>
     <TextBlock Text="运行方式与操作入口" Style="{StaticResource UiSectionTitle}" Margin="0,0,0,14"/>
     <TextBlock Text="独立运行" FontWeight="SemiBold" Foreground="{DynamicResource BrandTextPrimaryBrush}"/>
     <TextBlock Text="任务由 Windows Service 执行；关闭或锁定小财牛不会停止后台采集。" Style="{StaticResource UiBodyText}" Margin="0,4,0,14"/>
     <Separator Background="{DynamicResource BrandBorderSubtleBrush}" Margin="0,0,0,14"/>
     <TextBlock Text="本机安全连接" FontWeight="SemiBold" Foreground="{DynamicResource BrandTextPrimaryBrush}"/>
     <TextBlock Text="桌面通过本机命名管道读取健康状态，不会在服务缺失时启动替代采集器。" Style="{StaticResource UiBodyText}" Margin="0,4,0,14"/>
     <Separator Background="{DynamicResource BrandBorderSubtleBrush}" Margin="0,0,0,14"/>
     <TextBlock Text="任务管理" FontWeight="SemiBold" Foreground="{DynamicResource BrandTextPrimaryBrush}"/>
     <TextBlock Text="计划编辑、手动运行和执行日志请前往左侧“任务与服务 → 任务中心”；涉及修改的操作需要管理权限。" Style="{StaticResource UiBodyText}" Margin="0,4,0,0"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
