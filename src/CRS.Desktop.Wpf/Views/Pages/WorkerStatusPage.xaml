<UserControl x:Class="CRS.DesktopClient.Views.Pages.WorkerStatusPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{DynamicResource UiPageRoot}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="CheckingServiceVisibility"/>
  <!-- 状态色遵循共享语义令牌；未知/超时不可继续显示为在线绿色。 -->
  <Style x:Key="WorkerHealthBadge" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource BrandStatusWarningSurfaceBrush}"/>
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="HorizontalAlignment" Value="Left"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding HealthTone}" Value="Success"><Setter Property="Background" Value="{DynamicResource BrandStatusSuccessSurfaceBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding HealthTone}" Value="Error"><Setter Property="Background" Value="{DynamicResource BrandStatusErrorSurfaceBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="WorkerHealthText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource BrandStatusWarningBrush}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="14"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding HealthTone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource BrandStatusSuccessBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding HealthTone}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource BrandStatusErrorBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,12,0,16">
   <Grid Margin="0,0,0,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="后台服务连接与健康检查" Style="{DynamicResource UiSectionTitle}"/>
     <TextBlock Text="查看独立后台服务是否可用，以及最新的健康采样。" Style="{DynamicResource UiHintText}" FontSize="14" TextWrapping="Wrap"/>
    </StackPanel>
    <Button Grid.Column="1" Content="刷新服务状态" Command="{Binding RefreshServiceStatusCommand}"
            Style="{DynamicResource UiPrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
            AutomationProperties.Name="刷新后台服务健康状态"/>
   </Grid>
   <Border Style="{DynamicResource UiSurfaceCard}" Padding="20" Margin="0,0,0,16">
     <StackPanel>
      <TextBlock Text="服务健康" Style="{DynamicResource UiHintText}"/>
      <Border Style="{StaticResource WorkerHealthBadge}" Margin="0,12,0,10">
       <TextBlock Text="{Binding HealthLabel}" Style="{StaticResource WorkerHealthText}" AutomationProperties.LiveSetting="Polite"/>
      </Border>
      <TextBlock Text="{Binding SnapshotTime}" Style="{DynamicResource UiHintText}"/>
     </StackPanel>
   </Border>
   <Border Style="{DynamicResource UiStatusBanner}" Margin="0,0,0,16">
    <StackPanel>
     <TextBlock Text="服务反馈" Style="{DynamicResource UiSectionTitle}" FontSize="15" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding ServiceStatus}" Style="{DynamicResource UiBodyText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                  Visibility="{Binding IsCheckingService, Converter={StaticResource CheckingServiceVisibility}}"/>
    </StackPanel>
   </Border>
   <Border Style="{DynamicResource UiSurfaceCard}" Padding="20">
    <StackPanel>
     <TextBlock Text="后台运行方式" Style="{DynamicResource UiSectionTitle}" Margin="0,0,0,8"/>
     <TextBlock Text="任务由独立的 Windows 服务执行。关闭或锁定小财牛后，后台任务仍可继续运行。" Style="{DynamicResource UiBodyText}" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
