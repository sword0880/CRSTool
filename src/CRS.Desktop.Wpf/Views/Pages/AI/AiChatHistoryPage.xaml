<Page x:Class="CRS.DesktopClient.Views.Pages.AI.AiChatHistoryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:ai="clr-namespace:CRS.DesktopClient.Views.AI">
 <Grid Margin="24,26,32,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
   <TextBlock Text="我的助手" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="管理、搜索并继续之前的对话。" Foreground="{DynamicResource BrandTextHintBrush}" Margin="0,0,0,8"/>
   <ui:TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Width="310"
            HorizontalAlignment="Left" AutomationProperties.Name="搜索聊天历史" PlaceholderText="按问题或回答搜索"/>
   <TextBlock Text="{Binding Status}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <!-- 左侧会话列表与右侧只读记录独立滚动。 -->
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="HistoryList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
            AutomationProperties.Name="聊天会话" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate>
     <DataTemplate>
      <StackPanel Margin="4,4,4,6" MaxWidth="260">
       <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding Model}" Foreground="{DynamicResource BrandTextHintBrush}" Margin="0,4,0,0"/>
       <TextBlock Text="{Binding UpdatedAt.LocalDateTime, StringFormat=g}" Foreground="{DynamicResource BrandTextHintBrush}"/>
      </StackPanel>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
   <Grid Grid.Column="1" Margin="20,0,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,8">
     <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers>
      <DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     </Style.Triggers></Style></WrapPanel.Style>
     <ui:Button Content="继续对话" Appearance="Primary" Click="OnContinue" Margin="0,0,8,0"/>
     <ui:Button Content="删除会话" Click="OnDelete"/>
    </WrapPanel>
    <ai:AiChatTranscript Grid.Row="1" Entries="{Binding Conversation.Entries}"/>
   </Grid>
  </Grid>
 </Grid>
</Page>
