<UserControl x:Class="CRS.DesktopClient.Views.Pages.Performance.PerformanceManualEntryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <!-- 从绩效主页面抽出的 UI 子视图；模型由父 Page 提供，业务计算与敏感状态不迁移。 -->
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14" IsEnabled="{Binding State.IsIdle}">
    <TextBlock Text="境外账户" Style="{DynamicResource UiSectionTitle}"/><WrapPanel Margin="0,8,0,14"><TextBlock Text="别名" VerticalAlignment="Center"/><TextBox Text="{Binding AccountAlias}" Width="180" Margin="8,0"/><TextBlock Text="基础币种" VerticalAlignment="Center"/><TextBox Text="{Binding AccountCurrency}" Width="65" Margin="8,0"/><Button Content="新增账户" Command="{Binding AddAccountCommand}"/></WrapPanel>
    <Button Content="确认下方账户的基础币种" Command="{Binding ConfirmAccountCurrencyCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
    <Button Content="将下方所选账户改为此别名" Command="{Binding RenameAccountCommand}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
    <TextBlock Text="本日净值（手工估值始终标记为估算）" Style="{DynamicResource UiSectionTitle}"/>
    <WrapPanel Margin="0,8"><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding ManualAccount}" DisplayMemberPath="Alias" Width="210"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding NavDate}" Width="150" Margin="12,0"/><TextBlock Text="金额均为所选账户基础币种" VerticalAlignment="Center"/></WrapPanel>
    <WrapPanel Margin="0,8"><TextBlock Text="证券市值" VerticalAlignment="Center"/><TextBox Text="{Binding SecuritiesValue}" Width="100" Margin="8,0,14,0"/><TextBlock Text="现金" VerticalAlignment="Center"/><TextBox Text="{Binding CashValue}" Width="100" Margin="8,0,14,0"/><TextBlock Text="已确认应收" VerticalAlignment="Center"/><TextBox Text="{Binding Receivable}" Width="100" Margin="8,0,14,0"/></WrapPanel>
    <WrapPanel Margin="0,8"><TextBlock Text="融资负债" VerticalAlignment="Center"/><TextBox Text="{Binding Liability}" Width="100" Margin="8,0,14,0"/><TextBlock Text="已确认应付" VerticalAlignment="Center"/><TextBox Text="{Binding Payable}" Width="100" Margin="8,0,14,0"/></WrapPanel>
    <TextBlock Text="来源 / 核对说明（不得填账号、密码或密钥）"/><TextBox Text="{Binding ManualSource}" Margin="0,6"/>
    <CheckBox Content="我已核对本日全部资产和负债，未重复计算负现金与借款" IsChecked="{Binding NavComplete}" Margin="0,6"/><Button Content="保存日末净值" Command="{Binding AddNavCommand}" HorizontalAlignment="Left" Margin="0,6"/>
    <CheckBox Content="我已核对顶部所选期间完整出入金和证券转仓；缺失记录不是零" IsChecked="{Binding FlowsComplete}" Margin="0,12,0,6"/><Button Content="保存资金流完整性确认" Command="{Binding ConfirmCoverageCommand}" HorizontalAlignment="Left"/>
    <CheckBox Content="同时已核对该期间完整股息、利息、预扣税、费用和融资利息" IsChecked="{Binding IncomeCostsComplete}" Margin="0,8"/>
    <Expander Header="补录资金或证券事件" Margin="0,18,0,0"><StackPanel><WrapPanel Margin="0,8"><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding EventDate}" Width="145"/><ComboBox ItemsSource="{Binding EventKinds}" DisplayMemberPath="Name" SelectedValuePath="Kind" SelectedValue="{Binding ManualEventKind}" Width="160" Margin="10,0"/><TextBlock Text="带方向金额" VerticalAlignment="Center"/><TextBox Text="{Binding EventAmount}" Width="100" Margin="8,0"/><TextBox Text="{Binding EventCurrency}" Width="60"/></WrapPanel><TextBlock Text="入金/转入为正，出金/转出为负；证券转仓填公允市值，不用税务成本替代。日内时点为中午 UTC 假定，精确时点使用模板。" TextWrapping="Wrap" Foreground="#64748B"/><WrapPanel Margin="0,8"><TextBlock Text="证券标识 / 市场 / 数量" VerticalAlignment="Center"/><TextBox Text="{Binding EventSecurity}" Width="110" Margin="8,0"/><TextBox Text="{Binding EventMarket}" Width="80"/><TextBox Text="{Binding EventQuantity}" Width="80" Margin="8,0"/></WrapPanel><WrapPanel Margin="0,8"><TextBlock Text="费用 / 预扣税" VerticalAlignment="Center"/><TextBox Text="{Binding EventFee}" Width="90" Margin="8,0"/><TextBox Text="{Binding EventWithholding}" Width="90"/><CheckBox Content="已核对分类与方向" IsChecked="{Binding ClassificationConfirmed}" Margin="12,0"/></WrapPanel><Button Content="保存有来源的补录事件" Command="{Binding AddEventCommand}" HorizontalAlignment="Left"/></StackPanel></Expander>

   </StackPanel></ScrollViewer>
</UserControl>
