<UserControl x:Class="CRS.DesktopClient.Views.Pages.Performance.PerformanceWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" xmlns:converters="clr-namespace:CRS.DesktopClient.Converters">
 <!-- 从绩效主页面抽出的 UI 子视图；模型由父 Page 提供，业务计算与敏感状态不迁移。 -->
 <UserControl.Resources><converters:PerformanceScopeHeightConverter x:Key="ScopeHeight"/></UserControl.Resources>
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Expander Header="账户范围、命名组合与计算口径" IsExpanded="True" MaxHeight="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=TabControl},Converter={StaticResource ScopeHeight}}" Margin="0,0,0,10"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsEnabled="{Binding State.IsIdle}">
     <ItemsControl ItemsSource="{Binding Accounts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,8,18,8"><CheckBox IsChecked="{Binding Selected}" Content="{Binding Alias}" ToolTip="{Binding Broker}"/><!-- 小眼睛保留账户详情命令，悬停提示与无障碍名称说明用途。 --><Button ToolTip="查看完整信息" AutomationProperties.Name="查看完整信息" Command="{Binding DataContext.RevealAccountCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" Width="32" Height="32" Padding="4" VerticalAlignment="Center"><ui:SymbolIcon Symbol="Eye24" FontSize="18"/></Button></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Border Visibility="{Binding HasAccountDetails,Converter={StaticResource BooleanVisibility}}" Background="{DynamicResource BrandAccentPaleBrush}" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding AccountDetails}" TextWrapping="Wrap"/><Button Content="收起完整信息" Command="{Binding HideAccountDetailsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
     <WrapPanel><ComboBox ItemsSource="{Binding Portfolios}" SelectedItem="{Binding SelectedPortfolio}" DisplayMemberPath="Name" Width="145" Margin="0,0,8,0"/><TextBox Text="{Binding PortfolioName,UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,8,0"/><Button Content="保存组合" Command="{Binding SavePortfolioCommand}" Margin="0,0,12,0"/><ComboBox Width="188" ItemsSource="{Binding Methods}" SelectedIndex="{Binding MethodIndex}" Margin="0,0,12,0"/><TextBlock Text="价格回退天数（0—7）" VerticalAlignment="Center"/><TextBox Text="{Binding FallbackDays}" Width="36" Margin="8,0,0,0"/></WrapPanel>
     <TextBlock Text="起点按日末快照时点计，之后至结束快照的流量纳入区间；精确 TWR 缺流量前后估值时不可计算。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel></ScrollViewer></Expander>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" MinColumnWidth="90" ItemsSource="{Binding Metrics}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="指标" Binding="{Binding Name}" Width="205"/><DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="160"/><DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="95"/><DataGridTextColumn Header="定义与计算依据" Binding="{Binding Explanation}" Width="*"/></DataGrid.Columns></DataGrid>
     <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" MinColumnWidth="90" Grid.Row="1" ItemsSource="{Binding AccountResults}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="账户别名" Binding="{Binding AccountAlias}" Width="*"/><DataGridTextColumn Header="券商" Binding="{Binding Broker}"/><DataGridTextColumn Header="期初 NAV" Binding="{Binding OpeningNav,TargetNullValue=不可计算,StringFormat=N2}"/><DataGridTextColumn Header="期末 NAV" Binding="{Binding EndingNav,TargetNullValue=不可计算,StringFormat=N2}"/><DataGridTextColumn Header="现金" Binding="{Binding Cash,StringFormat=N2}"/><DataGridTextColumn Header="融资负债" Binding="{Binding Liabilities,StringFormat=N2}"/><DataGridTextColumn Header="外部净投入" Binding="{Binding NetInvestment,TargetNullValue=不可计算,StringFormat=N2}"/><DataGridTextColumn Header="投资损益" Binding="{Binding Profit,TargetNullValue=不可计算,StringFormat=N2}"/></DataGrid.Columns></DataGrid>
     <WrapPanel x:Name="ExportActions" Grid.Row="2" Margin="0,12,0,0"><Button Content="普通 Excel 导出" Command="{Binding ExportCommand}" Margin="0,0,12,0"/><Button Content="加密归档导出" Command="{Binding ExportEncryptedCommand}"/><Button Content="取消操作" Command="{Binding CancelCommand}" Margin="12,0,0,0"/></WrapPanel>
    </Grid>
   </Grid>
</UserControl>
