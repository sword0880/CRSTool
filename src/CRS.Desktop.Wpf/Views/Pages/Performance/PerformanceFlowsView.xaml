<UserControl x:Class="CRS.DesktopClient.Views.Pages.Performance.PerformanceFlowsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <!-- 从绩效主页面抽出的 UI 子视图；模型由父 Page 提供，业务计算与敏感状态不迁移。 -->
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" MinColumnWidth="90" ItemsSource="{Binding Issues}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="问题" Binding="{Binding Code}"/><DataGridTextColumn Header="账户" Binding="{Binding AccountAlias}"/><DataGridTextColumn Header="原因" Binding="{Binding Explanation}" Width="*"/><DataGridTextColumn Header="修复建议" Binding="{Binding Action}" Width="*"/><DataGridTextColumn Header="来源行" Binding="{Binding SourceRow}"/></DataGrid.Columns></DataGrid>
    <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" MinColumnWidth="90" Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="账户" Binding="{Binding AccountAlias}" Width="160"/><DataGridTextColumn Header="日期" Binding="{Binding Date}"/><DataGridTextColumn Header="分类" Binding="{Binding Type}"/><DataGridTextColumn Header="原币金额" Binding="{Binding Amount,StringFormat=N2}"/><DataGridTextColumn Header="币种" Binding="{Binding Currency}"/><DataGridTextColumn Header="原始行" Binding="{Binding Row}"/><DataGridTextColumn Header="来源摘要" Binding="{Binding Source}" Width="*"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="2" IsEnabled="{Binding State.IsIdle}"><WrapPanel><ComboBox ItemsSource="{Binding EventKinds}" DisplayMemberPath="Name" SelectedValuePath="Kind" SelectedValue="{Binding Classification}" Width="150"/><CheckBox Content="已核对分类和边界" IsChecked="{Binding ClassificationConfirmed}" Margin="12,0" VerticalAlignment="Center"/><TextBox Text="{Binding RevisionReason,UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,8,0" ToolTip="必须填写修订原因"/><Button Content="另存分类修订" Command="{Binding ReviseCommand}"/></WrapPanel>
     <WrapPanel Margin="0,10,0,0"><TextBlock Text="内部转账/转仓" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding TransferOut}" DisplayMemberPath="Label" Width="180" Margin="8,0" ToolTip="转出事件"/><ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding TransferIn}" DisplayMemberPath="Label" Width="180" ToolTip="转入事件"/><TextBox Text="{Binding TransferTolerance}" Width="55" Margin="8,0" ToolTip="报告币种差额容差，费用和汇率差异须说明"/><TextBox Text="{Binding TransferReason,UpdateSourceTrigger=PropertyChanged}" Width="160" ToolTip="核对说明"/><Button Content="确认两侧关联" Command="{Binding MatchTransferCommand}" Margin="8,0,0,0"/></WrapPanel>
     <WrapPanel Margin="0,10,0,0"><ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name" Width="210"/><CheckBox Content="纳入来源" IsChecked="{Binding SourceIncluded}" Margin="12,0" VerticalAlignment="Center"/><TextBox Text="{Binding SourceReason}" Width="280" ToolTip="排除/恢复来源须填写核对原因，原件和历史不会删除"/><Button Content="另存来源范围修订" Command="{Binding ReviseSourceCommand}" Margin="8,0,0,0"/></WrapPanel>
    </StackPanel>
   </Grid>
</UserControl>
