<UserControl x:Class="CRS.DesktopClient.Views.Pages.Performance.PerformanceAccountsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <CollectionViewSource x:Key="AccountsByBroker" Source="{Binding VisibleAccountOverview}">
   <CollectionViewSource.GroupDescriptions>
    <PropertyGroupDescription PropertyName="Broker"/>
   </CollectionViewSource.GroupDescriptions>
  </CollectionViewSource>
 </UserControl.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10">
   <Button DockPanel.Dock="Right" Content="刷新资料" Command="{Binding RefreshCommand}" Margin="12,0,0,0"/>
   <CheckBox x:Name="ShowAccountsWithoutAmounts" DockPanel.Dock="Right" Content="显示无金额账户"
             IsChecked="{Binding ShowAccountsWithoutAmounts}" VerticalAlignment="Center" Margin="12,0,0,0"/>
   <TextBlock Text="金额取自本地最新日末快照。能折算时使用各行标注的币种，否则按原币分列金额。"
              Foreground="{DynamicResource BrandTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,12">
   <TextBlock Text="账户合计" Style="{DynamicResource UiSectionTitle}"/>
   <TextBlock Text="按同一估值日期和币种分别合计。括号内是每项计入的账户数。"
              Foreground="{DynamicResource BrandTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
   <DataGrid x:Name="AccountTotalsTable" ItemsSource="{Binding AccountOverviewTotals}" MaxHeight="150"
             AutoGenerateColumns="False" CanUserSortColumns="False" AutomationProperties.Name="同日同币种账户金额合计">
    <DataGrid.Style>
     <Style TargetType="DataGrid" BasedOn="{StaticResource UiDenseDataGrid}">
      <Style.Triggers>
       <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
      </Style.Triggers>
     </Style>
    </DataGrid.Style>
    <DataGrid.Columns>
     <DataGridTextColumn Header="估值日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="120"/>
     <DataGridTextColumn Header="币种" Binding="{Binding Currency}" Width="75"/>
     <DataGridTextColumn Header="净资产合计" Binding="{Binding NetAssetsDisplay}" Width="*" MinWidth="175"/>
     <DataGridTextColumn Header="现金合计" Binding="{Binding CashDisplay}" Width="*" MinWidth="175"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="暂无可合计金额" Foreground="{DynamicResource BrandTextSecondaryBrush}">
    <TextBlock.Style>
     <Style TargetType="TextBlock">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding HasItems, ElementName=AccountTotalsTable}" Value="False">
        <Setter Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
  </StackPanel>
  <DataGrid x:Name="AccountTable" Grid.Row="2" ItemsSource="{Binding Source={StaticResource AccountsByBroker}}"
            AutoGenerateColumns="False" CanUserSortColumns="False" ColumnHeaderHeight="36" RowHeight="NaN" MinRowHeight="36"
            Style="{DynamicResource UiReadOnlyDataGrid}" AutomationProperties.Name="按券商分组的证券账户">
   <DataGrid.GroupStyle>
    <GroupStyle>
     <GroupStyle.HeaderTemplate>
      <DataTemplate>
       <Border Background="{DynamicResource BrandAccentPaleBrush}" Padding="12,6">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
       </Border>
      </DataTemplate>
     </GroupStyle.HeaderTemplate>
    </GroupStyle>
   </DataGrid.GroupStyle>
   <DataGrid.Columns>
    <DataGridTextColumn Header="账户" Binding="{Binding Alias}" Width="*" MinWidth="180"/>
    <DataGridTextColumn Header="估值日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd, TargetNullValue=—}" Width="120"/>
    <DataGridTextColumn Header="币种" Binding="{Binding Currency, TargetNullValue=—}" Width="75"/>
    <DataGridTextColumn Header="净资产" Binding="{Binding NetAssetsDisplay}" Width="150"/>
    <DataGridTextColumn Header="现金" Binding="{Binding CashDisplay}" Width="150"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="2" Text="{Binding AccountOverviewEmptyMessage}"
             Margin="16,56,16,0" TextWrapping="Wrap" VerticalAlignment="Top" IsHitTestVisible="False"
             Foreground="{DynamicResource BrandTextSecondaryBrush}">
   <TextBlock.Style>
    <Style TargetType="TextBlock">
     <Setter Property="Visibility" Value="Collapsed"/>
     <Style.Triggers>
      <DataTrigger Binding="{Binding HasItems, ElementName=AccountTable}" Value="False">
       <Setter Property="Visibility" Value="Visible"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </TextBlock.Style>
  </TextBlock>
 </Grid>
</UserControl>
