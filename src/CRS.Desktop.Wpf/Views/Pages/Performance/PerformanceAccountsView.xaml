<UserControl x:Class="CRS.DesktopClient.Views.Pages.Performance.PerformanceAccountsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <UserControl.Resources>
  <CollectionViewSource x:Key="AccountsByBroker" Source="{Binding VisibleAccountOverview}">
   <CollectionViewSource.GroupDescriptions>
    <PropertyGroupDescription PropertyName="Broker"/>
   </CollectionViewSource.GroupDescriptions>
  </CollectionViewSource>
  <Style x:Key="AnnualAssetCellText" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="6,5"/>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="12">
  <Border x:Name="LatestAssetCard" Style="{DynamicResource UiSurfaceCard}"
          Background="{DynamicResource BrandAccentSoftBrush}" Padding="14,10" Margin="0,0,0,14">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="刷新资料" Command="{Binding RefreshCommand}"
            Margin="12,0,0,0" VerticalAlignment="Top"/>
    <StackPanel>
     <TextBlock Text="最新净资产" Style="{DynamicResource UiSectionTitle}"/>
     <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="LatestAssetValue" Text="{Binding LatestAssetAmount}" Style="{DynamicResource MetricValue}" Margin="0,2,0,2"/>
      <Button x:Name="LatestAssetVisibilityButton" Command="{Binding ToggleLatestAssetAmountCommand}"
              ToolTip="{Binding LatestAssetAmountAction}" AutomationProperties.Name="{Binding LatestAssetAmountAction}"
              Visibility="{Binding HasLatestAssetAmount, Converter={StaticResource BooleanVisibility}}"
              Background="Transparent" BorderBrush="Transparent" Width="32" Height="32" MinHeight="0"
              Padding="4" Margin="6,0,0,0" VerticalAlignment="Center">
       <ui:SymbolIcon FontSize="18">
        <ui:SymbolIcon.Style>
         <Style TargetType="ui:SymbolIcon">
          <Setter Property="Symbol" Value="EyeOff24"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding ShowLatestAssetAmount}" Value="True">
            <Setter Property="Symbol" Value="Eye24"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </ui:SymbolIcon.Style>
       </ui:SymbolIcon>
      </Button>
     </StackPanel>
     <TextBlock Text="{Binding LatestAssetCaption}" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Margin="0,0,0,14" Padding="14,10"
          CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BrandBorderBrush}"
          Background="{DynamicResource BrandSurfaceBrush}">
   <StackPanel>
    <DockPanel>
     <TextBlock DockPanel.Dock="Right" Text="人民币 · 元" VerticalAlignment="Center"
                Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
     <TextBlock Text="年度资产趋势" Style="{DynamicResource UiSectionTitle}"/>
    </DockPanel>
    <TextBlock Text="往年看年末，本年看最近一期。总额折线连接资料齐全的相邻年份，缺项见下表。"
               TextWrapping="Wrap" Margin="0,4,0,4" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
    <lvc:CartesianChart x:Name="AnnualAssetsChart" Height="235" LegendPosition="Top" AnimationsSpeed="0:0:0"
          Series="{Binding AnnualAssetsChart.Series}" XAxes="{Binding AnnualAssetsChart.XAxes}"
          YAxes="{Binding AnnualAssetsChart.YAxes}" AutomationProperties.Name="年度券商净资产及总净资产（人民币）"
          Visibility="{Binding HasAnnualAssetPoints, Converter={StaticResource BooleanVisibility}}"/>
    <TextBlock Text="暂无可折算的年度净资产。" Margin="0,8,0,4"
               Foreground="{DynamicResource BrandTextSecondaryBrush}"
               Visibility="{Binding NoAnnualAssetPoints, Converter={StaticResource BooleanVisibility}}"/>
   </StackPanel>
  </Border>
  <Border Style="{DynamicResource UiSurfaceCard}" Padding="14,10" Margin="0,0,0,10">
   <StackPanel>
    <TextBlock Text="年度资产明细" Style="{DynamicResource UiSectionTitle}"/>
    <TextBlock Text="金额以人民币列示，与趋势图使用同一估值。覆盖不足时，表中仅合计已计入的账户。"
               Foreground="{DynamicResource BrandTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
    <DataGrid x:Name="AnnualAssetTable" ItemsSource="{Binding AnnualAssetRows}" AutoGenerateColumns="False"
              CanUserSortColumns="False" RowHeight="NaN" MinRowHeight="36" ColumnHeaderHeight="36"
              ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="年度净资产与估值覆盖明细">
     <DataGrid.Style>
      <Style TargetType="DataGrid" BasedOn="{StaticResource UiReadOnlyDataGrid}">
       <Style.Triggers>
        <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
       </Style.Triggers>
      </Style>
     </DataGrid.Style>
     <DataGrid.Columns>
      <DataGridTextColumn Header="年度" Binding="{Binding Year}" Width="68" ElementStyle="{StaticResource AnnualAssetCellText}"/>
      <DataGridTextColumn Header="估值日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd, TargetNullValue=—}"
                          Width="112" ElementStyle="{StaticResource AnnualAssetCellText}"/>
      <DataGridTextColumn Header="券商净资产" Binding="{Binding BrokerAmounts}" Width="*" MinWidth="180"
                          ElementStyle="{StaticResource AnnualAssetCellText}"/>
      <DataGridTextColumn Header="已覆盖净资产" Binding="{Binding CoveredAmount}" Width="138"
                          ElementStyle="{StaticResource AnnualAssetCellText}"/>
      <DataGridTextColumn Header="估值覆盖" Binding="{Binding Coverage}" Width="*" MinWidth="165"
                          ElementStyle="{StaticResource AnnualAssetCellText}"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock Text="暂无年度估值资料。" Foreground="{DynamicResource BrandTextSecondaryBrush}">
     <TextBlock.Style>
      <Style TargetType="TextBlock">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding HasItems, ElementName=AnnualAssetTable}" Value="False">
         <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    <TextBlock Text="缺美元或港元汇率时，可在「汇率管理」更新对应年度的官方汇率，再刷新本页。"
               TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource BrandStatusWarningBrush}"
               Visibility="{Binding HasAnnualRateGaps, Converter={StaticResource BooleanVisibility}}"/>
   </StackPanel>
  </Border>
  <Expander x:Name="AccountDetailsPanel" Header="账户与原币明细" HorizontalContentAlignment="Stretch">
  <StackPanel Margin="0,10,0,0">
   <DockPanel Margin="0,0,0,6">
    <CheckBox x:Name="ShowAccountsWithoutAmounts" DockPanel.Dock="Right" Content="显示无金额账户"
              IsChecked="{Binding ShowAccountsWithoutAmounts}" VerticalAlignment="Center" Margin="12,0,0,0"/>
    <TextBlock Text="账户合计" Style="{DynamicResource UiSectionTitle}"/>
   </DockPanel>
   <TextBlock Text="按同一估值日期和币种分别合计。括号内是每项计入的账户数。"
              Foreground="{DynamicResource BrandTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
   <DataGrid x:Name="AccountTotalsTable" ItemsSource="{Binding AccountOverviewTotals}" MaxHeight="150"
             AutoGenerateColumns="False" CanUserSortColumns="False" AutomationProperties.Name="同日同币种账户金额合计">
    <DataGrid.Style>
     <Style TargetType="DataGrid" BasedOn="{StaticResource UiDenseDataGrid}">
      <Style.Triggers>
       <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
      </Style.Triggers>
     </Style>
    </DataGrid.Style>
    <DataGrid.Columns>
     <DataGridTextColumn Header="估值日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="120"/>
     <DataGridTextColumn Header="币种" Binding="{Binding Currency}" Width="75"/>
     <DataGridTextColumn Header="净资产合计" Binding="{Binding NetAssetsDisplay}" Width="*" MinWidth="175"/>
     <DataGridTextColumn Header="现金合计" Binding="{Binding CashDisplay}" Width="*" MinWidth="175"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="暂无可合计金额" Foreground="{DynamicResource BrandTextSecondaryBrush}">
    <TextBlock.Style>
     <Style TargetType="TextBlock">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding HasItems, ElementName=AccountTotalsTable}" Value="False">
        <Setter Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
  <Grid Margin="0,12,0,0">
  <DataGrid x:Name="AccountTable" ItemsSource="{Binding Source={StaticResource AccountsByBroker}}"
            MinHeight="92" MaxHeight="320"
            AutoGenerateColumns="False" CanUserSortColumns="False" ColumnHeaderHeight="36" RowHeight="NaN" MinRowHeight="36"
            Style="{DynamicResource UiReadOnlyDataGrid}" AutomationProperties.Name="按券商分组的证券账户">
   <DataGrid.GroupStyle>
    <GroupStyle>
     <GroupStyle.HeaderTemplate>
      <DataTemplate>
       <Border Background="{DynamicResource BrandAccentPaleBrush}" Padding="12,6">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
       </Border>
      </DataTemplate>
     </GroupStyle.HeaderTemplate>
    </GroupStyle>
   </DataGrid.GroupStyle>
   <DataGrid.Columns>
    <DataGridTextColumn Header="账户" Binding="{Binding Alias}" Width="*" MinWidth="180"/>
    <DataGridTextColumn Header="估值日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd, TargetNullValue=—}" Width="120"/>
    <DataGridTextColumn Header="币种" Binding="{Binding Currency, TargetNullValue=—}" Width="75"/>
    <DataGridTextColumn Header="净资产" Binding="{Binding NetAssetsDisplay}" Width="150"/>
    <DataGridTextColumn Header="现金" Binding="{Binding CashDisplay}" Width="150"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Text="{Binding AccountOverviewEmptyMessage}"
             Margin="16,56,16,0" TextWrapping="Wrap" VerticalAlignment="Top" IsHitTestVisible="False"
             Foreground="{DynamicResource BrandTextSecondaryBrush}">
   <TextBlock.Style>
    <Style TargetType="TextBlock">
     <Setter Property="Visibility" Value="Collapsed"/>
     <Style.Triggers>
      <DataTrigger Binding="{Binding HasItems, ElementName=AccountTable}" Value="False">
       <Setter Property="Visibility" Value="Visible"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </TextBlock.Style>
  </TextBlock>
  </Grid>
  </StackPanel>
  </Expander>
 </StackPanel>
 </ScrollViewer>
</UserControl>
