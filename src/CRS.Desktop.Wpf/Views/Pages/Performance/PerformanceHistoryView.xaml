<UserControl x:Class="CRS.DesktopClient.Views.Pages.Performance.PerformanceHistoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- 绩效工作区子视图：继承原 PerformanceViewModel，所有计算/冻结证据继续由宿主模型提供。 -->
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" ColumnHeaderHeight="36" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="起点" Binding="{Binding From}" Width="120" MinWidth="120"/><DataGridTextColumn Header="结束" Binding="{Binding To}" Width="120" MinWidth="120"/><DataGridTextColumn Header="币种" Binding="{Binding Currency}" Width="85" MinWidth="85"/><DataGridTextColumn Header="冻结范围" Binding="{Binding Scope}" Width="2*" MinWidth="220"/><DataGridTextColumn Header="运行编号" Binding="{Binding Id}" Width="*" MinWidth="220"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="1" Margin="0,12,0,0"><Button Content="查看原结果" Command="{Binding OpenHistoryCommand}"/><Button Content="按原输入重放并另存" Command="{Binding ReplayHistoryCommand}" Margin="12,0,0,0"/><TextBlock Text="历史保留账户边界、资料摘要及引擎版本，不随当前选择变化。" VerticalAlignment="Center" Margin="16,0,0,0"/></WrapPanel></Grid>
</UserControl>
