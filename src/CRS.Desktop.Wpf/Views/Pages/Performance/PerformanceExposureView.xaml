<UserControl x:Class="CRS.DesktopClient.Views.Pages.Performance.PerformanceExposureView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- 绩效工作区子视图：继承原 PerformanceViewModel，所有计算/冻结证据继续由宿主模型提供。 -->
 <DataGrid ItemsSource="{Binding Exposure}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="12"><DataGrid.Columns><DataGridTextColumn Header="账户" Binding="{Binding AccountAlias}"/><DataGridTextColumn Header="日期" Binding="{Binding Date}"/><DataGridTextColumn Header="类别" Binding="{Binding Kind}"/><DataGridTextColumn Header="证券标识" Binding="{Binding Security}"/><DataGridTextColumn Header="市场" Binding="{Binding Market}"/><DataGridTextColumn Header="数量" Binding="{Binding Quantity}"/><DataGridTextColumn Header="原币" Binding="{Binding Currency}"/><DataGridTextColumn Header="原币金额" Binding="{Binding NativeAmount,TargetNullValue=不可计算,StringFormat=N2}"/><DataGridTextColumn Header="报告币金额" Binding="{Binding ReportAmount,TargetNullValue=不可计算,StringFormat=N2}"/><DataGridTextColumn Header="来源行" Binding="{Binding SourceRow}"/><DataGridTextColumn Header="来源摘要" Binding="{Binding SourceDocument}" Width="*"/></DataGrid.Columns></DataGrid>
</UserControl>
