<UserControl x:Class="CRS.DesktopClient.Views.Pages.Performance.PerformanceExposureView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- 绩效工作区子视图：继承原 PerformanceViewModel，所有计算/冻结证据继续由宿主模型提供。 -->
 <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" ColumnHeaderHeight="36" ItemsSource="{Binding Exposure}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="12"><DataGrid.Columns><DataGridTextColumn Header="账户" Binding="{Binding AccountAlias}" Width="140" MinWidth="140"/><DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="112" MinWidth="112"/><DataGridTextColumn Header="类别" Binding="{Binding Kind}" Width="100" MinWidth="100"/><DataGridTextColumn Header="证券标识" Binding="{Binding Security}" Width="120" MinWidth="120"/><DataGridTextColumn Header="市场" Binding="{Binding Market}" Width="80" MinWidth="80"/><DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="105" MinWidth="105"/><DataGridTextColumn Header="原币" Binding="{Binding Currency}" Width="80" MinWidth="80"/><DataGridTextColumn Header="原币金额" Binding="{Binding NativeAmount,TargetNullValue=不可计算,StringFormat=N2}" Width="140" MinWidth="140"/><DataGridTextColumn Header="报告币金额" Binding="{Binding ReportAmount,TargetNullValue=不可计算,StringFormat=N2}" Width="145" MinWidth="145"/><DataGridTextColumn Header="来源行" Binding="{Binding SourceRow}" Width="112" MinWidth="112"/><DataGridTextColumn Header="来源摘要" Binding="{Binding SourceDocument}" Width="*" MinWidth="180"/></DataGrid.Columns></DataGrid>
</UserControl>
