<UserControl x:Class="CRS.DesktopClient.Views.Pages.Performance.PerformanceChartsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <!-- 从绩效主页面抽出的 UI 子视图；模型由父 Page 提供，业务计算与敏感状态不迁移。 -->
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel IsEnabled="{Binding State.IsIdle}" Margin="0,0,0,8"><TextBlock Text="对比指数" VerticalAlignment="Center"/><ComboBox Width="110" ItemsSource="{Binding Benchmarks}" SelectedItem="{Binding Benchmark}" Margin="8,0"/><Button Content="更新曲线" Command="{Binding RefreshCurveCommand}"/><TextBlock Text="SSE 上证指数 / SPX 标普500 / HSI 恒生 / IXIC 纳斯达克综合" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
    <TabControl Grid.Row="1">
     <TabItem Header="净资产（报告币种）"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding NetAssetsStatus}" TextWrapping="Wrap" Margin="12,8"/><Border Visibility="{Binding NoNetAssetsPoints,Converter={StaticResource BooleanVisibility}}" Padding="20" Background="{DynamicResource BrandAccentPaleBrush}" Margin="12"><StackPanel><TextBlock Text="暂无净资产折线" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding NetAssetsStatus}" TextWrapping="Wrap" Margin="0,8"/><Button Content="更新曲线 / 重新计算" Command="{Binding RefreshCurveCommand}" HorizontalAlignment="Left"/></StackPanel></Border><lvc:CartesianChart Visibility="{Binding HasNetAssetsPoints,Converter={StaticResource BooleanVisibility}}" Height="320" Series="{Binding NetAssetsChart.Series}" XAxes="{Binding NetAssetsChart.XAxes}" YAxes="{Binding NetAssetsChart.YAxes}" LegendPosition="Top" AnimationsSpeed="0:0:0"/></StackPanel></ScrollViewer></TabItem>
     <TabItem Header="净值与指数对比（起点 100）"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding ComparisonStatus}" TextWrapping="Wrap" Margin="12,8"/><Border Visibility="{Binding NoComparisonPoints,Converter={StaticResource BooleanVisibility}}" Padding="20" Background="{DynamicResource BrandAccentPaleBrush}" Margin="12"><StackPanel><TextBlock Text="暂无对比曲线" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ComparisonStatus}" TextWrapping="Wrap" Margin="0,8"/><Button Content="更新曲线 / 重新计算" Command="{Binding RefreshCurveCommand}" HorizontalAlignment="Left"/></StackPanel></Border><lvc:CartesianChart Visibility="{Binding HasComparisonPoints,Converter={StaticResource BooleanVisibility}}" Height="320" Series="{Binding ComparisonChart.Series}" XAxes="{Binding ComparisonChart.XAxes}" YAxes="{Binding ComparisonChart.YAxes}" LegendPosition="Top" AnimationsSpeed="0:0:0"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="{Binding CurveExplanation}" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextHintBrush}" Margin="0,8"/>
   </Grid>
</UserControl>
