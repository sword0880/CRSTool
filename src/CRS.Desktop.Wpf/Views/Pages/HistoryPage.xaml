<Page x:Class="CRS.DesktopClient.Views.Pages.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:converters="clr-namespace:CRS.DesktopClient.Converters" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}}">
 <Page.Resources><converters:UtcTimestampConverter x:Key="TaskTime"/></Page.Resources>
 <Grid Margin="24,26,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="历史任务" Style="{StaticResource PageTitle}"/><TextBlock Text="查看冻结结果或校验报告原件。新版完整快照支持复算另存，原任务会保留。" Style="{StaticResource Subtitle}"/></StackPanel>
  <!-- 校验和复算均保留原任务；后台不满足历史口径门槛时明确拒绝。 -->
  <WrapPanel Grid.Row="1"><ui:Button Content="刷新任务" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButton}"/><ui:Button Content="打开所选结果" Command="{Binding OpenCommand}" Style="{StaticResource ActionButton}"/><ui:Button Content="校验报告原件" Command="{Binding VerifyOriginalsCommand}" Style="{StaticResource ActionButton}"/><ui:Button Content="复算并另存" Command="{Binding ReplayCommand}" Style="{StaticResource ActionButton}"/><!-- 抵免复核另存结果，国家限额与凭证关系展示在税务页。 --><ui:Button Content="导入抵免明细" Command="{Binding ReviewForeignCreditCommand}" Style="{StaticResource ActionButton}"/><ui:Button Content="取消本页操作" Command="{Binding CancelOperationCommand}" Style="{StaticResource ActionButton}"/></WrapPanel>
  <!-- 汇总勾选跨页保留；确认归属后才允许提交，所有金额由后台计算。 -->
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,4,0,14" Background="#F0F5FF">
   <StackPanel>
    <TextBlock Text="年度汇总" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding AggregationHint}" Foreground="#64748B" Margin="0,4,0,8" TextWrapping="Wrap"/>
    <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl ItemsSource="{Binding AggregationSelection}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="White" CornerRadius="6" Padding="8,4" Margin="0,0,8,6" ToolTip="{Binding Id}"><StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center"><Run Text="{Binding Broker, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Year, Mode=OneWay}"/></TextBlock>
        <TextBlock Text="{Binding AccountScope}" MaxWidth="120" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Id}" MaxWidth="80" TextTrimming="CharacterEllipsis" Foreground="#64748B" Margin="8,0" VerticalAlignment="Center"/>
        <ui:Button Content="×" Appearance="Transparent" Padding="3,0" ToolTip="移除本任务" Command="{Binding DataContext.RemoveAggregationTaskCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <WrapPanel>
     <CheckBox Content="确认所选账户均属于同一纳税人" IsChecked="{Binding OwnershipConfirmed}" IsEnabled="{Binding State.IsIdle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
     <ui:Button Content="汇总并另存" Appearance="Primary" Command="{Binding AggregateAnnualCommand}" Margin="0,0,8,0"/>
     <ui:Button Content="清空选择" Appearance="Transparent" Command="{Binding ClearAggregationSelectionCommand}"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <DataGrid x:Name="HistoryGrid" Grid.Row="3" ItemsSource="{Binding SelectableRows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="False" IsEnabled="{Binding State.IsIdle}">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="纳入汇总" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInclude}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="勾选同年度的来源账户任务"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="任务类型" Binding="{Binding TaskKind}" IsReadOnly="True" Width="84"/>
    <DataGridTextColumn Header="年度" Binding="{Binding Task.Year}" IsReadOnly="True" Width="56"/>
    <DataGridTextColumn Header="券商" Binding="{Binding BrokerLabel}" IsReadOnly="True" Width="64"/>
    <DataGridTextColumn Header="账户范围" Binding="{Binding Task.AccountScope}" IsReadOnly="True" Width="140"/>
    <DataGridTextColumn Header="任务编号" Binding="{Binding Task.Id}" IsReadOnly="True" Width="200"/>
    <DataGridTextColumn Header="保存时间 UTC" Binding="{Binding Task.CreatedUtc, Converter={StaticResource TaskTime}}" IsReadOnly="True" Width="176"/>
    <DataGridCheckBoxColumn Header="完整结果" Binding="{Binding Task.Complete, Mode=OneWay}" IsReadOnly="True"/>
    <DataGridTextColumn Header="待复核数" Binding="{Binding Task.Issues}" IsReadOnly="True"/>
    <DataGridTextColumn Header="复算父任务" Binding="{Binding Task.ParentSnapshotId}" IsReadOnly="True"/>
   </DataGrid.Columns>
  </DataGrid>
  <!-- 页高随导航内容区域变化，分页始终位于表格滚动区域之外。 -->
  <DockPanel x:Name="PagingBar" Grid.Row="4" Margin="0,16,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ui:Button Content="上一页" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0"/><ui:Button Content="下一页" Command="{Binding NextPageCommand}"/></StackPanel><TextBlock Text="{Binding PageLabel}" Foreground="#64748B" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Page>
