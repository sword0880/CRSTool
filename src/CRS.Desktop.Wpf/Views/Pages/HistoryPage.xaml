<Page x:Class="CRS.DesktopClient.Views.Pages.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid Margin="24,26,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="历史任务" Style="{StaticResource PageTitle}"/><TextBlock Text="打开已保存的原始核算结果，底稿继续使用该任务的冻结汇率。" Style="{StaticResource Subtitle}"/></StackPanel>
  <WrapPanel Grid.Row="1"><ui:Button Content="刷新任务" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButton}"/><ui:Button Content="打开所选结果" Command="{Binding OpenCommand}" Style="{StaticResource ActionButton}"/></WrapPanel>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="True"/>
 </Grid>
</Page>
