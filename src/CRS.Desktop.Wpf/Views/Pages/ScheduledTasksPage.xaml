<UserControl x:Class="CRS.DesktopClient.Views.Pages.ScheduledTasksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <!-- 管理页只绑定状态和命令，计划生成及执行记录属于宿主服务。 -->
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="计划任务" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Status}" Margin="0,8" TextWrapping="Wrap"/><TextBlock Text="仅执行已启动插件注册的任务；暂停计划不影响手动立即执行。状态和结果通过刷新更新。" TextWrapping="Wrap"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,12"><ui:Button Content="刷新状态" Command="{Binding RefreshCommand}"/><ui:Button Content="立即执行" Command="{Binding RunNowCommand}" Margin="8,0"/><ui:Button Content="暂停 / 恢复计划" Command="{Binding ToggleCommand}"/><ui:Button Content="取消执行" Command="{Binding CancelRunCommand}" Margin="8,0"/></WrapPanel>
  <TabControl Grid.Row="2">
   <TabItem Header="任务与计划"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid ItemsSource="{Binding Tasks}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
     <DataGridTextColumn Header="任务" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="插件" Binding="{Binding Plugin}"/><DataGridTextColumn Header="状态" Binding="{Binding State}"/><DataGridTextColumn Header="下次执行（北京时间）" Binding="{Binding Next}"/><DataGridTextColumn Header="上次结果" Binding="{Binding Last}"/>
    </DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="1" Margin="0,12"><WrapPanel><TextBlock Text="频率" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" DisplayMemberPath="Text" Width="170" Margin="8,0"/><TextBlock Text="小时" VerticalAlignment="Center"/><TextBox Text="{Binding Hour,UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="8,0"/><TextBlock Text="分钟" VerticalAlignment="Center"/><TextBox Text="{Binding Minute,UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="8,0"/><CheckBox Content="启用" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="8,0"/><ui:Button Content="保存计划" Command="{Binding SaveCommand}"/></WrapPanel><TextBlock Text="每天 / 周一至周五使用小时和分钟；每小时仅使用分钟。周一至周五不代表交易日，来源返回空数据时不会填零。" Margin="0,8" TextWrapping="Wrap"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="执行记录"><DataGrid ItemsSource="{Binding History}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
    <DataGridTextColumn Header="插件" Binding="{Binding Plugin}"/><DataGridTextColumn Header="任务" Binding="{Binding Task}"/><DataGridTextColumn Header="触发方式" Binding="{Binding Origin}"/><DataGridTextColumn Header="开始（北京时间）" Binding="{Binding Started}"/><DataGridTextColumn Header="结束（北京时间）" Binding="{Binding Ended}"/><DataGridTextColumn Header="结果" Binding="{Binding Result}"/><DataGridTextColumn Header="故障类别" Binding="{Binding Code}" Width="*"/>
   </DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
 </Grid>
</UserControl>
