<Page x:Class="CRS.DesktopClient.Views.Pages.ReconciliationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CRS.DesktopClient.Controls" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid Margin="24,26,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="核对与复核" Style="{StaticResource PageTitle}"/><TextBlock Text="查看资料缺口、券商差异和复核依据；说明保存后保留原始金额与核算状态。" Style="{StaticResource Subtitle}"/></StackPanel>
  <TabControl Grid.Row="1">
   <TabItem Header="核对底稿"><controls:ResultTabs Sections="{Binding Results.ReconciliationTables}" Margin="0,12,0,0"/></TabItem>
   <TabItem Header="保存人工依据"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding Review}" Margin="20" IsEnabled="{Binding State.IsIdle}">
    <TextBlock Text="复核类型" Style="{StaticResource InputLabel}"/><TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
    <TextBlock Text="原始资料来源及核对说明" Style="{StaticResource InputLabel}"/><TextBox Text="{Binding Evidence, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" Height="180" VerticalScrollBarVisibility="Auto"/>
    <CheckBox Content="确认依据对应当前展示的计算记录" IsChecked="{Binding Confirmed}" Margin="0,18,0,18"/>
    <ui:Button Content="保存人工依据" Command="{Binding SaveCommand}" Appearance="Primary"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</Page>
