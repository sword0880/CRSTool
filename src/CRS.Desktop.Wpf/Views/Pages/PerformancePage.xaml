<Page x:Class="CRS.DesktopClient.Views.Pages.PerformancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" xmlns:converters="clr-namespace:CRS.DesktopClient.Converters">
 <Page.Resources><converters:NavigationViewportHeightConverter x:Key="ViewportHeight"/><converters:PerformanceScopeHeightConverter x:Key="ScopeHeight"/></Page.Resources>
 <!-- 内部网格受导航可用高度约束；导航服务会重置 Page.Height。 -->
 <!-- 导航还会重置最外层内容高度，约束放在内部网格以免被覆盖。 -->
 <Grid><Grid Margin="24,20,28,20" x:Name="ViewportGrid" Height="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><DockPanel><WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center"><RadioButton x:Name="OfflineMode" Content="仅离线" GroupName="PerformanceNetwork" IsChecked="{Binding IsOffline,Mode=OneWay}" Command="{Binding UseOfflineCommand}" Margin="0,0,16,0"/><RadioButton x:Name="OnlineMode" Content="允许在线更新" GroupName="PerformanceNetwork" IsChecked="{Binding OnlineUpdatesAllowed,Mode=OneWay}" Command="{Binding AuthorizeOnlineUpdatesCommand}"/></WrapPanel><TextBlock Text="海外投资绩效中心" Style="{StaticResource PageTitle}"/></DockPanel>
   <TextBlock Text="{Binding NetworkStatus}" Style="{StaticResource Subtitle}" TextWrapping="Wrap"/>
  </StackPanel>
  <!-- 核心操作固定在顶部，导入与计算无需滚到页面底部。 -->
  <WrapPanel Grid.Row="1" Margin="0,0,0,12" IsEnabled="{Binding State.IsIdle}">
   <TextBlock Text="共用证券流水导入的数据" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <ComboBox Width="112" ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Margin="0,0,8,0"/>
   <DatePicker SelectedDateFormat="Short" Width="128" SelectedDate="{Binding From}" Margin="0,0,6,0"/><TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker SelectedDateFormat="Short" Width="128" SelectedDate="{Binding To}" Margin="0,0,8,0"/>
   <ComboBox Width="78" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" Margin="0,0,8,0"/>
   <Button x:Name="CalculateButton" Content="更新 / 重算" Command="{Binding CalculateCommand}" Margin="0,0,8,0"/>
   <Button Content="刷新资料" Command="{Binding RefreshCommand}"/>
  </WrapPanel>
  <Border Grid.Row="2" Style="{StaticResource Card}" Background="#EFF6FF" Margin="0,0,0,12"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/></Border>
  <TabControl Grid.Row="3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <!-- 导航主题的默认选页容器会按内容扩高；用有限星号行承载页内容。 -->
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True" Panel.ZIndex="1"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Grid></ControlTemplate></TabControl.Template>
   <TabItem Header="绩效工作台"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Expander Header="账户范围、命名组合与计算口径" IsExpanded="True" MaxHeight="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=TabControl},Converter={StaticResource ScopeHeight}}" Margin="0,0,0,10"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsEnabled="{Binding State.IsIdle}">
     <ItemsControl ItemsSource="{Binding Accounts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,8,18,8"><CheckBox IsChecked="{Binding Selected}" Content="{Binding Alias}" ToolTip="{Binding Broker}"/><Button Content="查看完整信息" Command="{Binding DataContext.RevealAccountCommand,RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Margin="8,0,0,0" Padding="6,2"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Border Visibility="{Binding HasAccountDetails,Converter={StaticResource BooleanVisibility}}" Background="#EFF6FF" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding AccountDetails}" TextWrapping="Wrap"/><Button Content="收起完整信息" Command="{Binding HideAccountDetailsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
     <WrapPanel><ComboBox ItemsSource="{Binding Portfolios}" SelectedItem="{Binding SelectedPortfolio}" DisplayMemberPath="Name" Width="145" Margin="0,0,8,0"/><TextBox Text="{Binding PortfolioName,UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,8,0"/><Button Content="保存组合" Command="{Binding SavePortfolioCommand}" Margin="0,0,12,0"/><ComboBox Width="188" ItemsSource="{Binding Methods}" SelectedIndex="{Binding MethodIndex}" Margin="0,0,12,0"/><TextBlock Text="价格回退天数（0—7）" VerticalAlignment="Center"/><TextBox Text="{Binding FallbackDays}" Width="36" Margin="8,0,0,0"/></WrapPanel>
     <TextBlock Text="起点按日末快照时点计，之后至结束快照的流量纳入区间；精确 TWR 缺流量前后估值时不可计算。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel></ScrollViewer></Expander>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DataGrid ItemsSource="{Binding Metrics}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="指标" Binding="{Binding Name}" Width="205"/><DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="160"/><DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="95"/><DataGridTextColumn Header="定义与计算依据" Binding="{Binding Explanation}" Width="*"/></DataGrid.Columns></DataGrid>
     <DataGrid Grid.Row="1" ItemsSource="{Binding AccountResults}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="账户别名" Binding="{Binding AccountAlias}" Width="*"/><DataGridTextColumn Header="券商" Binding="{Binding Broker}"/><DataGridTextColumn Header="期初 NAV" Binding="{Binding OpeningNav,TargetNullValue=不可计算,StringFormat=N2}"/><DataGridTextColumn Header="期末 NAV" Binding="{Binding EndingNav,TargetNullValue=不可计算,StringFormat=N2}"/><DataGridTextColumn Header="现金" Binding="{Binding Cash,StringFormat=N2}"/><DataGridTextColumn Header="融资负债" Binding="{Binding Liabilities,StringFormat=N2}"/><DataGridTextColumn Header="外部净投入" Binding="{Binding NetInvestment,TargetNullValue=不可计算,StringFormat=N2}"/><DataGridTextColumn Header="投资损益" Binding="{Binding Profit,TargetNullValue=不可计算,StringFormat=N2}"/></DataGrid.Columns></DataGrid>
     <WrapPanel x:Name="ExportActions" Grid.Row="2" Margin="0,12,0,0"><Button Content="普通 Excel 导出" Command="{Binding ExportCommand}" Margin="0,0,12,0"/><Button Content="加密归档导出" Command="{Binding ExportEncryptedCommand}"/><Button Content="取消操作" Command="{Binding CancelCommand}" Margin="12,0,0,0"/></WrapPanel>
    </Grid>
   </Grid></TabItem>
   <!-- 原币组成与来源独立呈现，未知值不填零。 -->
   <TabItem Header="净值曲线与指数"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel IsEnabled="{Binding State.IsIdle}" Margin="0,0,0,8"><TextBlock Text="对比指数" VerticalAlignment="Center"/><ComboBox Width="110" ItemsSource="{Binding Benchmarks}" SelectedItem="{Binding Benchmark}" Margin="8,0"/><Button Content="更新曲线" Command="{Binding RefreshCurveCommand}"/><Button Content="联网更新并重算" Command="{Binding DownloadBenchmarkCommand}" Margin="12,0"/><TextBlock Text="SPX 标普500 / HSI 恒生 / IXIC 纳斯达克综合" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
    <TabControl Grid.Row="1">
     <TabItem Header="净资产（报告币种）"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding NetAssetsStatus}" TextWrapping="Wrap" Margin="12,8"/><Border Visibility="{Binding NoNetAssetsPoints,Converter={StaticResource BooleanVisibility}}" Padding="20" Background="#EFF6FF" Margin="12"><StackPanel><TextBlock Text="暂无净资产折线" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding NetAssetsStatus}" TextWrapping="Wrap" Margin="0,8"/><Button Content="更新曲线 / 重新计算" Command="{Binding RefreshCurveCommand}" HorizontalAlignment="Left"/></StackPanel></Border><lvc:CartesianChart Visibility="{Binding HasNetAssetsPoints,Converter={StaticResource BooleanVisibility}}" Height="320" Series="{Binding NetAssetsChart.Series}" XAxes="{Binding NetAssetsChart.XAxes}" YAxes="{Binding NetAssetsChart.YAxes}" LegendPosition="Top" AnimationsSpeed="0:0:0"/></StackPanel></ScrollViewer></TabItem>
     <TabItem Header="净值与指数对比（起点 100）"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding ComparisonStatus}" TextWrapping="Wrap" Margin="12,8"/><Border Visibility="{Binding NoComparisonPoints,Converter={StaticResource BooleanVisibility}}" Padding="20" Background="#EFF6FF" Margin="12"><StackPanel><TextBlock Text="暂无对比曲线" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ComparisonStatus}" TextWrapping="Wrap" Margin="0,8"/><Button Content="更新曲线 / 重新计算" Command="{Binding RefreshCurveCommand}" HorizontalAlignment="Left"/></StackPanel></Border><lvc:CartesianChart Visibility="{Binding HasComparisonPoints,Converter={StaticResource BooleanVisibility}}" Height="320" Series="{Binding ComparisonChart.Series}" XAxes="{Binding ComparisonChart.XAxes}" YAxes="{Binding ComparisonChart.YAxes}" LegendPosition="Top" AnimationsSpeed="0:0:0"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="{Binding CurveExplanation}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8"/>
   </Grid></TabItem>
<TabItem Header="原币资产组成"><DataGrid ItemsSource="{Binding Exposure}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="12"><DataGrid.Columns><DataGridTextColumn Header="账户" Binding="{Binding AccountAlias}"/><DataGridTextColumn Header="日期" Binding="{Binding Date}"/><DataGridTextColumn Header="类别" Binding="{Binding Kind}"/><DataGridTextColumn Header="证券标识" Binding="{Binding Security}"/><DataGridTextColumn Header="市场" Binding="{Binding Market}"/><DataGridTextColumn Header="数量" Binding="{Binding Quantity}"/><DataGridTextColumn Header="原币" Binding="{Binding Currency}"/><DataGridTextColumn Header="原币金额" Binding="{Binding NativeAmount,TargetNullValue=不可计算,StringFormat=N2}"/><DataGridTextColumn Header="报告币金额" Binding="{Binding ReportAmount,TargetNullValue=不可计算,StringFormat=N2}"/><DataGridTextColumn Header="来源行" Binding="{Binding SourceRow}"/><DataGridTextColumn Header="来源摘要" Binding="{Binding SourceDocument}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
<TabItem Header="资料补录"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14" IsEnabled="{Binding State.IsIdle}">
    <TextBlock Text="境外账户" FontSize="18"/><WrapPanel Margin="0,8,0,14"><TextBlock Text="别名" VerticalAlignment="Center"/><TextBox Text="{Binding AccountAlias}" Width="180" Margin="8,0"/><TextBlock Text="基础币种" VerticalAlignment="Center"/><TextBox Text="{Binding AccountCurrency}" Width="65" Margin="8,0"/><Button Content="新增账户" Command="{Binding AddAccountCommand}"/></WrapPanel>
    <Button Content="确认下方账户的基础币种" Command="{Binding ConfirmAccountCurrencyCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
    <Button Content="将下方所选账户改为此别名" Command="{Binding RenameAccountCommand}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
    <TextBlock Text="本日净值（手工估值始终标记为估算）" FontSize="18"/>
    <WrapPanel Margin="0,8"><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding ManualAccount}" DisplayMemberPath="Alias" Width="210"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding NavDate}" Width="150" Margin="12,0"/><TextBlock Text="金额均为所选账户基础币种" VerticalAlignment="Center"/></WrapPanel>
    <WrapPanel Margin="0,8"><TextBlock Text="证券市值" VerticalAlignment="Center"/><TextBox Text="{Binding SecuritiesValue}" Width="100" Margin="8,0,14,0"/><TextBlock Text="现金" VerticalAlignment="Center"/><TextBox Text="{Binding CashValue}" Width="100" Margin="8,0,14,0"/><TextBlock Text="已确认应收" VerticalAlignment="Center"/><TextBox Text="{Binding Receivable}" Width="100" Margin="8,0,14,0"/></WrapPanel>
    <WrapPanel Margin="0,8"><TextBlock Text="融资负债" VerticalAlignment="Center"/><TextBox Text="{Binding Liability}" Width="100" Margin="8,0,14,0"/><TextBlock Text="已确认应付" VerticalAlignment="Center"/><TextBox Text="{Binding Payable}" Width="100" Margin="8,0,14,0"/></WrapPanel>
    <TextBlock Text="来源 / 核对说明（不得填账号、密码或密钥）"/><TextBox Text="{Binding ManualSource}" Margin="0,6"/>
    <CheckBox Content="我已核对本日全部资产和负债，未重复计算负现金与借款" IsChecked="{Binding NavComplete}" Margin="0,6"/><Button Content="保存日末净值" Command="{Binding AddNavCommand}" HorizontalAlignment="Left" Margin="0,6"/>
    <CheckBox Content="我已核对顶部所选期间完整出入金和证券转仓；缺失记录不是零" IsChecked="{Binding FlowsComplete}" Margin="0,12,0,6"/><Button Content="保存资金流完整性确认" Command="{Binding ConfirmCoverageCommand}" HorizontalAlignment="Left"/>
    <CheckBox Content="同时已核对该期间完整股息、利息、预扣税、费用和融资利息" IsChecked="{Binding IncomeCostsComplete}" Margin="0,8"/>
    <Expander Header="补录资金或证券事件" Margin="0,18,0,0"><StackPanel><WrapPanel Margin="0,8"><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding EventDate}" Width="145"/><ComboBox ItemsSource="{Binding EventKinds}" DisplayMemberPath="Name" SelectedValuePath="Kind" SelectedValue="{Binding ManualEventKind}" Width="160" Margin="10,0"/><TextBlock Text="带方向金额" VerticalAlignment="Center"/><TextBox Text="{Binding EventAmount}" Width="100" Margin="8,0"/><TextBox Text="{Binding EventCurrency}" Width="60"/></WrapPanel><TextBlock Text="入金/转入为正，出金/转出为负；证券转仓填公允市值，不用税务成本替代。日内时点为中午 UTC 假定，精确时点使用模板。" TextWrapping="Wrap" Foreground="#64748B"/><WrapPanel Margin="0,8"><TextBlock Text="证券标识 / 市场 / 数量" VerticalAlignment="Center"/><TextBox Text="{Binding EventSecurity}" Width="110" Margin="8,0"/><TextBox Text="{Binding EventMarket}" Width="80"/><TextBox Text="{Binding EventQuantity}" Width="80" Margin="8,0"/></WrapPanel><WrapPanel Margin="0,8"><TextBlock Text="费用 / 预扣税" VerticalAlignment="Center"/><TextBox Text="{Binding EventFee}" Width="90" Margin="8,0"/><TextBox Text="{Binding EventWithholding}" Width="90"/><CheckBox Content="已核对分类与方向" IsChecked="{Binding ClassificationConfirmed}" Margin="12,0"/></WrapPanel><Button Content="保存有来源的补录事件" Command="{Binding AddEventCommand}" HorizontalAlignment="Left"/></StackPanel></Expander>

   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="资金流与异常检查"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid ItemsSource="{Binding Issues}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="问题" Binding="{Binding Code}"/><DataGridTextColumn Header="账户" Binding="{Binding AccountAlias}"/><DataGridTextColumn Header="原因" Binding="{Binding Explanation}" Width="*"/><DataGridTextColumn Header="修复建议" Binding="{Binding Action}" Width="*"/><DataGridTextColumn Header="来源行" Binding="{Binding SourceRow}"/></DataGrid.Columns></DataGrid>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="账户" Binding="{Binding AccountAlias}" Width="160"/><DataGridTextColumn Header="日期" Binding="{Binding Date}"/><DataGridTextColumn Header="分类" Binding="{Binding Type}"/><DataGridTextColumn Header="原币金额" Binding="{Binding Amount,StringFormat=N2}"/><DataGridTextColumn Header="币种" Binding="{Binding Currency}"/><DataGridTextColumn Header="原始行" Binding="{Binding Row}"/><DataGridTextColumn Header="来源摘要" Binding="{Binding Source}" Width="*"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="2" IsEnabled="{Binding State.IsIdle}"><WrapPanel><ComboBox ItemsSource="{Binding EventKinds}" DisplayMemberPath="Name" SelectedValuePath="Kind" SelectedValue="{Binding Classification}" Width="150"/><CheckBox Content="已核对分类和边界" IsChecked="{Binding ClassificationConfirmed}" Margin="12,0" VerticalAlignment="Center"/><TextBox Text="{Binding RevisionReason,UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,8,0" ToolTip="必须填写修订原因"/><Button Content="另存分类修订" Command="{Binding ReviseCommand}"/></WrapPanel>
     <WrapPanel Margin="0,10,0,0"><TextBlock Text="内部转账/转仓" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding TransferOut}" DisplayMemberPath="Label" Width="180" Margin="8,0" ToolTip="转出事件"/><ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding TransferIn}" DisplayMemberPath="Label" Width="180" ToolTip="转入事件"/><TextBox Text="{Binding TransferTolerance}" Width="55" Margin="8,0" ToolTip="报告币种差额容差，费用和汇率差异须说明"/><TextBox Text="{Binding TransferReason,UpdateSourceTrigger=PropertyChanged}" Width="160" ToolTip="核对说明"/><Button Content="确认两侧关联" Command="{Binding MatchTransferCommand}" Margin="8,0,0,0"/></WrapPanel>
     <WrapPanel Margin="0,10,0,0"><ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name" Width="210"/><CheckBox Content="纳入来源" IsChecked="{Binding SourceIncluded}" Margin="12,0" VerticalAlignment="Center"/><TextBox Text="{Binding SourceReason}" Width="280" ToolTip="排除/恢复来源须填写核对原因，原件和历史不会删除"/><Button Content="另存来源范围修订" Command="{Binding ReviseSourceCommand}" Margin="8,0,0,0"/></WrapPanel>
    </StackPanel>
   </Grid></TabItem>
   <TabItem Header="绩效历史"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="起点" Binding="{Binding From}"/><DataGridTextColumn Header="结束" Binding="{Binding To}"/><DataGridTextColumn Header="币种" Binding="{Binding Currency}"/><DataGridTextColumn Header="冻结范围" Binding="{Binding Scope}" Width="*"/><DataGridTextColumn Header="运行编号" Binding="{Binding Id}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="1" Margin="0,12,0,0"><Button Content="查看原结果" Command="{Binding OpenHistoryCommand}"/><Button Content="按原输入重放并另存" Command="{Binding ReplayHistoryCommand}" Margin="12,0,0,0"/><TextBlock Text="历史保留账户边界、资料摘要及引擎版本，不随当前选择变化。" VerticalAlignment="Center" Margin="16,0,0,0"/></WrapPanel></Grid></TabItem>
  </TabControl>
 </Grid>
</Grid></Page>
