<Page x:Class="CRS.DesktopClient.Views.Pages.PerformancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" xmlns:parts="clr-namespace:CRS.DesktopClient.Views.Pages.Performance">
 
 <!-- 由父级可用空间驱动布局，无需在 Loaded 时查找主窗口的 Navigation 名称。 -->
 <Grid><Grid Margin="24,20,28,20" x:Name="ViewportGrid" VerticalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="投资绩效与基准对比" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="{Binding NetworkStatus}" Style="{StaticResource Subtitle}" TextWrapping="Wrap"/>
  </StackPanel>
  <!-- 核心操作固定在顶部，导入与计算无需滚到页面底部。 -->
  <WrapPanel Grid.Row="1" Margin="0,0,0,12" IsEnabled="{Binding State.IsIdle}">
   <TextBlock Text="共用证券流水导入的数据" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <ComboBox Width="112" ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Margin="0,0,8,0"/>
   <DatePicker SelectedDateFormat="Short" Width="128" SelectedDate="{Binding From}" Margin="0,0,6,0"/><TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker SelectedDateFormat="Short" Width="128" SelectedDate="{Binding To}" Margin="0,0,8,0"/>
   <ComboBox Width="78" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" Margin="0,0,8,0"/>
   <Button x:Name="CalculateButton" Content="联网更新 / 重算" Command="{Binding CalculateCommand}" Margin="0,0,8,0"/>
   <Button Content="刷新资料" Command="{Binding RefreshCommand}"/>
  </WrapPanel>
  <Border Grid.Row="2" Style="{StaticResource Card}" Background="{DynamicResource BrandAccentPaleBrush}" Margin="0,0,0,12"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/></Border>
  <TabControl Grid.Row="3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <!-- 导航主题的默认选页容器会按内容扩高；用有限星号行承载页内容。 -->
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True" Panel.ZIndex="1"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Grid></ControlTemplate></TabControl.Template>
   <TabItem Header="绩效工作台"><parts:PerformanceWorkbenchView/></TabItem>
   <!-- 原币组成与来源独立呈现，未知值不填零。 -->
   <TabItem Header="净值曲线与指数"><parts:PerformanceChartsView/></TabItem>
<TabItem Header="原币资产组成"><parts:PerformanceExposureView/></TabItem>
<TabItem Header="资料补录"><parts:PerformanceManualEntryView/></TabItem>
   <TabItem Header="资金流与异常检查"><parts:PerformanceFlowsView/></TabItem>
   <TabItem Header="绩效历史"><parts:PerformanceHistoryView/></TabItem>
  </TabControl>
 </Grid>
</Grid></Page>
