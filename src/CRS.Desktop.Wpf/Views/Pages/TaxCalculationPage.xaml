<Page x:Class="CRS.DesktopClient.Views.Pages.TaxCalculationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CRS.DesktopClient.Controls" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <Grid Margin="24,26,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="210"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="税务核算" Style="{StaticResource PageTitle}"/><TextBlock Text="收入、收益及税额均采用后台返回的冻结结果。" Style="{StaticResource Subtitle}"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Background="#F0F5FF" Margin="0,0,0,16"><StackPanel><TextBlock Text="{Binding Estimate}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding State.ResultStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#64748B"/></StackPanel></Border>
  <lvc:CartesianChart Grid.Row="2" Series="{Binding IncomeSeries}" XAxes="{Binding IncomeAxes}" YAxes="{Binding MoneyAxes}" Margin="0,0,0,16"/>
  <controls:ResultTabs Grid.Row="3" Sections="{Binding TaxTables}"/>
 </Grid>
</Page>
