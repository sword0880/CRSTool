<Page x:Class="CRS.DesktopClient.Views.Pages.TradesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="24,26,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="交易记录" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding TradesHint}" Style="{StaticResource Subtitle}"/></StackPanel>
  <DataGrid Grid.Row="1" ItemsSource="{Binding Trades}" AutoGenerateColumns="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="账户" Binding="{Binding Key.Account}"/>
    <DataGridTextColumn Header="券商" Binding="{Binding Key.Broker}"/>
    <DataGridTextColumn Header="证券" Binding="{Binding Symbol}"/>
    <DataGridTextColumn Header="币种" Binding="{Binding Key.Currency}"/>
    <DataGridTextColumn Header="成交时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170"/>
    <DataGridTextColumn Header="方向" Binding="{Binding Side}"/>
    <DataGridTextColumn Header="数量" Binding="{Binding Quantity, StringFormat=G29}"/>
    <DataGridTextColumn Header="价格" Binding="{Binding Price, StringFormat=G29}"/>
    <DataGridTextColumn Header="金额" Binding="{Binding Gross, StringFormat=N2}"/>
    <DataGridTextColumn Header="费用" Binding="{Binding Fee, StringFormat=N2}"/>
    <DataGridTextColumn Header="净变动" Binding="{Binding Net, StringFormat=N2}"/>
    <DataGridTextColumn Header="来源文件" Binding="{Binding File}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
 </Grid>
</Page>
