<Page x:Class="CRS.DesktopClient.Views.Pages.ImportPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}}">
 <Grid Margin="24,26,32,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="数据导入" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="选择年度报表并确认期初成本，后台会统一完成 FIFO、税务计算与对账。" Style="{StaticResource Subtitle}" Margin="0,0,0,16"/>
  </StackPanel>
  <!-- 操作区独立于滚动表单，进入页面即可开始计算。 -->
  <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,20">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
     <ui:Button x:Name="CalculateButton" Content="导入并开始计算" Icon="{ui:SymbolIcon Calculator24}" Appearance="Primary" Command="{Binding CalculateCommand}" MinHeight="40" Padding="16,8"/>
     <ui:Button Content="取消当前操作" Command="{Binding CancelCommand}" Appearance="Transparent" MinHeight="40" Margin="8,0,0,0" Visibility="{Binding State.IsBusy, Converter={StaticResource BooleanVisibility}}"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="准备好资料后，开始年度核算" FontWeight="SemiBold" Foreground="#1E3A8A"/>
     <TextBlock Text="请先选择报表，并核对下方期初资料与报告范围。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid IsEnabled="{Binding State.IsIdle}" Margin="0,0,0,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="1 · 选择年度报表" FontSize="18" FontWeight="SemiBold"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="券商" Style="{StaticResource InputLabel}"/><ComboBox ItemsSource="{Binding Brokers}" SelectedItem="{Binding Broker}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="测算年度" Style="{StaticResource InputLabel}"/><ui:NumberBox Value="{Binding Year, Mode=TwoWay}" Minimum="2000" Maximum="2100" MaxDecimalPlaces="0" SpinButtonPlacementMode="Compact"/></StackPanel>
      </Grid>
      <StackPanel Visibility="{Binding IsIbkr, Converter={StaticResource BooleanVisibility}}">
       <ui:Button Content="选择年度报表" Command="{Binding PickReportsCommand}" Margin="0,16,0,8" HorizontalAlignment="Stretch"/>
       <TextBlock Text="{Binding ReportsLabel}" TextWrapping="Wrap" Foreground="#64748B"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsFutu, Converter={StaticResource BooleanVisibility}}">
       <TextBlock Text="股息收入（XLSX / PDF）" Style="{StaticResource InputLabel}"/>
       <WrapPanel><ui:Button Content="选择 / 替换股息文件" Command="{Binding PickFutuDividendCommand}" Style="{StaticResource ActionButton}"/><ui:Button Content="清除" Command="{Binding ClearFutuDividendCommand}" Style="{StaticResource ActionButton}"/></WrapPanel>
       <TextBlock Text="{Binding FutuDividendLabel}" TextWrapping="Wrap" Foreground="#64748B"/>
       <TextBlock Text="交易明细（XLSX，可含历史年度）" Style="{StaticResource InputLabel}"/>
       <WrapPanel><ui:Button Content="选择 / 替换交易文件" Command="{Binding PickFutuTradesCommand}" Style="{StaticResource ActionButton}"/><ui:Button Content="清除" Command="{Binding ClearFutuTradesCommand}" Style="{StaticResource ActionButton}"/></WrapPanel>
       <TextBlock Text="{Binding FutuTradesLabel}" TextWrapping="Wrap" Foreground="#64748B"/>
      </StackPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding IsIbkr, Converter={StaticResource BooleanVisibility}}">
      <Expander Header="IBKR 自动下载（可选）" HorizontalContentAlignment="Stretch"><StackPanel Margin="0,4,0,0">
       <TextBlock Text="查询 ID" Style="{StaticResource InputLabel}"/><TextBox Text="{Binding QueryId, UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Text="服务令牌（仅本次会话）" Style="{StaticResource InputLabel}"/><PasswordBox PasswordChanged="OnPasswordChanged"/>
       <TextBlock Text="报告起止日期" Style="{StaticResource InputLabel}"/>
       <DatePicker SelectedDate="{Binding From}" Margin="0,0,0,10"/><DatePicker SelectedDate="{Binding To}"/>
       <ui:Button Content="下载并选用报告" Command="{Binding DownloadCommand}" Margin="0,16,0,0" HorizontalAlignment="Stretch"/>
      </StackPanel></Expander>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
      <TextBlock Text="导入与核算说明" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="IBKR 支持 Activity Flex XML；富途支持年度交易 XLSX 与收入 XLSX / PDF。" TextWrapping="Wrap" Margin="0,12,0,12" Foreground="#64748B"/>
      <TextBlock Text="期初持仓需要真实成本。资料缺失或核对差异会列为待处理问题。" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#64748B"/>
      <TextBlock Text="未保存完整规范化快照的历史任务，需要重新导入原件才能查看交易明细。" TextWrapping="Wrap" Foreground="#64748B"/>
     </StackPanel></Border>
    </StackPanel>
    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
     <TextBlock Text="2 · 确认期初与范围" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="期初成本" Style="{StaticResource InputLabel}"/>
     <CheckBox Content="使用 C# LOT 结转 JSON" IsChecked="{Binding UseCarry}" Margin="0,4,0,12"/>
     <ui:Button Content="选择期初资料" Command="{Binding PickOpeningCommand}" HorizontalAlignment="Stretch"/>
     <TextBlock Text="{Binding OpeningLabel}" TextWrapping="Wrap" Margin="0,8,0,16" Foreground="#64748B"/>
     <CheckBox Content="确认没有期初持仓" IsChecked="{Binding OpeningZero}" Margin="0,0,0,16"/>
     <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,4,0,16"/>
     <CheckBox IsChecked="{Binding ScopeConfirmed}" Margin="0,0,0,16"><TextBlock Text="确认报告未过滤账户、证券或现金类型" TextWrapping="Wrap"/></CheckBox>
     <CheckBox IsChecked="{Binding SaveCanonicalSnapshot}"><TextBlock Text="保存可重放规范化快照（含敏感数据）" TextWrapping="Wrap"/></CheckBox>
    </StackPanel></Border>
   </Grid>
  </ScrollViewer>
 </Grid>
</Page>
