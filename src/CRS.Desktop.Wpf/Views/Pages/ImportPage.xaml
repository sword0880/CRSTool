<Page x:Class="CRS.DesktopClient.Views.Pages.ImportPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid Margin="24,26,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="数据导入" Style="{StaticResource PageTitle}"/><TextBlock Text="选择年度报表并确认期初成本，后台会统一完成 FIFO、税务计算与对账。" Style="{StaticResource Subtitle}"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid IsEnabled="{Binding State.IsIdle}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
    <TextBlock Text="年度报表" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="券商" Style="{StaticResource InputLabel}"/><ComboBox ItemsSource="{Binding Brokers}" SelectedItem="{Binding Broker}"/>
    <TextBlock Text="测算年度" Style="{StaticResource InputLabel}"/><ui:NumberBox Value="{Binding Year, Mode=TwoWay}" Minimum="2000" Maximum="2100" MaxDecimalPlaces="0" SpinButtonPlacementMode="Compact"/>
    <ui:Button Content="选择年度报表" Command="{Binding PickReportsCommand}" Margin="0,16,0,8" HorizontalAlignment="Stretch"/>
    <TextBlock Text="{Binding ReportsLabel}" TextWrapping="Wrap" Foreground="#64748B"/>
    <TextBlock Text="期初成本" Style="{StaticResource InputLabel}"/>
    <CheckBox Content="使用 C# LOT 结转 JSON" IsChecked="{Binding UseCarry}" Margin="0,4,0,12"/>
    <ui:Button Content="选择期初资料" Command="{Binding PickOpeningCommand}" HorizontalAlignment="Stretch"/>
    <TextBlock Text="{Binding OpeningLabel}" TextWrapping="Wrap" Margin="0,8,0,16" Foreground="#64748B"/>
    <CheckBox Content="确认没有期初持仓" IsChecked="{Binding OpeningZero}" Margin="0,0,0,16"/>
    <CheckBox IsChecked="{Binding ScopeConfirmed}" Margin="0,0,0,16"><TextBlock Text="确认报告未过滤账户、证券或现金类型" TextWrapping="Wrap"/></CheckBox>
    <CheckBox IsChecked="{Binding SaveCanonicalSnapshot}"><TextBlock Text="保存可重放规范化快照（含敏感数据）" TextWrapping="Wrap"/></CheckBox>
   </StackPanel></Border>
   <StackPanel Grid.Column="2">
    <Border Style="{StaticResource Card}" Visibility="{Binding IsIbkr, Converter={StaticResource BooleanVisibility}}"><StackPanel>
     <TextBlock Text="IBKR 自动下载" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="查询 ID" Style="{StaticResource InputLabel}"/><TextBox Text="{Binding QueryId, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Text="服务令牌（仅本次会话）" Style="{StaticResource InputLabel}"/><PasswordBox PasswordChanged="OnPasswordChanged"/>
     <TextBlock Text="报告起止日期" Style="{StaticResource InputLabel}"/>
     <DatePicker SelectedDate="{Binding From}" Margin="0,0,0,10"/><DatePicker SelectedDate="{Binding To}"/>
     <ui:Button Content="下载并选用报告" Command="{Binding DownloadCommand}" Margin="0,16,0,0" HorizontalAlignment="Stretch"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
     <TextBlock Text="导入与核算说明" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="IBKR 支持 Activity Flex XML；富途支持年度交易 XLSX 与收入 XLSX / PDF。" TextWrapping="Wrap" Margin="0,12,0,12"/>
     <TextBlock Text="期初持仓需要真实成本。资料缺失或核对差异会列为待处理问题。" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock Text="未保存完整规范化快照的历史任务，需要重新导入原件才能查看交易明细。" TextWrapping="Wrap" Foreground="#64748B"/>
    </StackPanel></Border>
   </StackPanel>
  </Grid></ScrollViewer>
  <WrapPanel Grid.Row="2" Margin="0,18,0,0"><ui:Button Content="导入并开始计算" Appearance="Primary" Command="{Binding CalculateCommand}" Style="{StaticResource ActionButton}"/><ui:Button Content="取消当前操作" Command="{Binding CancelCommand}" Style="{StaticResource ActionButton}"/></WrapPanel>
 </Grid>
</Page>
