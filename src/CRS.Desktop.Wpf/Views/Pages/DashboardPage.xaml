<Page x:Class="CRS.DesktopClient.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:CRS.DesktopClient.Converters">
 <Page.Resources>
  <converters:HistoryStatusConverter x:Key="HistoryStatus"/>
  <converters:UtcTimestampConverter x:Key="TaskTime"/>
 </Page.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="24,26,32,24">
   <TextBlock Text="概览" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
   <DockPanel Margin="0,0,0,12">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Label Content="税务年度" Target="{Binding ElementName=YearSelector}" VerticalAlignment="Center"/>
     <ComboBox x:Name="YearSelector" Width="128" MaxDropDownHeight="320" AutomationProperties.Name="税务年度"
               ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear, Mode=OneWay}" IsEnabled="{Binding CanSelectYear}"
               SelectionChanged="OnYearSelectionChanged">
      <ComboBox.ItemTemplate>
       <DataTemplate><TextBlock Text="{Binding Mode=OneWay, StringFormat={}{0} 年}"/></DataTemplate>
      </ComboBox.ItemTemplate>
     </ComboBox>
    </StackPanel>
    <TextBlock Text="年度税务" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock Text="正在读取年度结果……" Style="{StaticResource Subtitle}"
              Visibility="{Binding IsReading, Converter={StaticResource BooleanVisibility}}" AutomationProperties.LiveSetting="Polite"/>
   <Border Style="{StaticResource Card}" Margin="0,0,0,16"
           Visibility="{Binding ShowEmpty, Converter={StaticResource BooleanVisibility}}">
    <StackPanel>
     <TextBlock Text="{Binding EmptyMessage}" FontSize="16" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
     <ui:Button Content="{Binding ImportLabel}" Command="{Binding OpenImportCommand}" Appearance="Primary" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Card}" Margin="0,0,0,16"
           Visibility="{Binding LoadFailed, Converter={StaticResource BooleanVisibility}}">
    <StackPanel>
     <TextBlock Text="暂时无法读取年度核算结果。" AutomationProperties.LiveSetting="Polite"/>
     <ui:Button Content="重试" Command="{Binding RefreshCommand}" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BooleanVisibility}}">
    <TextBlock Text="{Binding ScopeTitle}" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding AccountScope}" Foreground="{DynamicResource BrandTextHintBrush}"
               TextWrapping="Wrap" Margin="0,4,0,12"/>
    <Grid Margin="0,0,0,20">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <Button Style="{StaticResource MetricButton}" Command="{Binding OpenDetailCommand}" CommandParameter="trades" Margin="0,0,6,12">
      <StackPanel>
       <TextBlock Text="交易记录" Foreground="#64748B"/>
       <TextBlock Text="{Binding TradeCount}" Style="{StaticResource MetricValue}"/>
       <TextBlock Text="该结果已导入的交易笔数" Foreground="{DynamicResource BrandTextHintBrush}"/>
      </StackPanel>
     </Button>
     <Button Grid.Column="1" Style="{StaticResource MetricButton}" Command="{Binding OpenDetailCommand}" CommandParameter="review" Margin="6,0,0,12">
      <StackPanel>
       <TextBlock Text="待核对" Foreground="#64748B"/>
       <TextBlock Text="{Binding IssueCount}" Style="{StaticResource MetricValue}"/>
       <TextBlock Text="查看问题与人工依据" Foreground="{DynamicResource BrandTextHintBrush}"/>
      </StackPanel>
     </Button>
     <Button Grid.Row="1" Style="{StaticResource MetricButton}" Command="{Binding OpenDetailCommand}" CommandParameter="fifo" Margin="0,0,6,0">
      <StackPanel>
       <TextBlock Text="FIFO 匹配明细" Foreground="#64748B"/>
       <TextBlock Text="{Binding MatchCount}" Style="{StaticResource MetricValue}"/>
       <TextBlock Text="已生成的成本匹配批次" Foreground="{DynamicResource BrandTextHintBrush}"/>
      </StackPanel>
     </Button>
     <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricButton}" Command="{Binding OpenDetailCommand}" CommandParameter="tax" Margin="6,0,0,0">
      <StackPanel>
       <TextBlock Text="税务计算" Foreground="#64748B"/>
       <TextBlock Text="{Binding TaxStatus}" Style="{StaticResource MetricValue}"/>
       <TextBlock Text="{Binding TaxHint}" Foreground="{DynamicResource BrandTextHintBrush}"/>
      </StackPanel>
     </Button>
    </Grid>
   </StackPanel>
   <Border Style="{StaticResource Card}" Margin="0,0,0,16"
           Visibility="{Binding Performance.Available, Converter={StaticResource BooleanVisibility}}">
    <StackPanel>
     <DockPanel>
      <ui:Button DockPanel.Dock="Right" Content="查看账户汇总" Command="{Binding OpenAccountOverviewCommand}"
                 IsEnabled="{Binding State.IsIdle}" Appearance="Transparent" Foreground="{DynamicResource BrandAccentBrush}"/>
      <TextBlock Text="证券账户" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock Text="{Binding Performance.AccountBrokerSummary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Card}">
    <StackPanel>
     <DockPanel Margin="0,0,0,14">
      <ui:Button DockPanel.Dock="Right" Content="查看全部" Command="{Binding NavigateCommand}" CommandParameter="history"
                 Appearance="Transparent" Foreground="{DynamicResource BrandAccentBrush}"/>
      <TextBlock Text="最近导入（所有年度）" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <ItemsControl ItemsSource="{Binding RecentTasks}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Button Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}" Style="{StaticResource MetricButton}" BorderThickness="0" Padding="0,12"
                ToolTip="打开这份任务的核算结果">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/>
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center"><Run Text="{Binding Broker, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Year, Mode=OneWay}"/></TextBlock>
          <TextBlock Grid.Column="1" Text="{Binding CreatedUtc, Converter={StaticResource TaskTime}}" Foreground="#64748B" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{Binding Issues, StringFormat=待核对 {0} 项}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="{Binding Complete, Converter={StaticResource HistoryStatus}}" VerticalAlignment="Center"/>
         </Grid>
        </Button>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="已导入的任务会显示在这里。" Foreground="{DynamicResource BrandTextHintBrush}">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding RecentTasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</Page>
