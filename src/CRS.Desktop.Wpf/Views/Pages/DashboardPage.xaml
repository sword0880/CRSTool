<Page x:Class="CRS.DesktopClient.Views.Pages.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:converters="clr-namespace:CRS.DesktopClient.Converters">
 <Page.Resources><converters:HistoryStatusConverter x:Key="HistoryStatus"/><converters:UtcTimestampConverter x:Key="TaskTime"/></Page.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,26,32,24">
  <TextBlock Text="年度税务概览" Style="{StaticResource PageTitle}"/>
  <TextBlock Style="{StaticResource Subtitle}"><Run Text="实际数据 · "/><Run Text="{Binding State.DisplayYear, Mode=OneWay}"/><Run Text=" 税务年度"/></TextBlock>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <Button Style="{StaticResource MetricButton}" Command="{Binding NavigateCommand}" CommandParameter="trades" Margin="0,0,6,12">
    <StackPanel><TextBlock Text="交易记录" Foreground="#64748B"/><TextBlock Text="{Binding TradeCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="当前年度已导入" Foreground="#94A3B8"/></StackPanel>
   </Button>
   <Button Grid.Column="1" Style="{StaticResource MetricButton}" Command="{Binding NavigateCommand}" CommandParameter="review" Margin="6,0,0,12">
    <StackPanel><TextBlock Text="待核对" Foreground="#64748B"/><TextBlock Text="{Binding IssueCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="查看问题与人工依据" Foreground="#94A3B8"/></StackPanel>
   </Button>
   <Button Grid.Row="1" Style="{StaticResource MetricButton}" Command="{Binding NavigateCommand}" CommandParameter="fifo" Margin="0,0,6,0">
    <StackPanel><TextBlock Text="FIFO 匹配明细" Foreground="#64748B"/><TextBlock Text="{Binding MatchCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="已生成的成本匹配批次" Foreground="#94A3B8"/></StackPanel>
   </Button>
   <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricButton}" Command="{Binding NavigateCommand}" CommandParameter="tax" Margin="6,0,0,0">
    <StackPanel><TextBlock Text="税务计算" Foreground="#64748B"/><TextBlock Text="{Binding TaxStatus}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding TaxHint}" Foreground="#94A3B8"/></StackPanel>
   </Button>
  </Grid>
  <Border Style="{StaticResource Card}">
   <StackPanel><DockPanel Margin="0,0,0,14"><ui:Button DockPanel.Dock="Right" Content="查看全部" Command="{Binding NavigateCommand}" CommandParameter="history" Appearance="Transparent" Foreground="#2563EB"/><TextBlock Text="最新导入任务" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <ItemsControl ItemsSource="{Binding RecentTasks}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MetricButton}" BorderThickness="0" Padding="0,12" ToolTip="打开这份任务的核算结果">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center"><Run Text="{Binding Broker, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Year, Mode=OneWay}"/></TextBlock>
        <TextBlock Grid.Column="1" Text="{Binding CreatedUtc, Converter={StaticResource TaskTime}}" Foreground="#64748B" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding Issues, StringFormat=待核对 {0} 项}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="{Binding Complete, Converter={StaticResource HistoryStatus}}" VerticalAlignment="Center"/>
       </Grid>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="新导入的任务会自动出现在这里；首次使用请从“数据导入”开始。" Foreground="#64748B" Margin="0,12,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
   <TextBlock Text="当前核算范围" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding State.AccountScope}" Margin="0,8,0,0" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding State.ResultStatus}" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
</Page>
