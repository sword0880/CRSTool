<UserControl x:Class="CRS.DesktopClient.Views.Pages.PluginManagementPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <UserControl.Resources>
  <!-- 仅调整插件管理页，统一浅色表格，避免系统深蓝选中底色与固定文字颜色冲突。 -->
  <Style x:Key="PluginHeader" TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource BrandSurfaceAltBrush}"/><Setter Property="Foreground" Value="#475569"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader">
    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PluginRow" TargetType="DataGridRow">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{DynamicResource BrandTextPrimaryBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BrandBorderSubtleBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><DataGridCellsPresenter/></Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource BrandSurfaceAltBrush}"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BrandHoverSurfaceBrush}"/></Trigger>
    <!-- 整行浅蓝高亮并保留深色文字，失去焦点时也不恢复系统的深色选中样式。 -->
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource BrandAccentPaleBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorderStrongBrush}"/><Setter Property="BorderThickness" Value="3,0,0,1"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BrandBorderStrongBrush}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="PluginCell" TargetType="DataGridCell">
   <Setter Property="Foreground" Value="{DynamicResource BrandTextPrimaryBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="8,0"><ContentPresenter VerticalAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PluginAction" TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource BrandSurfaceAltBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BrandAccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorderStrongBrush}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource BrandPressedSurfaceBrush}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="插件管理" FontSize="28" FontWeight="Bold"/>
   <TextBlock Text="查看插件运行状态，管理下次启动时的启用设置。" Foreground="#64748B" Margin="0,8,0,0"/>
  </StackPanel>
  <!-- 概览与比例条仅投影宿主实际状态，不把待生效设置计入当前运行数。 -->
  <Border Grid.Row="1" Background="{DynamicResource BrandAccentPaleBrush}" BorderBrush="{DynamicResource BrandAccentSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="运行中" Foreground="#475569"/><TextBlock Text="{Binding Running}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,4"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="已禁用" Foreground="#475569"/><TextBlock Text="{Binding Disabled}" FontSize="30" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="异常" Foreground="#475569"/><TextBlock Text="{Binding Failed}" FontSize="30" FontWeight="SemiBold" Foreground="#B45309" Margin="0,4"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="2" Background="White" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" Foreground="#64748B"/><TextBlock Text="官方预装插件" FontSize="18" FontWeight="SemiBold"/></DockPanel>
    <ProgressBar Grid.Row="1" Height="5" Minimum="0" Maximum="{Binding ChartMaximum,Mode=OneWay}" Value="{Binding Running,Mode=OneWay}" Foreground="{DynamicResource BrandAccentBrush}" Background="{DynamicResource BrandBorderBrush}" ToolTip="{Binding RunningLabel}" Margin="0,0,0,16"/>
    <DataGrid x:Name="PluginTable" Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0" BorderThickness="0" Background="White" RowHeight="88" HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" SelectionUnit="FullRow" AlternationCount="2" ColumnHeaderStyle="{StaticResource PluginHeader}" RowStyle="{StaticResource PluginRow}" CellStyle="{StaticResource PluginCell}">
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="插件" Width="2*" MinWidth="190"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0"><Border Background="{DynamicResource BrandAccentPaleBrush}" CornerRadius="9" Padding="10" Margin="0,0,12,0"><ui:SymbolIcon Symbol="Apps24" FontSize="22" Foreground="{DynamicResource BrandAccentBrush}"/></Border>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrandTextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Id}" FontSize="12" Foreground="#64748B" Margin="0,5,0,0"/></StackPanel>
       </StackPanel>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="78"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#475569"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      <DataGridTemplateColumn Header="当前状态" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <Border Background="{Binding StateBackground}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateForeground}"/></Border>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="下次启动" Width="*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <TextBlock Text="{Binding NextLabel}" ToolTip="{Binding Detail}" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="操作" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <!-- 图标表达下一步动作，提示和无障碍名称使用相同中文。 -->
       <Button Style="{StaticResource PluginAction}" Command="{Binding ToggleCommand}" ToolTip="{Binding ActionLabel}" AutomationProperties.Name="{Binding ActionLabel}" Width="36" Height="36" Padding="7" HorizontalAlignment="Center" VerticalAlignment="Center"><ui:SymbolIcon Symbol="{Binding ActionIcon}" FontSize="20" Foreground="{Binding ActionForeground}"/></Button>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="3" Text="启用和禁用在重新启动程序后生效，当前会话保持不变。" Foreground="#64748B" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>
