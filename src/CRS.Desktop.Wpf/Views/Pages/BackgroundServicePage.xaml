<UserControl x:Class="CRS.DesktopClient.Views.Pages.BackgroundServicePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:time="clr-namespace:CRS.Plugin.Wpf;assembly=CRS.Plugin.Wpf">
 <UserControl.Resources>
  <time:BeijingTimestampConverter x:Key="BeijingTimestamp"/>
  <Style x:Key="PlanAction" TargetType="Button"><Setter Property="IsEnabled" Value="False"/><Setter Property="ToolTip" Value="请在服务计划中选择任务后操作"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=TaskCenterTabs}" Value="0"><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="任务中心" FontSize="24"/>
   <TextBlock Text="统一查看公开任务的计划与执行记录；任务由独立后台服务执行，关闭或锁定桌面后继续运行。修改计划与手动执行需要管理员权限。" Margin="0,8" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding SnapshotTime}" Margin="0,4,0,12"/>
  </StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <Button Content="刷新状态" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
   <Button Content="立即执行" Command="{Binding RunNowCommand}" Style="{StaticResource PlanAction}" Margin="0,0,8,0"/>
   <Button Content="暂停" Command="{Binding PauseCommand}" Style="{StaticResource PlanAction}" Margin="0,0,8,0"/>
   <Button Content="恢复" Command="{Binding ResumeCommand}" Style="{StaticResource PlanAction}" Margin="0,0,8,0"/>
   <Button Content="取消执行" Command="{Binding CancelRunCommand}" Style="{StaticResource PlanAction}"/>
   <Button Content="更多历史" Command="{Binding MoreHistoryCommand}" Margin="8,0,0,0"/>
   <Button Content="更多计划" Command="{Binding MoreJobsCommand}" Margin="8,0,0,0"/>
   <Button Content="确认上次请求" Command="{Binding ConfirmPendingCommand}" Margin="8,0,0,0"/>
  </WrapPanel>
  <TabControl x:Name="TaskCenterTabs" Grid.Row="2" Grid.RowSpan="2">
   <TabItem Header="服务计划"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="双击计划行或按 Enter 修改 Cron（北京时间）。" Foreground="#64748B" Margin="0,8,0,10"/><DataGrid x:Name="PlansGrid" Grid.Row="1" MouseDoubleClick="OnPlanDoubleClick" PreviewKeyDown="OnPlanKeyDown" SelectionMode="Single" ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
    <DataGrid.Columns><DataGridTextColumn Header="插件" Binding="{Binding PluginId}"/><DataGridTextColumn Header="任务" Binding="{Binding Name}"/><DataGridTextColumn Header="任务编号（英文）" Binding="{Binding JobId}"/><DataGridTextColumn Header="Cron" Binding="{Binding Cron}"/><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}"/><DataGridTextColumn Header="修订" Binding="{Binding Revision}"/>
     <DataGridCheckBoxColumn Header="计划待生效" Binding="{Binding NeedsReconcile}">
      <DataGridCheckBoxColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="ToolTip" Value="勾选表示计划已保存，后台正在应用最新配置；成功后自动取消勾选。未勾选表示配置已应用。此状态不表示任务正在运行或排队。"/></Style></DataGridCheckBoxColumn.HeaderStyle>
      <DataGridCheckBoxColumn.CellStyle><Style TargetType="DataGridCell"><Setter Property="ToolTip" Value="勾选：计划已保存，等待后台应用，成功后自动清除。未勾选：配置已应用。无需手动操作。"/></Style></DataGridCheckBoxColumn.CellStyle>
     </DataGridCheckBoxColumn>
    </DataGrid.Columns>
   </DataGrid></Grid></TabItem>
   <TabItem Header="最近执行"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- 筛选在服务端分页前执行，空白表示全部。 -->
    <StackPanel Margin="0,8,0,10">
     <WrapPanel IsEnabled="{Binding CanChangeHistory}">
      <TextBlock Text="插件" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox Width="220" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding HistoryPlugins}" Text="{Binding HistoryPlugin,UpdateSourceTrigger=PropertyChanged}" ToolTip="留空显示全部插件，或输入插件编号" Margin="0,0,16,8"/>
      <TextBlock Text="任务" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox Width="240" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding HistoryJobs}" Text="{Binding HistoryJob,UpdateSourceTrigger=PropertyChanged}" ToolTip="留空显示全部任务，或输入任务编号" Margin="0,0,12,8"/>
      <CheckBox x:Name="OnlyIssuesCheckBox" Content="仅异常" IsChecked="{Binding OnlyIssues}" VerticalAlignment="Center" Margin="0,0,12,8" ToolTip="服务端筛选非成功、非运行、非主动取消的异常执行；来源冷却或插件启动异常不一定有执行记录。"/>
      <Button Content="应用筛选" Command="{Binding FilterHistoryCommand}" Margin="0,0,12,8"/>
      <Button Content="查看日志" Click="OnViewLog" ToolTip="查看选中执行的运行日志" Margin="0,0,0,8"/>
     </WrapPanel>
     <TextBlock Text="留空表示全部；仅异常按服务端结果过滤（含失败、延期重试、中断等），翻页仍保留筛选。来源冷却或插件启动故障可能不产生执行记录。" TextWrapping="Wrap" Foreground="#64748B"/>
     <TextBlock Text="{Binding PendingStatus}" TextWrapping="Wrap" Margin="0,6"/>
     <DataGrid x:Name="PendingRequestsGrid" ItemsSource="{Binding PendingRequests}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="120">
      <DataGrid.Style><Style TargetType="DataGrid"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></DataGrid.Style>
      <DataGrid.Columns><DataGridTextColumn Header="等待开始的请求" Binding="{Binding RequestId}"/><DataGridTextColumn Header="插件" Binding="{Binding PluginId}"/><DataGridTextColumn Header="任务" Binding="{Binding JobId}"/><DataGridTextColumn Header="最早执行时间（北京时间）" Binding="{Binding NotBefore,Converter={StaticResource BeijingTimestamp},TargetNullValue=等待调度}"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="首页每3秒自动刷新；翻页后保留阅读位置，点击刷新返回最新记录。" Foreground="#64748B" Margin="0,4"/>
    </StackPanel>
    <DataGrid x:Name="HistoryGrid" Grid.Row="1" ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="OnHistoryDoubleClick" PreviewKeyDown="OnHistoryKeyDown" SelectionMode="Single">
    <DataGrid.Columns><DataGridTextColumn Header="插件" Binding="{Binding PluginId}"/><DataGridTextColumn Header="任务" Binding="{Binding JobId}"/><DataGridTextColumn Header="开始时间（北京时间）" Binding="{Binding StartedUtc,Converter={StaticResource BeijingTimestamp}}"/><DataGridTextColumn Header="结束时间（北京时间）" Binding="{Binding EndedUtc,Converter={StaticResource BeijingTimestamp}}"/><DataGridTextColumn Header="结果" Binding="{Binding Result}"/><DataGridTextColumn Header="尝试" Binding="{Binding Attempt}"/></DataGrid.Columns>
   </DataGrid></Grid></TabItem>
   <TabItem Header="当前任务"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,0,0">
    <TextBlock Text="{Binding ActivityStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBlock Text="显示全部插件，每3秒刷新，不受最近执行的筛选或翻页影响。首次手动请求直接调度；插件已有任务时排队；来源限制导致的重试会显示等待时间。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,10"/>
    <TextBlock Text="执行中的任务" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,6"/>
    <DataGrid x:Name="RunningTasksGrid" ItemsSource="{Binding RunningTasks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180" MinHeight="70">
     <DataGrid.Columns><DataGridTextColumn Header="插件" Binding="{Binding Row.PluginId}"/><DataGridTextColumn Header="任务" Binding="{Binding Row.Name}"/><DataGridTextColumn Header="任务编号（英文）" Binding="{Binding Row.JobId}"/><DataGridTextColumn Header="开始时间（北京时间）" Binding="{Binding Row.StartedAt,Converter={StaticResource BeijingTimestamp}}"/><DataGridTextColumn Header="当前进展" Binding="{Binding ReasonText}"/><DataGridTextColumn Header="来源等待至（北京时间）" Binding="{Binding Row.NotBefore,Converter={StaticResource BeijingTimestamp}}"/><DataGridTextColumn Header="执行编号" Binding="{Binding Row.ExecutionId}"/></DataGrid.Columns>
    </DataGrid>
    <TextBlock Text="排队中的任务" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6"/>
    <DataGrid x:Name="WaitingTasksGrid" ItemsSource="{Binding WaitingTasks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180" MinHeight="70">
     <DataGrid.Columns><DataGridTextColumn Header="插件" Binding="{Binding Row.PluginId}"/><DataGridTextColumn Header="任务" Binding="{Binding Row.Name}"/><DataGridTextColumn Header="任务编号（英文）" Binding="{Binding Row.JobId}"/><DataGridTextColumn Header="插件内顺序" Binding="{Binding Row.QueuePosition}"/><DataGridTextColumn Header="等待原因" Binding="{Binding ReasonText}"/><DataGridTextColumn Header="请求编号" Binding="{Binding Row.RequestId}"/></DataGrid.Columns>
    </DataGrid>
    <TextBlock Text="待执行的请求" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6"/>
    <TextBlock Text="这里只列尚未进入执行队列的请求，已经排队的请求显示在上表；最早执行时间表示重试期限，实际开始还取决于执行名额。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,6"/>
    <DataGrid x:Name="PendingTasksGrid" ItemsSource="{Binding PendingTasks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180" MinHeight="70">
     <DataGrid.Columns><DataGridTextColumn Header="插件" Binding="{Binding Row.PluginId}"/><DataGridTextColumn Header="任务" Binding="{Binding Row.Name}"/><DataGridTextColumn Header="任务编号（英文）" Binding="{Binding Row.JobId}"/><DataGridTextColumn Header="等待原因" Binding="{Binding ReasonText}"/><DataGridTextColumn Header="最早执行时间（北京时间）" Binding="{Binding EarliestText}"/><DataGridTextColumn Header="请求编号" Binding="{Binding Row.RequestId}"/></DataGrid.Columns>
    </DataGrid>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>
