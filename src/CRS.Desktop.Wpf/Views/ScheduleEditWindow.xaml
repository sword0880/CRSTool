<ui:FluentWindow Icon="pack://application:,,,/CRS.Desktop.Wpf;component/Assets/Brand/XiaoCaiNiu.ico" x:Class="CRS.DesktopClient.Views.ScheduleEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="修改任务计划" Width="720" Height="820" MinWidth="620" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource BrandCanvasBrush}">
 <ui:FluentWindow.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#475569"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style x:Key="Number" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Width" Value="76"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
 </ui:FluentWindow.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="修改任务计划" ShowClose="True" ShowMaximize="False" ShowMinimize="False" ForceShutdown="False"/>
  <StackPanel Grid.Row="1" Margin="24,10,24,14"><TextBlock Text="{Binding TaskLabel}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Identity}" Foreground="#64748B" Margin="0,5,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="24,0,18,0" Padding="0,0,6,0">
   <StackPanel>
    <Border Background="White" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
     <StackPanel>
      <TextBlock Text="执行频率" Style="{StaticResource Caption}"/>
      <ComboBox x:Name="FrequencyPicker" ItemsSource="{Binding Frequencies}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Frequency}" AutomationProperties.Name="执行频率"/>
      <WrapPanel Margin="0,14,0,0">
       <StackPanel Visibility="{Binding ShowInterval,Converter={StaticResource VisibleWhen}}"><TextBlock Text="间隔" Style="{StaticResource Caption}"/><ComboBox Style="{StaticResource Number}" ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval}" AutomationProperties.Name="间隔数值"/></StackPanel>
       <StackPanel Visibility="{Binding ShowDay,Converter={StaticResource VisibleWhen}}"><TextBlock Text="每月几日" Style="{StaticResource Caption}"/><ComboBox Style="{StaticResource Number}" ItemsSource="{Binding Days}" SelectedItem="{Binding Day}" AutomationProperties.Name="每月日期"/></StackPanel>
       <StackPanel Visibility="{Binding ShowHour,Converter={StaticResource VisibleWhen}}"><TextBlock Text="时" Style="{StaticResource Caption}"/><ComboBox Style="{StaticResource Number}" ItemsSource="{Binding Hours}" SelectedItem="{Binding Hour}" AutomationProperties.Name="小时"/></StackPanel>
       <StackPanel Visibility="{Binding ShowMinute,Converter={StaticResource VisibleWhen}}"><TextBlock Text="分" Style="{StaticResource Caption}"/><ComboBox Style="{StaticResource Number}" ItemsSource="{Binding Minutes}" SelectedItem="{Binding Minute}" AutomationProperties.Name="分钟"/></StackPanel>
       <StackPanel Visibility="{Binding ShowSecond,Converter={StaticResource VisibleWhen}}"><TextBlock Text="秒" Style="{StaticResource Caption}"/><ComboBox Style="{StaticResource Number}" ItemsSource="{Binding Minutes}" SelectedItem="{Binding Second}" AutomationProperties.Name="秒"/></StackPanel>
      </WrapPanel>
      <ItemsControl ItemsSource="{Binding Weekdays}" Visibility="{Binding ShowWeekdays,Converter={StaticResource VisibleWhen}}" Margin="0,12,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" Width="76" MinWidth="0" Padding="0" Margin="0,0,10,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,12,0,0" LineHeight="20"/>
     </StackPanel>
    </Border>
    <TextBlock Text="Cron 表达式" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
    <TextBox x:Name="CronEditor" Text="{Binding Cron,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="16" AutomationProperties.Name="任务 Cron 表达式"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsReadOnly" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsManual}" Value="True"><Setter Property="IsReadOnly" Value="False"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
    <TextBlock Text="选择“手动表达式”可输入高级规则；格式为 秒 分 时 日 月 星期，可选年份。" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,14"/>
    <TextBlock Text="时区" Style="{StaticResource Caption}"/>
    <ComboBox IsEditable="True" Text="{Binding TimeZoneId,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="任务计划时区"><ComboBoxItem Content="China Standard Time"/><ComboBoxItem Content="UTC"/></ComboBox>
    <Border Background="{DynamicResource BrandAccentPaleBrush}" CornerRadius="10" Padding="14,10" Margin="0,14,0,4"><StackPanel>
     <TextBlock Text="未来 5 次计划触发时间" FontWeight="SemiBold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
     <TextBlock Text="{Binding Validation}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/><Style.Triggers><DataTrigger Binding="{Binding Valid}" Value="False"><Setter Property="Foreground" Value="#B45309"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <ItemsControl ItemsSource="{Binding NextTimes}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas, Microsoft YaHei" Foreground="#334155" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="3" Margin="24,14,24,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" Click="OnCancel" IsCancel="True" Padding="18,8" Margin="0,0,10,0"/><Button Content="保存计划" Command="{Binding SaveCommand}" IsDefault="True" Padding="18,8" Background="{DynamicResource BrandAccentBrush}" Foreground="White"/></StackPanel>
  </Grid>
 </Grid>
</ui:FluentWindow>
