<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>CRS.Desktop.Wpf</AssemblyName>
    <!-- Windows 文件属性采用产品全称，程序集技术标识继续使用 CRS。 -->
    <Product>境外证券投资所得税辅助计算工具</Product>
    <Title>境外证券投资所得税辅助计算工具</Title>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="DataGridExtensions" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <ProjectReference Include="../CRS.Application/CRS.Application.csproj" />
    <ProjectReference Include="../CRS.Infrastructure/CRS.Infrastructure.csproj" />
    <Using Include="CRS.Domain" />
    <Using Include="CRS.Application" />
    <!-- 配置源归属 WPF 项目，构建与发布时都保留运行目录中的 config 子目录。 -->
    <Content Include="config/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
