<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>CRS.Desktop.Wpf</AssemblyName>
    <ApplicationIcon>Assets/Brand/XiaoCaiNiu.ico</ApplicationIcon>
    <!-- Windows 文件属性采用产品全称，程序集技术标识继续使用 CRS。 -->
    <Product>小财牛</Product>
    <Title>小财牛</Title>
    <AssemblyTitle>小财牛</AssemblyTitle>
    <Description>财富有数，投资有度</Description>
    <!-- F5 即使宿主本身未改动，也需检查并同步插件输出。 -->
    <DisableFastUpToDateCheck Condition="'SyncDevelopmentPlugins' != 'false'">true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Brand/XiaoCaiNiu.ico" />
    <Resource Include="Assets/Brand/XiaoCaiNiu_256.png" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="DataGridExtensions" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <ProjectReference Include="../CRS.Application/CRS.Application.csproj" />
    <ProjectReference Include="../CRS.Infrastructure/CRS.Infrastructure.csproj" />
    <ProjectReference Include="../CRS.PluginHost/CRS.PluginHost.csproj" />
    <ProjectReference Include="../CRS.Worker.Ipc/CRS.Worker.Ipc.csproj" />
    <Using Include="CRS.Domain" />
    <Using Include="CRS.Application" />
    <!-- 配置源归属 WPF 项目，构建与发布时都保留运行目录中的 config 子目录。 -->
    <Content Include="config/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 只建立构建顺序，不把业务插件加入宿主编译引用或输出根目录。 -->
  <ItemGroup Condition="'SyncDevelopmentPlugins' != 'false'">
    <ProjectReference Include="../Plugins/CRS.Plugins.NationalTeamWatch/CRS.Plugins.NationalTeamWatch.csproj" ReferenceOutputAssembly="false" Private="false" DevelopmentPlugin="true" />
    <ProjectReference Include="../Plugins/CRS.Plugins.NationalTeam.Jobs/CRS.Plugins.NationalTeam.Jobs.csproj" ReferenceOutputAssembly="false" Private="false" DevelopmentPlugin="true" />
    <ProjectReference Include="../Plugins/CRS.Plugins.Demo/CRS.Plugins.Demo.csproj" ReferenceOutputAssembly="false" Private="false" DevelopmentPlugin="true" />
  </ItemGroup>
  <!-- 指纹编译进主程序，不信任可与 DLL 一起替换的旁置清单；必须来自可信构建。 -->
  <Target Name="GenerateTrustedDocumentFingerprint" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
    <ItemGroup><_TrustedDocumentInput Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'CRS.Documents.dll'" /></ItemGroup>
    <Error Condition="'@(_TrustedDocumentInput->Count())' != '1'" Text="无法确定唯一的 CRS.Documents 实现程序集，拒绝生成主程序。" />
    <GetFileHash Files="@(_TrustedDocumentInput)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="_TrustedDocumentHash" /></GetFileHash>
    <PropertyGroup><_TrustedDocumentSha256>@(_TrustedDocumentHash->'%(FileHash)')</_TrustedDocumentSha256></PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)TrustedDocuments.g.cs" Encoding="UTF-8" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="namespace CRS.DesktopClient.Services%3B public static partial class TrustedDocumentAssembly { private const string ExpectedSha256 = &quot;$(_TrustedDocumentSha256)&quot;%3B }" />
    <ItemGroup><Compile Remove="$(IntermediateOutputPath)TrustedDocuments.g.cs" /><Compile Include="$(IntermediateOutputPath)TrustedDocuments.g.cs" /><FileWrites Include="$(IntermediateOutputPath)TrustedDocuments.g.cs" /></ItemGroup>
  </Target>
  <Target Name="SyncDesktopDevelopmentPlugins" AfterTargets="Build"
          Condition="'SyncDevelopmentPlugins' != 'false' And 'DesignTimeBuild' != 'true'">
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('DevelopmentPlugin', 'true'))"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_DevelopmentPluginAssembly" />
    </MSBuild>
    <WriteLinesToFile File="$(IntermediateOutputPath)development-plugin-outputs.txt"
                      Lines="@(_DevelopmentPluginAssembly->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Exec Command="&quot;$(SystemRoot)/System32/WindowsPowerShell/v1.0/powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../tests/Build-DevelopmentPlugins.ps1&quot; -AssemblyList &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)development-plugin-outputs.txt&quot; -OutputDirectory &quot;$(TargetDir)Plugins&quot;" />
  </Target>
</Project>
