<UserControl x:Class="CRS.DesktopClient.Views.Settings.VpnSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <StackPanel x:Name="Form">
  <TextBlock Text="VPN 订阅地址" Style="{StaticResource InputLabel}"/>
  <TextBox x:Name="SubscriptionInput" MaxLength="3000" AutomationProperties.Name="VPN 订阅地址"/>
  <TextBlock x:Name="SubscriptionStatus" Margin="0,8,0,0" TextWrapping="Wrap"/>
  <WrapPanel Margin="0,12,0,0">
   <ui:Button Content="保存订阅" Appearance="Primary" Click="OnSave" Margin="0,0,8,6"/>
   <ui:Button Content="刷新节点" Click="OnRefresh" Margin="0,0,8,6"/>
   <ui:Button Content="清除订阅" Click="OnRemove" Margin="0,0,0,6"/>
  </WrapPanel>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,6,0,8" AutomationProperties.LiveSetting="Polite"/>
  <ItemsControl x:Name="NodeList"/>
 </StackPanel>
</UserControl>
