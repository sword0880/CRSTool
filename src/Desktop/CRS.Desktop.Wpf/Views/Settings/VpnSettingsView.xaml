<UserControl x:Class="CRS.DesktopClient.Views.Settings.VpnSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <StackPanel>
  <TextBlock Text="VPN 订阅地址" Style="{StaticResource InputLabel}"/>
  <TextBox x:Name="SubscriptionInput" MaxLength="3000" AutomationProperties.Name="VPN 订阅地址"/>
  <TextBlock x:Name="SubscriptionStatus" Margin="0,8,0,0" TextWrapping="Wrap"
             Foreground="{DynamicResource BrandTextHintBrush}"/>
  <WrapPanel x:Name="SubscriptionActions" Margin="0,12,0,0">
   <ui:Button Content="保存订阅" Appearance="Primary" Click="OnSave" Margin="0,0,8,0"/>
   <ui:Button Content="清除订阅" Click="OnRemove"/>
  </WrapPanel>

  <ItemsControl x:Name="SubscriptionDetails" Margin="0,20,0,0" Visibility="Collapsed"
                AutomationProperties.Name="套餐信息">
   <ItemsControl.ItemsPanel>
    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
   </ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate>
    <DataTemplate>
     <Border Background="{DynamicResource BrandSurfaceAltBrush}" Padding="12,9" Margin="0,0,6,0"
             BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="8">
      <StackPanel>
       <TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap"
                  Foreground="{DynamicResource BrandTextHintBrush}"/>
       <TextBlock Text="{Binding Value}" ToolTip="{Binding Value}" TextTrimming="CharacterEllipsis"
                  FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"
                  Foreground="{DynamicResource BrandTextPrimaryBrush}"/>
      </StackPanel>
     </Border>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>

  <Border Margin="0,20,0,0" CornerRadius="12" BorderThickness="1"
          Background="{DynamicResource BrandSurfaceAltBrush}"
          BorderBrush="{DynamicResource BrandBorderBrush}">
   <StackPanel>
    <DockPanel Margin="16,12" LastChildFill="True">
     <ui:Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新节点"
                Click="OnRefresh" ToolTip="重新加载节点并测速"/>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="订阅节点" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Border x:Name="NodeCountBadge" Visibility="Collapsed" Margin="10,0,0,0" Padding="8,3"
              Background="{DynamicResource BrandAccentSoftBrush}" CornerRadius="10">
       <TextBlock x:Name="NodeCount" FontSize="12" FontWeight="SemiBold"
                  Foreground="{DynamicResource BrandAccentDarkBrush}"/>
      </Border>
     </StackPanel>
    </DockPanel>
    <ProgressBar x:Name="BusyIndicator" Height="2" Margin="16,0" Visibility="Collapsed"
                 IsIndeterminate="True" Foreground="{DynamicResource BrandAccentBrush}"
                 AutomationProperties.Name="VPN 节点加载进度"/>
    <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="16,0,16,12"
               Foreground="{DynamicResource BrandStatusInfoBrush}" AutomationProperties.LiveSetting="Polite">
     <TextBlock.Style>
      <Style TargetType="TextBlock">
       <Style.Triggers>
        <Trigger Property="Text" Value="">
         <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    <ListBox x:Name="Regions" SelectionChanged="OnRegionSelected" Visibility="Collapsed"
             BorderThickness="0" Background="Transparent" Margin="12,0,12,8"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="节点地区">
     <ListBox.ItemsPanel>
      <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
     </ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem">
       <Setter Property="Margin" Value="0,0,5,4"/>
       <Setter Property="Foreground" Value="{DynamicResource BrandTextSecondaryBrush}"/>
       <Setter Property="Template">
        <Setter.Value>
         <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Tab" CornerRadius="7" Padding="10,5" Background="Transparent">
           <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Tab" Property="Background" Value="{DynamicResource BrandHoverSurfaceBrush}"/>
           </Trigger>
           <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="Tab" Property="Background" Value="{DynamicResource BrandAccentPaleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandAccentDarkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
           </Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </Setter.Value>
       </Setter>
      </Style>
     </ListBox.ItemContainerStyle>
    </ListBox>
    <ItemsControl x:Name="NodeList" Visibility="Collapsed" Margin="12,0,6,6" Tag="3"
                  SizeChanged="OnNodeListSizeChanged" AutomationProperties.Name="VPN 订阅节点">
     <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
       <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
      </ItemsPanelTemplate>
     </ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border BorderThickness="1" BorderBrush="{DynamicResource BrandBorderBrush}"
               Background="{DynamicResource BrandSurfaceBrush}" CornerRadius="9"
               Padding="10,9" Margin="0,0,6,6" Height="95" ToolTip="{Binding Name}">
        <Grid>
         <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Top" FontWeight="SemiBold"
                    Foreground="{DynamicResource BrandTextPrimaryBrush}"/>
         <DockPanel Grid.Row="1" Margin="0,4,0,0">
          <Border x:Name="LatencyBadge" DockPanel.Dock="Left" CornerRadius="10" Padding="7,3"
                  Background="{DynamicResource BrandStatusInfoSurfaceBrush}">
           <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="LatencyDot" Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center"
                     Fill="{DynamicResource BrandStatusInfoBrush}"/>
            <TextBlock x:Name="LatencyText" Text="{Binding Latency}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrandStatusInfoBrush}"/>
           </StackPanel>
          </Border>
          <TextBlock Text="{Binding Protocol}" FontSize="11" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" TextAlignment="Right" Margin="5,0,0,0"
                     Foreground="{DynamicResource BrandTextHintBrush}"/>
         </DockPanel>
        </Grid>
       </Border>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="Low">
         <Setter TargetName="LatencyBadge" Property="Background" Value="{DynamicResource BrandStatusSuccessSurfaceBrush}"/>
         <Setter TargetName="LatencyDot" Property="Fill" Value="{DynamicResource BrandStatusSuccessBrush}"/>
         <Setter TargetName="LatencyText" Property="Foreground" Value="{DynamicResource BrandStatusSuccessBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="Medium">
         <Setter TargetName="LatencyBadge" Property="Background" Value="{DynamicResource BrandStatusWarningSurfaceBrush}"/>
         <Setter TargetName="LatencyDot" Property="Fill" Value="{DynamicResource BrandStatusWarningBrush}"/>
         <Setter TargetName="LatencyText" Property="Foreground" Value="{DynamicResource BrandStatusWarningBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="High">
         <Setter TargetName="LatencyBadge" Property="Background" Value="{DynamicResource BrandStatusErrorSurfaceBrush}"/>
         <Setter TargetName="LatencyDot" Property="Fill" Value="{DynamicResource BrandStatusErrorBrush}"/>
         <Setter TargetName="LatencyText" Property="Foreground" Value="{DynamicResource BrandStatusErrorBrush}"/>
        </DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
