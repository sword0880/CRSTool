<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.EquityPage" Background="{DynamicResource BrandCanvasBrush}" Style="{DynamicResource UiPageRoot}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="国家队与长期资金 · 直接持股" Style="{DynamicResource UiPageTitle}"/><TextBlock Text="汇金、证金、外汇局具名平台、国家大基金、社保及养老保险基金；具体机构与组合独立记录。未列示不等于清仓，A 级仅代表已核验披露快照；C 级为待核验线索。两期差额不代表每日交易，直接持股与ETF间接暴露不合并。" TextWrapping="Wrap" Margin="0,8"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,8"><ui:Button Content="刷新披露数据" Command="{Binding RefreshCommand}"/><ui:Button Content="检查官方披露" Command="{Binding SyncCommand}" IsEnabled="{Binding CanManage}" Margin="8,0"/><TextBox Width="180" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索股票代码、名称或组合账号" AutomationProperties.Name="搜索直接持股"/><ComboBox Width="135" ItemsSource="{Binding Institutions}" SelectedItem="{Binding Institution}" Margin="8,0" AutomationProperties.Name="机构筛选"/><ComboBox Width="150" ItemsSource="{Binding Natures}" SelectedItem="{Binding Nature}" AutomationProperties.Name="持仓性质筛选"/><CheckBox Content="仅关注" IsChecked="{Binding Favorites}" VerticalAlignment="Center" Margin="8,0"/></WrapPanel>
  <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{DynamicResource UiStatusText}" Margin="0,4,0,12"/>
  <TabControl Grid.Row="3" SelectedIndex="{Binding MainTabIndex}">
   <TabItem Header="持仓与变动"><Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="5"/><RowDefinition Height="3*" MinHeight="330"/></Grid.RowDefinitions>
    <DataGrid Style="{DynamicResource UiDenseDataGrid}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True" RowHeight="32"><DataGrid.Columns>
     <DataGridTextColumn Header="代码" Binding="{Binding Ticker}"/><DataGridTextColumn Header="股票" Binding="{Binding Name}"/><DataGridTextColumn Header="机构/组合" Binding="{Binding Account}" MinWidth="170"/><DataGridTextColumn Header="持股数（股）" Binding="{Binding Shares,StringFormat=N0,TargetNullValue=未知}"/><DataGridTextColumn Header="报告期差额（股）" Binding="{Binding Delta,StringFormat=N0,TargetNullValue=不可计算}"/><DataGridTextColumn Header="持仓截止日" Binding="{Binding ReportAsOf,StringFormat=yyyy-MM-dd,TargetNullValue=待核验}"/><DataGridTextColumn Header="公告日" Binding="{Binding Published,StringFormat=yyyy-MM-dd,TargetNullValue=待核验}"/><DataGridTextColumn Header="状态" Binding="{Binding StatusText}"/><DataGridTextColumn Header="性质" Binding="{Binding NatureText}"/><DataGridTextColumn Header="证据等级" Binding="{Binding EvidenceText}"/><DataGridTextColumn Header="原文位置" Binding="{Binding EvidencePage}"/>
    </DataGrid.Columns></DataGrid>
    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" AutomationProperties.Name="调整持仓和详情区域"/>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="{Binding DetailStatus}" TextWrapping="Wrap" MaxWidth="850" Margin="0,8"/><ui:Button Content="关注 / 取消关注" Command="{Binding ToggleFavoriteCommand}" IsEnabled="{Binding CanManage}" Margin="8,0"/></WrapPanel>
     <TabControl Grid.Row="1"><TabItem Header="持仓与增减图"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <WrapPanel Margin="8"><TextBlock Text="机构 / 具体组合" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding StockAccounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Label" MaxWidth="480" MinWidth="160" Margin="8,0" AutomationProperties.Name="图表机构与具体组合"/><ui:Button Content="重置范围" Command="{Binding ResetEquityZoomCommand}" Margin="0,0,8,0"/><CheckBox Content="持仓点显示占总股本比例" IsChecked="{Binding HoldingPercent}" VerticalAlignment="Center"/></WrapPanel>
      <TextBlock Text="{Binding ChartStatus}" TextWrapping="Wrap" Margin="8,0"/>
      <lvc:CartesianChart Height="145" Series="{Binding HoldingSeries}" XAxes="{Binding HoldingAxes}" YAxes="{Binding HoldingYAxes}" ChartPointPointerDownCommand="{Binding SelectEquityPointCommand}" ZoomMode="X" AnimationsSpeed="0:0:0" AutomationProperties.Name="已核验报告期持仓离散点图"/>
      <lvc:CartesianChart Height="135" Series="{Binding DeltaSeries}" XAxes="{Binding DeltaAxes}" YAxes="{Binding DeltaYAxes}" ChartPointPointerDownCommand="{Binding SelectEquityPointCommand}" ZoomMode="X" AnimationsSpeed="0:0:0" AutomationProperties.Name="相邻可比报告期净增减柱图"/>
      <WrapPanel Margin="8"><TextBlock Text="报告记录" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" MinWidth="150" Margin="8,0" AutomationProperties.Name="图表报告记录"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding ReportAsOf,StringFormat=yyyy-MM-dd,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding StatusText,Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock VerticalAlignment="Center"><Hyperlink NavigateUri="{Binding SelectedEvent.SourceUrl}" RequestNavigate="OnOpenSource">查看所选报告原文</Hyperlink></TextBlock></WrapPanel>
      <TextBlock Text="{Binding EventReadout}" TextWrapping="Wrap" Margin="8,0,8,8"/>
     </StackPanel></ScrollViewer></TabItem><TabItem Header="历次变动"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="按所选账户逐期比较；未核验及不可比记录不计算增减，未列示不代表清仓。" TextWrapping="Wrap" Margin="8"/><DataGrid Style="{DynamicResource UiDenseDataGrid}" Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="报告截止日" Binding="{Binding ReportAsOf,StringFormat=yyyy-MM-dd}"/><DataGridTextColumn Header="比较起点" Binding="{Binding ComparisonFrom,StringFormat=yyyy-MM-dd,TargetNullValue=无前期}"/><DataGridTextColumn Header="公告日" Binding="{Binding Published,StringFormat=yyyy-MM-dd}"/><DataGridTextColumn Header="持股数（股）" Binding="{Binding Shares,StringFormat=N0,TargetNullValue=未知}"/><DataGridTextColumn Header="报告期差额（股）" Binding="{Binding Delta,StringFormat=N0,TargetNullValue=不可计算}"/><DataGridTextColumn Header="状态" Binding="{Binding StatusText}"/><DataGridTextColumn Header="性质" Binding="{Binding NatureText}"/><DataGridTextColumn Header="证据等级" Binding="{Binding EvidenceText}"/><DataGridTextColumn Header="原文位置" Binding="{Binding EvidencePage}"/><DataGridTextColumn Header="证据原文" Binding="{Binding SourceUrl}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem><TabItem Header="披露证据 / 核验"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <DataGrid Style="{DynamicResource UiDenseDataGrid}" Height="160" ItemsSource="{Binding Disclosures}" SelectedItem="{Binding SelectedDisclosure}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="来源日期" Binding="{Binding SourceDate}"/><DataGridTextColumn Header="报告截止日" Binding="{Binding ReportAsOf}"/><DataGridTextColumn Header="公告日" Binding="{Binding Published}"/><DataGridTextColumn Header="状态" Binding="{Binding State}"/><DataGridTextColumn Header="原文" Binding="{Binding DocumentUrl}" Width="*"/></DataGrid.Columns></DataGrid>
      <WrapPanel Margin="8"><TextBlock Margin="0,0,16,0"><Hyperlink NavigateUri="{Binding SelectedDisclosure.DocumentUrl}" RequestNavigate="OnOpenSource">打开已登记的官方PDF</Hyperlink></TextBlock><TextBlock><Hyperlink NavigateUri="{Binding SelectedDisclosure.SourceUrl}" RequestNavigate="OnOpenSource">查看来源原始响应</Hyperlink></TextBlock></WrapPanel>
            <GroupBox Header="官方定期报告目录（线索，尚未核验股东表）" Margin="8"><StackPanel><WrapPanel Margin="8"><ui:Button Content="查找官方报告" Command="{Binding FindReportsCommand}" IsEnabled="{Binding CanManage}"/><ui:Button Content="刷新报告目录" Command="{Binding RefreshReportsCommand}" Margin="8,0"/><ui:Button Content="填入所选报告" Command="{Binding UseReportCommand}" IsEnabled="{Binding CanManage}"/></WrapPanel><TextBlock Text="{Binding ReportStatus}" TextWrapping="Wrap" Margin="8"/><DataGrid Style="{DynamicResource UiDenseDataGrid}" Height="160" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="目录公告日" Binding="{Binding Announced,StringFormat=yyyy-MM-dd}"/><DataGridTextColumn Header="官方标题" Binding="{Binding Title}" Width="*"/><DataGridTemplateColumn Header="核验状态" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="未知状态"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Indexed"><Setter Property="Text" Value="目录已存证，PDF待核验"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Critical"><Setter Property="Text" Value="目录证据异常"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Margin="8"><Hyperlink NavigateUri="{Binding SelectedReport.DocumentUrl}" RequestNavigate="OnOpenSource">打开所选官方报告PDF</Hyperlink></TextBlock></StackPanel></GroupBox><StackPanel IsEnabled="{Binding CanManage}" Margin="8"><TextBlock Text="人工核验官方原文：确认完整股东表、单位、A股及总股本口径，候选股数与PDF一致。" TextWrapping="Wrap"/>
       <WrapPanel Margin="0,8"><StackPanel><TextBlock Text="持仓截止日"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding ReportAsOf}" Width="140"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="公告日"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Published}" Width="140"/></StackPanel><StackPanel><TextBlock Text="PDF页码 / 表名"/><TextBox Width="180" Text="{Binding Page}"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="审核人"/><TextBox Width="150" Text="{Binding Reviewer}"/></StackPanel></WrapPanel>
       <TextBlock Text="官方PDF网址"/><TextBox Text="{Binding DocumentUrl}" AutomationProperties.Name="官方报告PDF网址"/>
       <WrapPanel Margin="0,8"><TextBlock Text="原文确认的机构" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding ReviewInstitutions}" SelectedItem="{Binding ReviewInstitution}" Width="160" Margin="8,0"/><TextBlock Text="简称只作候选，须据原文确认具体主体。" VerticalAlignment="Center"/></WrapPanel>
       <TextBlock Text="{Binding ComparisonStatus}" TextWrapping="Wrap" Margin="0,8"/><CheckBox Content="已逐项核对完整股东表、主体、单位、股类、股数和比例分母，与官方PDF一致" IsChecked="{Binding OriginalConfirmed}" Margin="0,8"/><CheckBox Content="已核实报告时点间股数可比，送转、拆股等不会造成虚假增减持" IsChecked="{Binding Comparable}"/><CheckBox Content="已另外核实持仓性质；未勾选保持性质待核验" IsChecked="{Binding NatureConfirmed}" Margin="0,8"/><CheckBox Content="已核实为战略控股 / 参股（否则为已核实的证券投资持仓）" IsChecked="{Binding Strategic}" IsEnabled="{Binding NatureConfirmed}" Margin="0,8"/><ui:Button Content="登记核验结果" Command="{Binding ReviewCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
     </StackPanel></ScrollViewer></TabItem></TabControl>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="股票 × 机构总览"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><TextBlock Text="沿用顶部筛选；单元格为披露记录数，各账户报告期可能不同。无记录不等于未持有，不汇总不同股票股数。" TextWrapping="Wrap" VerticalAlignment="Center"/><ui:Button Content="查看所选股票持仓图" Command="{Binding ShowMatrixStockCommand}" Margin="8,0"/></WrapPanel><DataGrid Style="{DynamicResource UiDenseDataGrid}" Grid.Row="1" ItemsSource="{Binding Matrix}" SelectedItem="{Binding SelectedMatrix}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="代码" Binding="{Binding Ticker}"/><DataGridTextColumn Header="股票" Binding="{Binding Name}"/><DataGridTemplateColumn Header="汇金投资" MinWidth="145" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Huijin.Text}" ToolTip="{Binding Huijin.Detail}" TextWrapping="Wrap" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="汇金资管" MinWidth="145" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Asset.Text}" ToolTip="{Binding Asset.Detail}" TextWrapping="Wrap" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="证金公司" MinWidth="145" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Csf.Text}" ToolTip="{Binding Csf.Detail}" TextWrapping="Wrap" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="社保基金" MinWidth="145" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Social.Text}" ToolTip="{Binding Social.Detail}" TextWrapping="Wrap" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="养老保险基金" MinWidth="145" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Pension.Text}" ToolTip="{Binding Pension.Detail}" TextWrapping="Wrap" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="外汇局投资平台" MinWidth="145" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Safe.Text}" ToolTip="{Binding Safe.Detail}" TextWrapping="Wrap" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="国家大基金" MinWidth="145" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ChipFund.Text}" ToolTip="{Binding ChipFund.Detail}" TextWrapping="Wrap" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="主体待核验" MinWidth="145" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Pending.Text}" ToolTip="{Binding Pending.Detail}" TextWrapping="Wrap" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="持仓方向" xmlns:local="clr-namespace:CRS.Plugins.NationalTeamWatch.Presentation"><local:EquityDirectionView/></TabItem>
   <TabItem Header="补入历史披露"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <TextBlock Text="只接入已经逐页核对的固定原文。登记的是报告期持仓，来源目录不代表已登记；取得和审核时间保持本次实际时间。" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <ui:Button Content="读取可补报告" Command="{Binding LoadHistoricalDocumentsCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
    <StackPanel IsEnabled="{Binding HistoricalCanEdit}">
     <ListBox Height="100" ItemsSource="{Binding HistoricalDocuments}" SelectedItem="{Binding SelectedHistoricalDocument}" DisplayMemberPath="DisplayName" AutomationProperties.Name="可补历史原文"/>
     <TextBlock Text="{Binding SelectedHistoricalDocument.Published,StringFormat=官网列示日：{0:yyyy-MM-dd}}" Margin="0,10,0,3"/>
     <TextBlock Text="{Binding SelectedHistoricalDocument.PublicationBasis}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding SelectedHistoricalDocument.ScopeText}" TextWrapping="Wrap" Margin="0,4"/>
     <TextBlock Margin="0,6"><Hyperlink NavigateUri="{Binding SelectedHistoricalDocument.DocumentUrl}" RequestNavigate="OnOpenSource">查看固定官方原文</Hyperlink></TextBlock>
     <TextBlock Text="{Binding SelectedHistoricalDocument.Pages,StringFormat=原文位置：{0}}"/>
     <WrapPanel Margin="0,10"><TextBlock Text="审核人" VerticalAlignment="Center"/><TextBox Width="240" Text="{Binding HistoricalReviewer,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="8,0" AutomationProperties.Name="历史原文审核人"/></WrapPanel>
     <TextBlock Text="登记理由"/><TextBox Text="{Binding HistoricalReason,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" TextWrapping="Wrap" Margin="0,4,0,10" AutomationProperties.Name="历史原文登记理由"/>
     <CheckBox Content="我已核对原文、股数单位和股类；本次只登记报告期持仓，不批准期间差额" IsChecked="{Binding HistoricalOriginalConfirmed}"/>
    </StackPanel>
    <WrapPanel IsEnabled="{Binding CanManage}" Margin="0,12"><ui:Button Content="登记历史原文" Command="{Binding ImportHistoricalPdfCommand}"/><ui:Button Content="查看原请求" Command="{Binding CheckHistoricalImportCommand}" Margin="8,0"/></WrapPanel>
    <TextBlock Text="{Binding HistoricalStatus}" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="观察股票设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="当前自动适配器已核验沪市十大股东；深市可登记观察，自动来源尚未接入。未核验记录不计算机构增减持。" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <DataGrid Style="{DynamicResource UiDenseDataGrid}" Height="300" ItemsSource="{Binding Watches}" SelectedItem="{Binding SelectedWatch}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="市场" Binding="{Binding Market}"/><DataGridTextColumn Header="代码" Binding="{Binding Ticker}"/><DataGridTextColumn Header="名称" Binding="{Binding Name}"/><DataGridCheckBoxColumn Header="采集" Binding="{Binding Active}"/><DataGridCheckBoxColumn Header="关注" Binding="{Binding Favorite}"/></DataGrid.Columns></DataGrid>
    <WrapPanel Margin="0,12" IsEnabled="{Binding CanManage}"><ComboBox Width="90" ItemsSource="{Binding Markets}" SelectedItem="{Binding WatchMarket}"/><TextBox Width="110" Text="{Binding WatchTicker}" MaxLength="6" Margin="8,0" AutomationProperties.Name="股票代码"/><TextBox Width="180" Text="{Binding WatchName}" AutomationProperties.Name="股票名称"/><CheckBox Content="启用采集" IsChecked="{Binding WatchActive}" Margin="8,0" VerticalAlignment="Center"/><CheckBox Content="关注" IsChecked="{Binding WatchFavorite}" VerticalAlignment="Center"/><ui:Button Content="新增" Command="{Binding NewWatchCommand}" Margin="8,0"/><ui:Button Content="保存观察设置" Command="{Binding SaveWatchCommand}"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>
