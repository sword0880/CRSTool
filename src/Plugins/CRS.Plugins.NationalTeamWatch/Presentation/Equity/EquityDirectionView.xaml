<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.EquityDirectionView" Background="{DynamicResource BrandCanvasBrush}" Foreground="{DynamicResource BrandTextPrimaryBrush}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,6"><TextBlock Text="持仓报告期" VerticalAlignment="Center"/><DatePicker Width="160" SelectedDateFormat="Short" SelectedDate="{Binding DirectionDate}" Margin="8,0" IsEnabled="{Binding DirectionIsIdle}" AutomationProperties.Name="方向报告期，留空选择最近已核期"/><ui:Button Content="读取方向报告" Command="{Binding ReadDirectionCommand}"/><TextBlock Text="留空选择最近已核期 · 使用全部启用股票" VerticalAlignment="Center" Margin="10,0"/></WrapPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,6"><TextBlock Text="{Binding DirectionStatus}" TextWrapping="Wrap"/><TextBlock Text="{Binding DirectionDenominator}" TextWrapping="Wrap" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
  <TabControl Grid.Row="2">
   <TabItem Header="行业与风格"><DataGrid Style="{DynamicResource UiDenseDataGrid}" ItemsSource="{Binding DirectionGroups}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
    <DataGridTextColumn Header="机构" Binding="{Binding Institution}" MinWidth="75"/><DataGridTextColumn Header="行业" Binding="{Binding SectorName}" MinWidth="70"/><DataGridTextColumn Header="性质" Binding="{Binding NatureText}" MinWidth="105"/><DataGridTextColumn Header="期末市值（元）" Binding="{Binding MarketValueCny,StringFormat=N2,TargetNullValue=不可计算}" MinWidth="115"/><DataGridTextColumn Header="样本权重（%）" Binding="{Binding SampleWeightPercent,StringFormat=N2,TargetNullValue=不可计算}" MinWidth="115"/><DataGridTextColumn Header="股票数" Binding="{Binding Securities}"/><DataGridTextColumn Header="账户数" Binding="{Binding Accounts}"/><DataGridTextColumn Header="分类标准" Binding="{Binding Scheme}"/><DataGridTextColumn Header="版本" Binding="{Binding SchemeVersion}"/><DataGridTextColumn Header="风格" Binding="{Binding Style}"/>
   </DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="持仓与方向核验"><Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="110"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid Style="{DynamicResource UiDenseDataGrid}" ItemsSource="{Binding DirectionPositions}" SelectedItem="{Binding SelectedDirectionPosition}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" IsEnabled="{Binding DirectionIsIdle}"><DataGrid.Columns>
     <DataGridTextColumn Header="代码" Binding="{Binding Holding.Ticker}"/><DataGridTextColumn Header="股票" Binding="{Binding Holding.Name}"/><DataGridTextColumn Header="机构/账户" Binding="{Binding Holding.Account}"/><DataGridTextColumn Header="行业" Binding="{Binding Fact.SectorName,TargetNullValue=待核验}"/><DataGridTextColumn Header="期末价（元）" Binding="{Binding Fact.ClosingPriceCny,TargetNullValue=未知}"/><DataGridTextColumn Header="原文位置" Binding="{Binding Fact.Page}"/><DataGridTextColumn Header="原件摘要" Binding="{Binding Holding.EvidenceHash}"/>
    </DataGrid.Columns></DataGrid>
    <Expander Grid.Row="1" Header="核验所选持仓的方向依据" Margin="0,6,0,0"><ScrollViewer MaxHeight="245" VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
     <TextBlock Text="只登记所选已核PDF明确披露的分类及报告截止日A股未复权人民币收盘价。原文没有的信息留空，风格不按公司名称推断；行业核验仅对这一报告期有效。" TextWrapping="Wrap"/>
     <TextBlock Margin="0,5"><Hyperlink NavigateUri="{Binding SelectedDirectionPosition.Holding.SourceUrl}" RequestNavigate="OnOpenSource">打开所选持仓官方原文</Hyperlink></TextBlock>
     <StackPanel IsEnabled="{Binding DirectionCanEdit}">
     <WrapPanel><StackPanel><TextBlock Text="分类标准"/><TextBox Width="150" MaxLength="100" Text="{Binding DirectionScheme}"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="标准版本"/><TextBox Width="100" MaxLength="100" Text="{Binding DirectionSchemeVersion}"/></StackPanel><StackPanel><TextBlock Text="行业代码"/><TextBox Width="100" MaxLength="100" Text="{Binding DirectionSectorCode}"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="行业名称"/><TextBox Width="150" MaxLength="100" Text="{Binding DirectionSectorName}"/></StackPanel><StackPanel><TextBlock Text="原文明确风格（可留空）"/><TextBox Width="170" MaxLength="100" Text="{Binding DirectionStyle}"/></StackPanel></WrapPanel>
     <WrapPanel Margin="0,6"><StackPanel><TextBlock Text="行业/风格原文页码"/><TextBox Width="170" MaxLength="100" Text="{Binding DirectionPage}"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="同报告期收盘价（可留空）"/><TextBox Width="170" MaxLength="40" Text="{Binding DirectionPrice}"/></StackPanel><StackPanel><TextBlock Text="价格原文页码"/><TextBox Width="170" MaxLength="100" Text="{Binding DirectionPricePage}"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="审核人"/><TextBox Width="150" MaxLength="100" Text="{Binding DirectionReviewer}"/></StackPanel></WrapPanel>
     <TextBlock Text="登记/更正理由"/><TextBox Text="{Binding DirectionReason}" MaxLength="500"/>
     <CheckBox Content="已核对所选原文、分类版本及期末价口径；留空项保持未知" IsChecked="{Binding DirectionOriginalConfirmed}" Margin="0,6"/>
     <ui:Button Content="登记方向核验" Command="{Binding ReviewDirectionCommand}" HorizontalAlignment="Left"/>
     </StackPanel>
    </StackPanel></ScrollViewer></Expander>
   </Grid></TabItem>
   <TabItem Header="覆盖与缺口"><DataGrid Style="{DynamicResource UiDenseDataGrid}" ItemsSource="{Binding DirectionGaps}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="市场" Binding="{Binding Market}"/><DataGridTextColumn Header="代码" Binding="{Binding Ticker}"/><DataGridTextColumn Header="股票" Binding="{Binding Name}"/><DataGridTextColumn Header="状态" Binding="{Binding StatusText}"/><DataGridTextColumn Header="待补依据" Binding="{Binding Detail}" Width="*" MinWidth="320"/></DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
 </Grid>
</UserControl>
