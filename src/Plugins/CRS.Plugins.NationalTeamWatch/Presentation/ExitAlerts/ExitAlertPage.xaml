<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.ExitAlertPage" Style="{DynamicResource UiPageRoot}" xmlns:design="clr-namespace:CRS.Plugin.Wpf;assembly=CRS.Plugin.Wpf" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <UserControl.Resources><design:BeijingTimestampConverter x:Key="RecordedTime"/></UserControl.Resources>
 <!-- 三条车道独立显示；主操作在顶部，数据表保持有限高度并支持滚动。 -->
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <WrapPanel Grid.Row="0" Style="{DynamicResource UiToolbar}"><ui:Button Content="刷新预警中心" Command="{Binding RefreshCommand}"/><ui:Button Content="后台评价并提交通知" Command="{Binding EvaluateCommand}" IsEnabled="{Binding CanEdit}" Margin="8,0" ToolTip="正式数据门槛未通过时，金融预警不会外发；已启用渠道的数据质量提醒可提交。"/></WrapPanel>
  <StackPanel Grid.Row="1"><TextBlock Text="{Binding OverviewText}" Style="{DynamicResource UiBodyText}" Margin="0,0,0,8"/><TextBlock Text="{Binding Status}" Style="{DynamicResource UiStatusWarningText}" Margin="0,0,0,8"/></StackPanel>
  <TabControl Grid.Row="2">
   <TabItem Header="事件与证据"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8">
    <WrapPanel><ComboBox ItemsSource="{Binding Lanes}" SelectedItem="{Binding Lane}" Width="180" AutomationProperties.Name="预警车道"/><ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" Width="140" Margin="8,0" AutomationProperties.Name="事件状态"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding From}" Width="130" AutomationProperties.Name="事件开始日期"/><TextBlock Text="至" Margin="6" VerticalAlignment="Center"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding To}" Width="130" AutomationProperties.Name="事件结束日期"/><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="8,0" ToolTip="搜索代码、事件或说明" AutomationProperties.Name="事件搜索"/><ui:Button Content="查询事件" Command="{Binding QueryEventsCommand}"/></WrapPanel>
    <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" design:ScrollBoundaryBehavior.ForwardAtEdge="True" MinColumnWidth="90" ColumnHeaderHeight="34" RowHeight="30" Height="320" Margin="0,8" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="车道" Binding="{Binding LaneText}" Width="120"/><DataGridTextColumn Header="级别" Binding="{Binding SeverityText}"/><DataGridTextColumn Header="事件" Binding="{Binding Headline}" Width="*" MinWidth="240"/><DataGridTextColumn Header="日期" Binding="{Binding LastTradeDate,StringFormat=yyyy-MM-dd}" Width="110"/><DataGridTextColumn Header="状态" Binding="{Binding StateText}"/><DataGridTextColumn Header="数据" Binding="{Binding DataHealthText}" Width="180"/><DataGridTextColumn Header="用途" Binding="{Binding UsageText}" Width="250"/></DataGrid.Columns></DataGrid>
    <TextBox design:ScrollBoundaryBehavior.ForwardAtEdge="True" Text="{Binding Detail,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="事件证据详情"/>
    <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" design:ScrollBoundaryBehavior.ForwardAtEdge="True" MinColumnWidth="90" ColumnHeaderHeight="34" RowHeight="30" Height="160" Margin="0,8" ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="变更序号" Binding="{Binding Sequence}"/><DataGridTextColumn Header="变更原因" Binding="{Binding KindText}"/><DataGridTextColumn Header="记录时间（北京时间）" Binding="{Binding At,Converter={StaticResource RecordedTime}}" Width="*"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="选择历史变更可查看该版本输入。输入份额、原件URL与系统接收时点如下；原件可在证据审核页导出并核验哈希。"/>
    <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" design:ScrollBoundaryBehavior.ForwardAtEdge="True" MinColumnWidth="100" Height="200" Margin="0,8" ItemsSource="{Binding Inputs}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="代码" Binding="{Binding Ticker}"/><DataGridTextColumn Header="交易日" Binding="{Binding TradeDate}"/><DataGridTextColumn Header="份额（份）" Binding="{Binding Shares}"/><DataGridTextColumn Header="首见（北京时间）" Binding="{Binding FirstSeenAt,Converter={StaticResource RecordedTime}}" Width="260"/><DataGridTextColumn Header="接受（北京时间）" Binding="{Binding AcceptedAt,Converter={StaticResource RecordedTime}}" Width="260"/><DataGridTextColumn Header="原件SHA256" Binding="{Binding OriginalHash}" Width="200"/><DataGridTemplateColumn Header="官方来源" Width="240"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock TextWrapping="Wrap"><Hyperlink NavigateUri="{Binding SourceUrl}" RequestNavigate="OnOpenSource"><Run Text="{Binding SourceUrl}"/></Hyperlink></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="通知记录"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8">
    <WrapPanel Margin="0,0,0,8"><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding NotificationFrom}" Width="140" AutomationProperties.Name="通知开始日期"/><TextBlock Text="至" Margin="8"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding NotificationTo}" Width="140" AutomationProperties.Name="通知结束日期"/><ComboBox ItemsSource="{Binding NotificationStates}" SelectedItem="{Binding NotificationState}" Width="140" Margin="8,0" AutomationProperties.Name="通知状态"/><TextBox Text="{Binding NotificationSearch,UpdateSourceTrigger=PropertyChanged}" Width="180" AutomationProperties.Name="通知渠道或标题搜索"/></WrapPanel>
    <WrapPanel><ui:Button Content="刷新通知记录" Command="{Binding RefreshNotificationsCommand}"/><ui:Button Content="重试明确未受理的通知" Command="{Binding RetryNotificationCommand}" IsEnabled="{Binding CanEdit}" Margin="8,0"/></WrapPanel>
    <TextBlock Text="渠道受理不等于送达或已读。受理结果未知的记录保留待核对，不自动重复外发；邮件服务在系统设置配置。" TextWrapping="Wrap" Margin="0,8"/>
    <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" design:ScrollBoundaryBehavior.ForwardAtEdge="True" MinColumnWidth="90" ColumnHeaderHeight="34" RowHeight="30" Height="360" ItemsSource="{Binding Notifications}" SelectedItem="{Binding SelectedNotification}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="渠道" Binding="{Binding ChannelId}"/><DataGridTextColumn Header="配置" Binding="{Binding ProfileId}"/><DataGridTextColumn Header="状态" Binding="{Binding StatusText}"/><DataGridTextColumn Header="标题" Binding="{Binding Subject}" Width="*"/><DataGridTextColumn Header="尝试次数" Binding="{Binding Attempts}"/><DataGridTextColumn Header="结果码" Binding="{Binding LastCode}"/><DataGridTextColumn Header="受理时点" Binding="{Binding AcceptedAt,Converter={StaticResource RecordedTime}}"/></DataGrid.Columns></DataGrid>
    <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" design:ScrollBoundaryBehavior.ForwardAtEdge="True" MinColumnWidth="90" ColumnHeaderHeight="34" RowHeight="30" Height="180" Margin="0,8" ItemsSource="{Binding Deliveries}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="次数" Binding="{Binding Attempt}"/><DataGridTextColumn Header="时点" Binding="{Binding At,Converter={StaticResource RecordedTime}}"/><DataGridTextColumn Header="状态" Binding="{Binding State}"/><DataGridTextColumn Header="结果码" Binding="{Binding Code}"/><DataGridTextColumn Header="提供商凭证" Binding="{Binding ProviderReceipt}" Width="*"/></DataGrid.Columns></DataGrid>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="规则与订阅"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12" IsEnabled="{Binding CanEdit}">
    <TextBlock Text="候选阈值用于研究，未经真实样本验证。规则内容更改须使用新版本号；旧事件保留，版本替换不代表市场风险解除。" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,12"><TextBlock Text="版本" VerticalAlignment="Center"/><TextBox Text="{Binding RuleVersion}" Width="150" Margin="8,0" AutomationProperties.Name="规则版本"/><CheckBox Content="启用评价与投递" IsChecked="{Binding RulesEnabled}" VerticalAlignment="Center"/></WrapPanel>
    <WrapPanel><TextBlock Text="5日下降阈值（%）" VerticalAlignment="Center"/><TextBox Text="{Binding Decline5Percent}" Width="65" Margin="8" AutomationProperties.Name="五日下降阈值"/><TextBlock Text="20日下降阈值（%）" VerticalAlignment="Center"/><TextBox Text="{Binding Decline20Percent}" Width="65" Margin="8" AutomationProperties.Name="二十日下降阈值"/></WrapPanel>
    <WrapPanel><TextBlock Text="最少独立基金" VerticalAlignment="Center"/><TextBox Text="{Binding MinimumFunds}" Width="55" Margin="8" AutomationProperties.Name="最少独立基金"/><TextBlock Text="最少管理人" VerticalAlignment="Center"/><TextBox Text="{Binding MinimumManagers}" Width="55" Margin="8" AutomationProperties.Name="最少管理人"/><TextBlock Text="连续解除观察日" VerticalAlignment="Center"/><TextBox Text="{Binding ClearObservations}" Width="55" Margin="8" AutomationProperties.Name="连续解除观察日"/></WrapPanel>
    <WrapPanel><CheckBox Content="单只观察也通知" IsChecked="{Binding NotifyWatch}" Margin="0,8,20,8"/><CheckBox Content="解除或修订撤销时通知" IsChecked="{Binding NotifyResolved}" Margin="0,8"/></WrapPanel>
    <TextBlock Text="各渠道独立订阅和去重；切换订阅不追溯重发历史事件。不填写SMTP、Webhook或口令。"/>
    <ItemsControl ItemsSource="{Binding Routes}" Margin="0,8"><ItemsControl.ItemTemplate><DataTemplate><WrapPanel Margin="0,4"><CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}" VerticalAlignment="Center" MinWidth="130"/><TextBlock Text="{Binding ChannelId}" Width="120" VerticalAlignment="Center"/><TextBlock Text="配置标识" VerticalAlignment="Center"/><TextBox Text="{Binding ProfileId,UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="8,0" AutomationProperties.Name="通知配置标识"/></WrapPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <ui:Button Content="保存规则与订阅" Command="{Binding SaveRulesCommand}" HorizontalAlignment="Left" Margin="0,8"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="ETF原件与人工核验"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12">
    <TextBlock Text="登记官方PDF后，人工逐项核对基金、管理人、可比区间和具名持仓。匿名机构不能按份额匹配身份；单位折算未经核验时不生成信号。" TextWrapping="Wrap"/>
    <ComboBox ItemsSource="{Binding ProofFunds}" SelectedItem="{Binding ProofFund}" DisplayMemberPath="Name" Width="300" HorizontalAlignment="Left" Margin="0,8" AutomationProperties.Name="原件所属ETF"/>
    <WrapPanel IsEnabled="{Binding CanEdit}"><TextBox Text="{Binding ProofUrl}" Width="520" AutomationProperties.Name="官方ETF证据PDF地址"/><ui:Button Content="登记官方PDF" Command="{Binding RegisterDocumentCommand}" Margin="8,0"/></WrapPanel>
    <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" design:ScrollBoundaryBehavior.ForwardAtEdge="True" MinColumnWidth="90" ColumnHeaderHeight="34" RowHeight="30" Height="150" Margin="0,8" ItemsSource="{Binding ProofDocuments}" SelectedItem="{Binding ProofDocument}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="官方原件" Binding="{Binding Url}" Width="*" MinWidth="300"/><DataGridTextColumn Header="系统首见（北京时间）" Binding="{Binding FirstSeenAt,Converter={StaticResource RecordedTime}}"/><DataGridTextColumn Header="SHA256" Binding="{Binding Hash}" Width="180"/></DataGrid.Columns></DataGrid>
    <TextBlock Margin="0,4"><Hyperlink NavigateUri="{Binding ProofDocument.Url}" RequestNavigate="OnOpenSource">打开所选官方PDF</Hyperlink></TextBlock>
    <GroupBox Header="披露持有人 · 待核验候选" Margin="0,12"><StackPanel Margin="8">
     <WrapPanel><ui:Button Content="读取所选原件的持有人表" Command="{Binding ReadHolderCandidatesCommand}" Margin="0,0,8,8"/><ui:Button Content="将选中行填入核验草稿" Command="{Binding UseHolderCandidateCommand}" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock Text="{Binding HolderCandidateStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock Text="登记持有人不推断受益账户；占比以上市总份额为分母。" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" design:ScrollBoundaryBehavior.ForwardAtEdge="True" Height="220" MinRowHeight="36" ScrollViewer.HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding HolderCandidates}" SelectedItem="{Binding HolderCandidate}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False"><DataGrid.Columns>
      <DataGridTextColumn Header="序号" Binding="{Binding Rank}" Width="50" MinWidth="50"/>
      <DataGridTemplateColumn Header="登记持有人" Width="*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RegisteredHolder}" ToolTip="{Binding RawHolder}" TextWrapping="Wrap" Margin="4" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="份额（份）" Binding="{Binding Shares,StringFormat={}{0:N2}}" Width="150" MinWidth="150"/>
      <DataGridTextColumn Header="上市占比（%）" Binding="{Binding PercentOfListedUnits,StringFormat={}{0:N2}}" Width="125" MinWidth="125"/>
     </DataGrid.Columns></DataGrid>
    </StackPanel></GroupBox>
    <StackPanel IsEnabled="{Binding CanEdit}">
     <WrapPanel Margin="0,8"><TextBlock Text="审核人" VerticalAlignment="Center"/><TextBox Text="{Binding ProofReviewer}" Width="180" Margin="8,0" AutomationProperties.Name="ETF原件审核人"/></WrapPanel>
     <GroupBox Header="基金身份与份额可比区间"><StackPanel Margin="8"><WrapPanel><TextBlock Text="基金标识" VerticalAlignment="Center"/><TextBox Text="{Binding FundId}" Width="130" Margin="8" AutomationProperties.Name="基金标识"/><TextBlock Text="管理人标识" VerticalAlignment="Center"/><TextBox Text="{Binding ManagerId}" Width="130" Margin="8" AutomationProperties.Name="管理人标识"/><TextBlock Text="指数标识" VerticalAlignment="Center"/><TextBox Text="{Binding IndexId}" Width="130" Margin="8" AutomationProperties.Name="指数标识"/></WrapPanel><WrapPanel><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding ComparableFrom}" Width="140" AutomationProperties.Name="可比起始日期"/><TextBlock Text="至" Margin="8"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding ComparableThrough}" Width="140" AutomationProperties.Name="可比结束日期"/></WrapPanel><CheckBox Content="已逐项核对所选原件中的身份、单位及该区间折算或合并情况" IsChecked="{Binding MetadataConfirmed}" Margin="0,8"/><ui:Button Content="保存可比性核验" Command="{Binding SaveMetadataCommand}" HorizontalAlignment="Left"/></StackPanel></GroupBox>
     <GroupBox Header="具名机构基准持仓" Margin="0,12"><StackPanel Margin="8"><WrapPanel><TextBlock Text="法人标识" VerticalAlignment="Center"/><TextBox Text="{Binding LegalEntityId}" Width="140" Margin="8" AutomationProperties.Name="法人标识"/><TextBlock Text="法人全称" VerticalAlignment="Center"/><TextBox Text="{Binding LegalName}" Width="230" Margin="8" AutomationProperties.Name="法人全称"/><TextBlock Text="具体账户" VerticalAlignment="Center"/><TextBox Text="{Binding HoldingAccount}" Width="180" Margin="8" AutomationProperties.Name="具名账户"/></WrapPanel><WrapPanel><TextBlock Text="报告基准日" VerticalAlignment="Center"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding HoldingAsOf}" Width="140" Margin="8" AutomationProperties.Name="持仓基准日"/><CheckBox Content="仅有公告日期" IsChecked="{Binding OnlyPublicationDate}" Margin="8" AutomationProperties.Name="公告仅有日期"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding HoldingPublicationDate}" IsEnabled="{Binding OnlyPublicationDate}" Width="140" Margin="8" AutomationProperties.Name="已核验的公告日期"/><TextBlock Text="准确时刻（含时区）" VerticalAlignment="Center"/><TextBox Text="{Binding PublishedAt,Converter={StaticResource RecordedTime}}" IsEnabled="{Binding HasExactPublicationTime}" Width="270" Margin="8" AutomationProperties.Name="已核验的公告时点"/></WrapPanel><TextBlock Text="{Binding PublicationTimeHint}" TextWrapping="Wrap" Margin="0,4"/><WrapPanel><TextBlock Text="持有份额（份）" VerticalAlignment="Center"/><TextBox Text="{Binding HoldingShares}" Width="150" Margin="8" AutomationProperties.Name="机构持有份额"/><TextBlock Text="原文页码和位置" VerticalAlignment="Center"/><TextBox Text="{Binding EvidencePage}" Width="320" Margin="8" AutomationProperties.Name="持仓原文位置"/></WrapPanel><CheckBox Content="已核实具名主体、账户、单位、份额及所选公告日期或时刻" IsChecked="{Binding HoldingConfirmed}" Margin="0,4"/><CheckBox Content="已核实各持仓独立、无母子公司或账户重复计入" IsChecked="{Binding IndependentOwnershipConfirmed}" Margin="0,4"/><ui:Button Content="保存具名持仓核验" Command="{Binding SaveNamedHoldingCommand}" HorizontalAlignment="Left"/></StackPanel></GroupBox>
    </StackPanel>
    <TextBlock Text="历史登记持仓：只有当前原件及独立持有关系均通过核验，才能进入机构证明。" TextWrapping="Wrap" Margin="0,8"/>
    <DataGrid Style="{DynamicResource UiReadOnlyDataGrid}" design:ScrollBoundaryBehavior.ForwardAtEdge="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" MinColumnWidth="90" ColumnHeaderHeight="34" RowHeight="30" Height="180" ItemsSource="{Binding ProofHoldings}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="原件当前通过核验" Binding="{Binding OriginalConfirmed}" Width="160" MinWidth="160"/><DataGridCheckBoxColumn Header="持有关系已核验" Binding="{Binding IndependentOwnershipConfirmed}" Width="145" MinWidth="145"/><DataGridTextColumn Header="法人" Binding="{Binding LegalName}"/><DataGridTextColumn Header="账户" Binding="{Binding Account}"/><DataGridTextColumn Header="基准日" Binding="{Binding HoldingAsOf,StringFormat={}{0:yyyy-MM-dd}}"/><DataGridTextColumn Header="份额" Binding="{Binding Shares,StringFormat=N0}"/><DataGridTextColumn Header="公告日期 / 时刻" Binding="{Binding PublicationText}" Width="230"/><DataGridTextColumn Header="系统首见" Binding="{Binding FirstSeenAt,Converter={StaticResource RecordedTime}}"/><DataGridTextColumn Header="原文位置" Binding="{Binding EvidencePage}"/></DataGrid.Columns></DataGrid>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>
