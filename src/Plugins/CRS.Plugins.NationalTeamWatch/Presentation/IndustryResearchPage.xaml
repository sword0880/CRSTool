<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.IndustryResearchPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" Style="{DynamicResource UiPageRoot}">
 <!-- 公布序列和完整低估研究分开标识，缺PB/覆盖/基本面不能由图表低点代替。 -->
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
  <TextBlock Text="行业估值研究" Style="{DynamicResource UiPageTitle}"/>
  <TextBlock Text="国证行业公布滚动PE · 深沪京市场 · 一级行业 · 剔亏样本" Margin="0,8" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <TextBlock Text="PB、市值覆盖率、价格走势和基本面尚未齐全；公布PE较低或区间分位较低都不能单独证明低估。" TextWrapping="Wrap"/>
  <WrapPanel Margin="0,12">
   <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding From}" Width="135"/><TextBlock Text="至" Margin="8,0" VerticalAlignment="Center"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Through}" Width="135"/>
   <ui:Button Content="查询已登记资料" Command="{Binding QueryCommand}" Margin="8,0"/><ui:Button Content="取消等待" Command="{Binding CancelCommand}"/>
  </WrapPanel>
  <WrapPanel Margin="0,0,0,10"><CheckBox Content="同时核对已有日期" IsChecked="{Binding RefreshSource}" IsEnabled="{Binding CanManage}" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <ui:Button Content="采集所选日期" Command="{Binding QueueCommand}"/><ui:Button Content="查询采集状态" Command="{Binding RefreshTaskCommand}" Margin="8,0"/>
  </WrapPanel>
  <TextBlock Text="{Binding TaskStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <TextBlock Text="{Binding Caption}" TextWrapping="Wrap"/>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8"/>
  <ComboBox Width="245" HorizontalAlignment="Left" ItemsSource="{Binding Metrics}" SelectedItem="{Binding Metric}" Margin="0,4,0,8"/>
  <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Row.Name}" IsChecked="{Binding IsVisible}" Margin="0,4,16,4"/></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <lvc:CartesianChart Height="360" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Bottom"/>
  <WrapPanel Margin="0,10,0,4">
   <CheckBox Content="仅显示双口径历史低位（研究筛选）" IsChecked="{Binding OnlyDualLow}" VerticalAlignment="Center"/>
  </WrapPanel>
  <TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
  <DataGrid ItemsSource="{Binding ComparisonRows}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="330" Margin="0,10">
   <DataGrid.Columns>
    <DataGridTextColumn Header="行业" Binding="{Binding Row.Name}" Width="*"/>
    <DataGridTextColumn Header="截至对照日" Binding="{Binding Row.LatestDate,StringFormat=yyyy-MM-dd,TargetNullValue=未知}"/>
    <DataGridTextColumn Header="滚动加权PE" Binding="{Binding Row.LatestRollingWeighted,StringFormat=N2,TargetNullValue=未知}"/>
    <DataGridTextColumn Header="滚动中位PE" Binding="{Binding Row.LatestRollingMedian,StringFormat=N2,TargetNullValue=未知}"/>
    <DataGridTextColumn Header="加权PE历史位置(%)" Binding="{Binding Row.PublishedSeriesPercentile,StringFormat=N1,TargetNullValue=不可计算}"/>
    <DataGridTextColumn Header="中位PE历史位置(%)" Binding="{Binding Row.PublishedMedianSeriesPercentile,StringFormat=N1,TargetNullValue=不可计算}"/>
    <DataGridTextColumn Header="加权样本" Binding="{Binding Row.PriorSamples}"/>
    <DataGridTextColumn Header="中位样本" Binding="{Binding Row.MedianPriorSamples}"/>
    <DataGridTextColumn Header="双口径历史位置" Binding="{Binding HistoricalPosition}" Width="2*"/>
    <DataGridTextColumn Header="资料状态" Binding="{Binding State}" Width="2*"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Text="研究阈值：加权及中位PE分别处于所选区间前20%低位才列为双口径观察；两类数据分别要求至少252个前置正值样本、核验交易日覆盖率≥80%，并排除当日。该阈值未经样本外验证。" TextWrapping="Wrap" Margin="0,8,0,4"/>
  <TextBlock Text="重要：国证官网公布PE剔除亏损样本；行业亏损覆盖、市值覆盖率、PB、ROE、自由现金流与供需周期均未核实。低PE可能来自周期利润高点；这里的历史位置不代表行业已低估，也不识别国家队持仓或交易。使用当前已登记版本回看历史，不能冒充历史实盘已知结果。" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</UserControl>
