<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.IndexResearchPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="行业样本指数走势与公布PB" FontWeight="Bold" FontSize="16"/><TextBlock Text="国证1000行业样本指数与国证A指分别展示。与全行业公布PE的证券范围不同；PB快照不能补造历史分位。" TextWrapping="Wrap" Margin="0,6"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,4"><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding From}" Width="140" AutomationProperties.Name="指数研究起始日期"/><TextBlock Text="至" Margin="8,0" VerticalAlignment="Center"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Through}" Width="140" AutomationProperties.Name="指数研究截止日期"/><Button Content="查询已登记资料" Command="{Binding QueryCommand}" Margin="8,0"/><Button Content="取消等待" Command="{Binding CancelCommand}"/><Button Content="采集所选日线" Command="{Binding QueuePricesCommand}" Margin="8,0"/><CheckBox Content="同时复核已有日期" IsChecked="{Binding RefreshSource}" VerticalAlignment="Center"/></WrapPanel>
  <StackPanel Grid.Row="2"><WrapPanel Margin="0,4"><TextBlock Text="估值统计日" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding SnapshotDate}" Width="140" AutomationProperties.Name="指数估值统计日期"/><Button Content="采集该日估值快照" Command="{Binding QueueValuationCommand}" Margin="8,0"/><Button Content="查询任务状态" Command="{Binding RefreshTaskCommand}"/></WrapPanel><TextBlock Text="{Binding SourceStatus}" TextWrapping="Wrap" Margin="0,4"/><TextBlock Text="{Binding TaskStatus}" TextWrapping="Wrap" Margin="0,4"/><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Margin="0,4"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4"/></StackPanel>
  <ItemsControl Grid.Row="3" ItemsSource="{Binding Rows}" Margin="0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Row.Name}" IsChecked="{Binding IsVisible}" Margin="0,0,12,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Grid Grid.Row="4">
   <lvc:CartesianChart x:Name="PriceChart" Height="290" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Bottom"><lvc:CartesianChart.Style><Style TargetType="lvc:CartesianChart"><Style.Triggers><DataTrigger Binding="{Binding HasChartValues}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></lvc:CartesianChart.Style></lvc:CartesianChart>
   <TextBlock x:Name="MissingChart" Text="当前选择尚无可展示的已核价格；走势暂不可展示。" Height="150" TextAlignment="Center" VerticalAlignment="Center" Padding="12,55"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasChartValues}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid>
  <DataGrid Grid.Row="5" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="160" Margin="0,8"><DataGrid.Columns>
   <DataGridTextColumn Header="指数" Binding="{Binding Row.Name}"/><DataGridTextColumn Header="代码" Binding="{Binding Row.Code}"/><DataGridTextColumn Header="价格日期" Binding="{Binding Row.LatestPriceDate,StringFormat=yyyy-MM-dd,TargetNullValue=未知}"/><DataGridTextColumn Header="收盘点位" Binding="{Binding Row.LatestClose,StringFormat=N4,TargetNullValue=未知}"/><DataGridTextColumn Header="有效/交易日" Binding="{Binding CoverageText}"/><DataGridTextColumn Header="价格状态" Binding="{Binding PriceText}"/><DataGridTextColumn Header="PB统计日" Binding="{Binding Row.ValuationDate,StringFormat=yyyy-MM-dd,TargetNullValue=未知}"/><DataGridTextColumn Header="公布滚动PE" Binding="{Binding Row.PublishedRollingPe,StringFormat=N4,TargetNullValue=不可计算}"/><DataGridTextColumn Header="公布PB" Binding="{Binding Row.PublishedPb,StringFormat=N4,TargetNullValue=不可计算}"/><DataGridTextColumn Header="前置PB样本" Binding="{Binding Row.PbPriorSamples}"/><DataGridTextColumn Header="估值状态" Binding="{Binding ValuationText}"/>
  </DataGrid.Columns></DataGrid>
  <TextBlock Grid.Row="6" Text="当前知识回看；历史方法一致性、市值覆盖和基本面仍待核验，机会未评估。指数样本成交不能充作国家队成交或已验证牛熊拐点。" TextWrapping="Wrap" Margin="0,4"/>
 </Grid>
</UserControl>
