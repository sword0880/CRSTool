<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.SouthboundPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
 <Grid Margin="20,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="南向累计净买入 · 年度对比" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="港股通沪＋港股通深，买入减卖出后从年初累计；每年一条折线，按相同月日比较。" Margin="0,6,0,12" TextWrapping="Wrap"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,10"><Button Content="刷新曲线" Command="{Binding QueryCommand}" Padding="14,6"/><Button Content="重置缩放" Command="{Binding ResetZoomCommand}" Margin="8,0,0,0" Padding="14,6"/><Button Content="更新数据" Command="{Binding UpdateCommand}" Margin="8,0,0,0" Padding="14,6" ToolTip="由后台更新历史数据；需要管理员权限"/><Button Content="查看更新进度" Command="{Binding TaskCommand}" Margin="8,0,0,0" Padding="14,6"/><Button Content="取消等待" Command="{Binding CancelCommand}" Margin="8,0,0,0" Padding="14,6"/></WrapPanel>
  <StackPanel Grid.Row="2"><ItemsControl ItemsSource="{Binding Years}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,18,10"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Caption}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/></StackPanel>
  <Grid Grid.Row="3" MinHeight="220">
   <!-- 空态只隐藏画面并关闭交互，保留画布布局，避免刷新后以零尺寸重建而使缩放失效。 -->
   <lvc:CartesianChart x:Name="AnnualChart" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" DrawMargin="{Binding AnnualMargin}" ZoomMode="Both" AnimationsSpeed="0:0:0" LegendPosition="Top">
    <lvc:CartesianChart.Style><Style TargetType="lvc:CartesianChart"><Style.Triggers><DataTrigger Binding="{Binding HasValues}" Value="False"><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/></DataTrigger></Style.Triggers></Style></lvc:CartesianChart.Style>
   </lvc:CartesianChart>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasValues}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,10,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding TaskStatus}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="来源：东方财富整理数据。逐年累计成交净买额，非额度净流入；所示范围仅为港股通南向交易。" Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
 </Grid>
</UserControl>
