<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.EtfHoldingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Style="{DynamicResource UiPageRoot}" Background="{DynamicResource BrandCanvasBrush}">
 <Grid Margin="16,10,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel><TextBlock Text="机构ETF持仓 · 报告目录" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="目录线索不等于已核实持仓" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BrandTextSecondaryBrush}"/></DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,8"><ComboBox ItemsSource="{Binding Funds}" SelectedItem="{Binding SelectedFund}" Width="300" Margin="0,0,8,0" AutomationProperties.Name="配置ETF监控池"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Market}"/><Run Text="{Binding Ticker}"/><Run Text="{Binding Name}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><DatePicker SelectedDate="{Binding From}" Width="138" AutomationProperties.Name="报告查询起日"/><TextBlock Text="至" Margin="8,0" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding Through}" Width="138" AutomationProperties.Name="报告查询止日"/><ui:Button Content="查找官方报告" Command="{Binding SearchReportsCommand}" Margin="8,0"/><ui:Button Content="刷新目录" Command="{Binding RefreshCommand}"/><ui:Button Content="取消等待" Command="{Binding CancelCommand}" Margin="8,0"/></WrapPanel>
  <StackPanel Grid.Row="2" Margin="0,0,0,8"><TextBlock Text="{Binding Status}" Style="{DynamicResource UiStatusWarningText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding Capture}" FontSize="12" Foreground="{DynamicResource BrandTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4"/><WrapPanel><ui:Button Content="登记所选官方原件" Command="{Binding RegisterReportCommand}"/><TextBlock Text="原件登记后仍需核验具名主体、份额和公布时点；未列示主体不填零。" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/></WrapPanel></StackPanel>
  <DataGrid Grid.Row="3" Style="{DynamicResource UiReadOnlyDataGrid}" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="34" ColumnHeaderHeight="34"><DataGrid.Columns><DataGridTextColumn Header="公告日期" Binding="{Binding Announced,StringFormat={}{0:yyyy-MM-dd}}" Width="110"/><DataGridTextColumn Header="类别" Binding="{Binding Kind}" Width="100"/><DataGridTextColumn Header="报告标题（线索）" Binding="{Binding Title}" Width="*" MinWidth="260"/><DataGridTextColumn Header="来源原时间（不推定准确时点）" Binding="{Binding OriginalPublication}" Width="200"/><DataGridTextColumn Header="官方PDF" Binding="{Binding DocumentUrl}" Width="240"/></DataGrid.Columns></DataGrid>
 </Grid>
</UserControl>
