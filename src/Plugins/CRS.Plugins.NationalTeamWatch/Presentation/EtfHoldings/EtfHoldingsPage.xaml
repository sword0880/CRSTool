<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.EtfHoldingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CRS.Plugins.NationalTeamWatch.Presentation" Style="{DynamicResource UiPageRoot}" Background="{DynamicResource BrandCanvasBrush}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="HoldingsBooleanVisibility"/></UserControl.Resources>
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,8"><TextBlock Text="机构ETF持仓与份额变化" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="结合整体份额与机构披露观察加减仓方向；机构数据有披露时滞，不能代表当日买卖。" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,8">
   <ComboBox ItemsSource="{Binding Funds}" SelectedItem="{Binding SelectedFund}" Width="280" Margin="0,0,8,0" AutomationProperties.Name="配置ETF监控池"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Ticker}"/><Run Text=" · "/><Run Text="{Binding Name}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <Button Content="刷新" Command="{Binding RefreshCommand}" ToolTip="读取所选ETF的份额变化和已核机构披露"/><Button Content="取消" Command="{Binding CancelCommand}" Margin="8,0" Visibility="{Binding Busy,Converter={StaticResource HoldingsBooleanVisibility}}"/><CheckBox Content="高级工具" IsChecked="{Binding AdvancedTools}" Margin="16,0" VerticalAlignment="Center"/>
  </WrapPanel>
  <StackPanel Grid.Row="2" Margin="0,0,0,8"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedTabIndex}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding ShareStatus}" TextWrapping="Wrap" Margin="0,0,0,6"/>
   <WrapPanel>
    <Border Width="180" Padding="10,8" Margin="0,0,8,4" Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="近1交易日份额变化" Foreground="{DynamicResource BrandTextSecondaryBrush}"/><TextBlock Text="{Binding Share1Text}" ToolTip="{Binding Share1Text}" TextTrimming="CharacterEllipsis" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
    <Border Width="180" Padding="10,8" Margin="0,0,8,4" Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="近5交易日份额变化" Foreground="{DynamicResource BrandTextSecondaryBrush}"/><TextBlock Text="{Binding Share5Text}" ToolTip="{Binding Share5Text}" TextTrimming="CharacterEllipsis" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
    <Border Width="180" Padding="10,8" Margin="0,0,0,4" Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="近20交易日份额变化" Foreground="{DynamicResource BrandTextSecondaryBrush}"/><TextBlock Text="{Binding Share20Text}" ToolTip="{Binding Share20Text}" TextTrimming="CharacterEllipsis" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
   </WrapPanel>
  </StackPanel>
  <TabControl Grid.Row="3" x:Name="HoldingTabs" SelectedIndex="{Binding SelectedTabIndex}">
   <TabItem Header="机构持仓"><local:EtfHoldingHistoryView DataContext="{Binding History}"/></TabItem>
   <TabItem Header="官方报告目录" Visibility="{Binding AdvancedTools,Converter={StaticResource HoldingsBooleanVisibility}}"><Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,6"><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding From}" Width="145" AutomationProperties.Name="报告查询起日"/><TextBlock Text="至" Margin="8,0" VerticalAlignment="Center"/><DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Through}" Width="145" AutomationProperties.Name="报告查询止日"/><Button Content="查找官方报告" Command="{Binding SearchReportsCommand}" Margin="8,0"/><Button Content="登记所选原件" Command="{Binding RegisterReportCommand}"/></WrapPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,6"><TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding Capture}" ToolTip="{Binding Capture}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,4"/><TextBlock Text="目录线索不等于已核持仓；登记原件后仍须人工核验主体、份额及公布时点。" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel>
    <DataGrid Grid.Row="2" Style="{DynamicResource UiReadOnlyDataGrid}" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="34" ColumnHeaderHeight="34" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="公告日期" Binding="{Binding Announced,StringFormat={}{0:yyyy-MM-dd}}" Width="110" MinWidth="110"/><DataGridTextColumn Header="类别" Binding="{Binding Kind}" Width="100" MinWidth="100"/><DataGridTextColumn Header="报告标题（线索）" Binding="{Binding Title}" Width="*" MinWidth="260"/><DataGridTextColumn Header="来源原时间（不推定准确时点）" Binding="{Binding OriginalPublication}" Width="200" MinWidth="200"/><DataGridTextColumn Header="官方PDF" Binding="{Binding DocumentUrl}" Width="240" MinWidth="240"/></DataGrid.Columns></DataGrid>
   </Grid></TabItem>
  </TabControl>
 </Grid>
</UserControl>
