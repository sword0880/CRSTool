<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.EtfHoldingHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource BrandCanvasBrush}">
 <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,6"><TextBlock Text="统计日" VerticalAlignment="Center"/><DatePicker Width="150" SelectedDateFormat="Short" SelectedDate="{Binding AsOf}" Margin="8,0" AutomationProperties.Name="具名ETF持仓统计日期"/><Button Content="读取已核披露" Command="{Binding QueryCommand}"/><Button Content="取消" Command="{Binding CancelCommand}" Margin="8,0"/></WrapPanel>
  <TextBlock Grid.Row="1" Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
  <TabControl Grid.Row="2">
   <TabItem Header="报告期变化"><DataGrid ItemsSource="{Binding Rows}" Style="{DynamicResource UiDenseDataGrid}" RowHeight="44" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False"><DataGrid.Columns>
    <DataGridTextColumn Header="报告期" Binding="{Binding Value.ReportAsOf,StringFormat=yyyy-MM-dd}" Width="100" MinWidth="100"/>
    <DataGridTemplateColumn Header="机构／账户" Width="190" MinWidth="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4,2" ToolTip="{Binding Value.LegalName}"><TextBlock Text="{Binding Value.InstitutionGroup}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value.Account}" FontSize="11" Foreground="{DynamicResource BrandTextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value.Account}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="175" MinWidth="175"/><DataGridTextColumn Header="期间份额差（份）" Binding="{Binding Value.Delta,TargetNullValue=无法计算}" Width="120" MinWidth="120"/>
    <DataGridTextColumn Header="披露份额（份）" Binding="{Binding Value.Shares,TargetNullValue=未知}" MinWidth="130"/><DataGridTextColumn Header="比较前期" Binding="{Binding Value.PreviousAsOf,StringFormat=yyyy-MM-dd,TargetNullValue=未知}" MinWidth="105"/>
    <DataGridTextColumn Header="法人全称" Binding="{Binding Value.LegalName}" MinWidth="230"/><DataGridTextColumn Header="法人ID" Binding="{Binding Value.LegalEntityId}" MinWidth="150"/><DataGridTextColumn Header="原件记录" Binding="{Binding References}" MinWidth="260"/>
   </DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="主体覆盖缺口"><DataGrid ItemsSource="{Binding Families}" Style="{DynamicResource UiDenseDataGrid}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="主体类别" Binding="{Binding Value.Family}" MinWidth="140"/><DataGridTextColumn Header="最新子集账户数" Binding="{Binding Value.LatestDisclosedAccounts}" MinWidth="135"/><DataGridTextColumn Header="最新基准" Binding="{Binding Value.ReportAsOf,StringFormat=yyyy-MM-dd,TargetNullValue=未知}" MinWidth="110"/><DataGridTextColumn Header="覆盖含义" Binding="{Binding StateText}" Width="*" MinWidth="260"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="基准选择与排除"><ListBox ItemsSource="{Binding SelectionDetails}" BorderThickness="0" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="8"/></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
   <TabItem Header="口径与摘要"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="{Binding Report.Basis}" TextWrapping="Wrap"/><TextBlock Text="选择最新已核披露子集时保留全部原始记录和排除原因。最新期异常不会退回旧期；未列示账户不补零。名称识别不自动批准持仓、战略用途或独立经济所有权。" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="本页使用当前已核快照；旧统计日不能重建当时审核知识。份额变化不是成交金额，资金流向仍未知；完整持仓和历史择时能力未证明。" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding Report.Fingerprint,StringFormat=输入与结果摘要：{0}}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>
