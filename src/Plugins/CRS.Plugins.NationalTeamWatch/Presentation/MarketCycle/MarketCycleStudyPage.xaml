<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.MarketCycleStudyPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CRS.Plugins.NationalTeamWatch.Presentation" xmlns:design="clr-namespace:CRS.Plugin.Wpf;assembly=CRS.Plugin.Wpf" Background="{DynamicResource BrandCanvasBrush}" Foreground="{DynamicResource BrandTextPrimaryBrush}">
 <UserControl.Resources><design:BeijingTimestampConverter x:Key="StudyTime"/></UserControl.Resources>
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8"><TextBlock Text="市场周期观察" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="候选规则 · 择时能力未验证" Margin="16,0,0,0" VerticalAlignment="Center"/></DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,8"><TextBlock Text="统计日" VerticalAlignment="Center"/><DatePicker Width="145" SelectedDateFormat="Short" SelectedDate="{Binding AsOf}" Margin="8,0" AutomationProperties.Name="周期统计日期"/><TextBlock Text="知识截止（北京）" VerticalAlignment="Center"/><TextBox Width="195" MaxLength="27" Margin="8,0" Text="{Binding CutoffText,UpdateSourceTrigger=PropertyChanged}" ToolTip="留空使用后台查询时刻；yyyy-MM-dd HH:mm:ss" AutomationProperties.Name="周期知识截止，北京时间"/><Button Content="查询" Command="{Binding QueryCommand}"/><Button Content="取消" Command="{Binding CancelCommand}" Margin="8,0"/></WrapPanel>
  <TextBlock Grid.Row="2" Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
  <StackPanel Grid.Row="3" Margin="0,0,0,8">
   <UniformGrid Columns="3"><Border BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0"><StackPanel><TextBlock Text="顶部风险观察"/><TextBlock Text="{Binding TopText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border><Border BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0"><StackPanel><TextBlock Text="底部区域观察"/><TextBlock Text="{Binding BottomText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border><Border BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10"><StackPanel><TextBlock Text="修复条件"/><TextBlock Text="{Binding RecoveryText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
   <TextBlock Text="{Binding CoverageText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
  <TabControl Grid.Row="4">
   <TabItem Header="资料缺口"><ListBox ItemsSource="{Binding Issues}" BorderThickness="0" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="6"/></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
   <TabItem Header="判断依据"><ListBox ItemsSource="{Binding Evidence}" BorderThickness="0" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="6"/></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
   <TabItem Header="原件与时点"><DataGrid ItemsSource="{Binding Sources}" Style="{DynamicResource UiDenseDataGrid}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="资料" Binding="{Binding ComponentText}" MinWidth="75"/><DataGridTextColumn Header="统计日" Binding="{Binding Date,StringFormat=yyyy-MM-dd}" MinWidth="100"/><DataGridTextColumn Header="状态" Binding="{Binding StateText}" MinWidth="95"/><DataGridTextColumn Header="状态登记（北京）" Binding="{Binding StateRecordedAt,Converter={StaticResource StudyTime}}" MinWidth="160"/><DataGridTextColumn Header="原件角色" Binding="{Binding RoleText}"/><DataGridTextColumn Header="来源" Binding="{Binding SourceUrl}"/><DataGridTextColumn Header="原件摘要" Binding="{Binding OriginalHash}"/><DataGridTextColumn Header="首次登记（北京）" Binding="{Binding FirstSeenAt,Converter={StaticResource StudyTime}}"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="统计口径"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="{Binding Scopes}" TextWrapping="Wrap"/><TextBlock Text="规则将顶部风险、底部区域、修复条件分别研究。数据齐全只表示能复算，不代表预测能力；本页不发出交易指令或退出通知。" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding Report.Rules.Version,StringFormat=规则版本：{0}}" Margin="0,12,0,0"/><TextBlock Text="{Binding Report.Fingerprint,StringFormat=冻结输入摘要：{0}}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="广度档案"><local:MarketBreadthView DataContext="{Binding Breadth}"/></TabItem>
  </TabControl>
 </Grid>
</UserControl>
