<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.MarketBreadthView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:design="clr-namespace:CRS.Plugin.Wpf;assembly=CRS.Plugin.Wpf" Background="{DynamicResource BrandCanvasBrush}" Foreground="{DynamicResource BrandTextPrimaryBrush}">
 <UserControl.Resources><design:BeijingTimestampConverter x:Key="BreadthTime"/></UserControl.Resources>
 <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,6"><DatePicker Width="150" SelectedDateFormat="Short" SelectedDate="{Binding Date}" AutomationProperties.Name="广度档案统计日期"/><Button Content="读取档案" Command="{Binding QueryCommand}" Margin="8,0"/><Button Content="回读登记结果" Command="{Binding ConfirmCommand}"/><Button Content="取消等待" Command="{Binding CancelCommand}" Margin="8,0"/><Button Content="导出原件" Click="ExportOriginal"/><Button Content="导出标准化档案" Click="ExportNormalized" Margin="8,0"/></WrapPanel>
  <TextBlock Grid.Row="1" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
  <DataGrid Grid.Row="2" Style="{DynamicResource UiDenseDataGrid}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False"><DataGrid.Columns>
   <DataGridTextColumn Header="统计日" Binding="{Binding Date,StringFormat=yyyy-MM-dd}" MinWidth="100"/><DataGridTextColumn Header="状态" Binding="{Binding StateText}" MinWidth="90"/><DataGridTextColumn Header="证券数" Binding="{Binding UniverseCount}" MinWidth="65"/><DataGridTextColumn Header="状态登记（北京）" Binding="{Binding StateRecordedAt,Converter={StaticResource BreadthTime}}" MinWidth="160"/><DataGridTextColumn Header="站上20日均线" Binding="{Binding AboveMa20Count}"/><DataGridTextColumn Header="站上60日均线" Binding="{Binding AboveMa60Count}"/><DataGridTextColumn Header="收盘创新低" Binding="{Binding NewLowCount}"/><DataGridTextColumn Header="来源" Binding="{Binding SourceUrl}"/><DataGridTextColumn Header="核验/登记人" Binding="{Binding Reviewer}"/><DataGridTextColumn Header="说明" Binding="{Binding Reason}"/><DataGridTextColumn Header="原件摘要" Binding="{Binding OriginalHash}"/>
  </DataGrid.Columns></DataGrid>
  <Expander Grid.Row="3" Header="登记与核验" IsExpanded="False" Margin="0,6,0,0"><TabControl>
   <TabItem Header="核验所选档案"><StackPanel Margin="8" IsEnabled="{Binding CanEdit}">
    <WrapPanel><TextBlock Text="核验人" VerticalAlignment="Center"/><TextBox Width="120" Text="{Binding Reviewer,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="8,0" AutomationProperties.Name="广度核验人"/><TextBlock Text="说明" VerticalAlignment="Center"/><TextBox Width="250" Text="{Binding ReviewReason,UpdateSourceTrigger=PropertyChanged}" MaxLength="240" Margin="8,0" AutomationProperties.Name="广度核验说明"/></WrapPanel>
    <CheckBox IsChecked="{Binding OriginalConfirmed}" Margin="0,8"><TextBlock Text="已核对原件、当日完整名单与复权口径；确认后才参与研究" TextWrapping="Wrap"/></CheckBox>
    <WrapPanel><Button Content="核验通过并选定此版" Command="{Binding AcceptCommand}"/><Button Content="否决此版" Command="{Binding RejectCommand}" Margin="8,0"/></WrapPanel>
   </StackPanel></TabItem>
   <TabItem Header="登记资料"><StackPanel Margin="8" IsEnabled="{Binding CanEdit}">
    <WrapPanel><Button Content="选择原件" Click="ChooseOriginal"/><TextBox Width="220" IsReadOnly="True" Text="{Binding OriginalPath}" Margin="8,0" ToolTip="{Binding OriginalPath}"/><Button Content="选择标准化档案" Click="ChooseNormalized"/><TextBox Width="220" IsReadOnly="True" Text="{Binding NormalizedPath}" Margin="8,0" ToolTip="{Binding NormalizedPath}"/></WrapPanel>
    <WrapPanel Margin="0,6"><TextBlock Text="来源网址" VerticalAlignment="Center"/><TextBox Width="250" Text="{Binding SourceUrl,UpdateSourceTrigger=PropertyChanged}" MaxLength="700" Margin="8,0" AutomationProperties.Name="广度原件来源网址"/><TextBlock Text="取得时间（北京）" VerticalAlignment="Center"/><TextBox Width="190" Text="{Binding RetrievedText,UpdateSourceTrigger=PropertyChanged}" MaxLength="27" Margin="8,0" ToolTip="按取得记录填写 yyyy-MM-dd HH:mm:ss，不是公告发布时间" AutomationProperties.Name="广度资料取得时间"/></WrapPanel>
    <WrapPanel><TextBlock Text="登记人" VerticalAlignment="Center"/><TextBox Width="120" Text="{Binding Submitter,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="8,0" AutomationProperties.Name="广度登记人"/><TextBlock Text="说明" VerticalAlignment="Center"/><TextBox Width="250" Text="{Binding SubmissionReason,UpdateSourceTrigger=PropertyChanged}" MaxLength="240" Margin="8,0" AutomationProperties.Name="广度登记说明"/><Button Content="提交待核验资料" Command="{Binding SubmitCommand}" Margin="0,0,8,0"/></WrapPanel>
   </StackPanel></TabItem>
  </TabControl></Expander>
 </Grid>
</UserControl>
