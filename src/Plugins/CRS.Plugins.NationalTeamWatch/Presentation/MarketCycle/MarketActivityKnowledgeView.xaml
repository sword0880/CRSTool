<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.MarketActivityKnowledgeView" Background="{DynamicResource BrandCanvasBrush}" Foreground="{DynamicResource BrandTextPrimaryBrush}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:design="clr-namespace:CRS.Plugin.Wpf;assembly=CRS.Plugin.Wpf">
 <UserControl.Resources><design:BeijingTimestampConverter x:Key="KnowledgeTime"/></UserControl.Resources>
 <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,6"><TextBlock Text="统计日期" VerticalAlignment="Center"/><DatePicker Width="155" SelectedDateFormat="Short" SelectedDate="{Binding From}" Margin="8,0" AutomationProperties.Name="成交知识统计起始日期"/><TextBlock Text="至" VerticalAlignment="Center"/><DatePicker Width="155" SelectedDateFormat="Short" SelectedDate="{Binding Through}" Margin="8,0" AutomationProperties.Name="成交知识统计结束日期"/><Button Content="查询知识时点" Command="{Binding QueryCommand}"/><Button Content="取消等待" Command="{Binding CancelCommand}" Margin="8,0"/></WrapPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,6"><TextBlock Text="知识截止（北京时间）" VerticalAlignment="Center"/><TextBox Width="215" Text="{Binding CutoffText,UpdateSourceTrigger=PropertyChanged}" MaxLength="27" Margin="8,0" ToolTip="yyyy-MM-dd HH:mm:ss；留空使用后台当前时刻" AutomationProperties.Name="成交知识截止时刻，北京时间"/><TextBlock Text="留空使用本次查询时刻" VerticalAlignment="Center"/></WrapPanel>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
  <DataGrid Grid.Row="3" Style="{DynamicResource UiDenseDataGrid}" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns>
   <DataGridTextColumn Header="统计日" Binding="{Binding Date,StringFormat=yyyy-MM-dd}" MinWidth="100"/><DataGridTextColumn Header="市场" Binding="{Binding Market}" MinWidth="50"/><DataGridTextColumn Header="研究状态" Binding="{Binding StateText}" MinWidth="110"/><DataGridTextColumn Header="首次系统可知" Binding="{Binding FirstSeenAt,Converter={StaticResource KnowledgeTime}}" MinWidth="160"/><DataGridTextColumn Header="状态登记时刻" Binding="{Binding StateRecordedAt,Converter={StaticResource KnowledgeTime}}" MinWidth="160"/><DataGridTextColumn Header="登记成交额（元）" Binding="{Binding AmountYuan,StringFormat=N0}" MinWidth="130"/><DataGridTextColumn Header="登记成交量（股）" Binding="{Binding VolumeShares,StringFormat=N0}" MinWidth="130"/><DataGridTextColumn Header="知识来源" Binding="{Binding KnowledgeText}" MinWidth="175"/><DataGridTextColumn Header="来源登记取得时刻" Binding="{Binding SourceRetrievedAt,Converter={StaticResource KnowledgeTime}}" MinWidth="160"/><DataGridTextColumn Header="原件摘要" Binding="{Binding EvidenceHash}"/><DataGridTextColumn Header="来源" Binding="{Binding SourceUrl}"/>
  </DataGrid.Columns></DataGrid>
 </Grid>
</UserControl>
