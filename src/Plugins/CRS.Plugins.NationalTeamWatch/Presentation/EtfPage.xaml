<UserControl x:Class="CRS.Plugins.NationalTeamWatch.Presentation.EtfPage" Background="#FBFCFD" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" xmlns:dg="clr-namespace:DataGridExtensions;assembly=DataGridExtensions">
 <!-- 页面整体向下滚动；表格单独保留有限高度和虚拟化，不与下方图表争抢首屏高度。 -->
 <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="国家队持仓与ETF观察" FontSize="24" FontWeight="Bold"/><TextBlock Text="一期只展示ETF全市场份额，份额变化不代表中央汇金交易。DataPilot不等于已确认机构持有。" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#9A5700"/></StackPanel>
  <!-- 联网采集为主入口，不再要求用户先下载文件。 -->
  <WrapPanel Grid.Row="1" Margin="0,12"><DatePicker SelectedDate="{Binding SyncFrom}" Width="130"/><TextBlock Text="至" VerticalAlignment="Center" Margin="8,0"/><DatePicker SelectedDate="{Binding SyncTo}" Width="130"/><ui:Button Content="联网采集 / 补历史" Command="{Binding SyncHistoryCommand}" IsEnabled="{Binding CanManage}" Margin="8,0"/><ui:Button Content="刷新服务数据" Command="{Binding RefreshCommand}"/><ui:Button Content="取消当前操作" Command="{Binding CancelCommand}" Margin="8,0"/></WrapPanel>
  <TabControl Grid.Row="2">
   <TabItem Header="ETF份额监控"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- 640像素配合32像素行高可显示约18条记录，更多记录继续在表格内滚动。 -->
    <DataGrid x:Name="OverviewGrid" Height="640" RowHeight="32" ColumnHeaderHeight="36" PreviewMouseWheel="OnTableMouseWheel" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single" SelectionUnit="FullRow" AutoGenerateColumns="False" IsReadOnly="True" dg:DataGridFilter.IsAutoFilterEnabled="True"><DataGrid.Columns>
     <DataGridTextColumn Header="市场" Binding="{Binding Market}"/><DataGridTextColumn Header="代码" Binding="{Binding Ticker}"/><DataGridTextColumn Header="名称" Binding="{Binding Name}"/><DataGridTextColumn Header="指数分组" Binding="{Binding IndexGroup}"/><DataGridTextColumn Header="标签" Binding="{Binding Label}"/><DataGridTextColumn Header="截至日" Binding="{Binding AsOf}"/>
     <DataGridTextColumn Header="总份额（份）" Binding="{Binding Shares,TargetNullValue=无数据,StringFormat=N0}"/><DataGridTextColumn Header="1日变化" Binding="{Binding Change1,TargetNullValue=不完整,StringFormat=N0}"/><DataGridTextColumn Header="5日变化" Binding="{Binding Change5,TargetNullValue=不完整,StringFormat=N0}"/><DataGridTextColumn Header="20日变化" Binding="{Binding Change20,TargetNullValue=不完整,StringFormat=N0}"/><DataGridTextColumn Header="状态" Binding="{Binding Status}"/><DataGridTextColumn Header="已覆盖日数" Binding="{Binding CoveredDays}"/>
    </DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="1" Margin="0,8"><WrapPanel><CheckBox Content="全部监控ETF汇总" IsChecked="{Binding AllEtfs}" VerticalAlignment="Center" ToolTip="汇总当前所有启用监控的ETF，不受表格筛选影响"/><ui:Button Content="刷新图表" Command="{Binding ShowHistoryCommand}" Margin="16,0"/></WrapPanel><TextBlock Text="{Binding ChartStatus}" TextWrapping="Wrap" Margin="0,8"/></StackPanel>
    <Border x:Name="ComparisonPanel" Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
     <StackPanel>
      <WrapPanel><TextBlock Text="ETF份额与市场成交额" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><ui:Button Content="重置缩放" Command="{Binding ResetComparisonZoomCommand}" Margin="16,0,8,0"/><ui:Button Content="刷新成交额" Command="{Binding RefreshMarketActivityCommand}"/><ui:Button Content="采集上方日期区间的成交额" Command="{Binding SyncMarketActivityCommand}" IsEnabled="{Binding CanManage}" Margin="8,0"/></WrapPanel>
      <TextBlock Text="{Binding ComparisonReadout}" TextWrapping="Wrap" MinHeight="42" Margin="0,10,0,0" AutomationProperties.Name="同日ETF与成交额读数"/>
      <TextBlock Text="监控ETF总份额（亿份）" Foreground="#2563EB" FontWeight="SemiBold"/>
      <lvc:CartesianChart x:Name="ShareChart" Height="400" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding ShareYAxes}" Sections="{Binding ShareSections}" DrawMargin="{Binding ComparisonMargin}" ZoomMode="X" TooltipPosition="Hidden" MouseMove="OnComparisonMouseMove" MouseLeave="OnComparisonMouseLeave" AnimationsSpeed="0:0:0"/>
      <TextBlock Text="沪深股票成交额（亿元）" Foreground="#475569" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <lvc:CartesianChart x:Name="AmountChart" Height="170" Series="{Binding MarketAmountSeries}" XAxes="{Binding MarketAmountAxes}" YAxes="{Binding AmountYAxes}" Sections="{Binding AmountSections}" DrawMargin="{Binding ComparisonMargin}" ZoomMode="X" TooltipPosition="Hidden" MouseMove="OnComparisonMouseMove" MouseLeave="OnComparisonMouseLeave" AnimationsSpeed="0:0:0"/>
      <TextBlock Text="{Binding MarketActivityStatus}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8"/>
      <TextBlock Text="成交额采用沪深股票口径，含B股、深市存托凭证，不含北交所、基金、债券及回购。上图是监控ETF份额，不能直接认定国家队买卖；缺失数据留空。" TextWrapping="Wrap" Foreground="#64748B" FontSize="12"/>
     </StackPanel>
    </Border>
   </Grid></TabItem>
   <TabItem Header="ETF配置与来源"><StackPanel Margin="12">
    <TextBlock Text="ETF目录与监控配置" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="内置24个观察项目默认全部监控，也可自行新增、修改和停用；停用保留历史数据。参考目录不代表已确认机构持有。采集期间保存会排队，执行情况可在任务中心查看。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8"/>
    <WrapPanel Margin="0,8,0,12"><TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding ConfigurationSearch,UpdateSourceTrigger=PropertyChanged}" Width="240" ToolTip="搜索代码、名称、市场或指数分组" AutomationProperties.Name="搜索ETF配置"/>
     <ui:Button Content="刷新目录" Command="{Binding RefreshConfigurationCommand}" Margin="12,0,8,0"/><ui:Button Content="新增ETF" Command="{Binding NewConfigurationCommand}" Click="OnEditConfiguration" IsEnabled="{Binding CanEditConfiguration}"/>
     <ui:Button Content="编辑所选" Click="OnEditConfiguration" Margin="8,0"/><TextBlock Text="{Binding ConfigurationCount}" VerticalAlignment="Center" Margin="8,0"/>
    </WrapPanel>
    <!-- 目录与监控状态独立呈现，双击定位下方编辑区域，不直接在只读表格里写库。 -->
    <DataGrid x:Name="ConfigurationGrid" Height="640" RowHeight="32" ColumnHeaderHeight="36" PreviewMouseWheel="OnTableMouseWheel" MouseDoubleClick="OnConfigurationDoubleClick" ItemsSource="{Binding ConfigurationView}" SelectedItem="{Binding SelectedConfiguration}" IsSynchronizedWithCurrentItem="False" SelectionMode="Single" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
     <DataGrid.Columns><DataGridTextColumn Header="市场" Binding="{Binding Market}" Width="70"/><DataGridTextColumn Header="代码" Binding="{Binding Ticker}" Width="85"/><DataGridTextColumn Header="ETF名称" Binding="{Binding Name}" Width="*" MinWidth="180"/><DataGridTextColumn Header="指数分组" Binding="{Binding IndexGroup}" Width="130"/><DataGridTextColumn Header="监控状态" Binding="{Binding StateText}" Width="90"/><DataGridTextColumn Header="配置来源" Binding="{Binding Origin}" Width="150"/></DataGrid.Columns>
    </DataGrid>
    <Border x:Name="ConfigurationEditor" Padding="18" Margin="0,16,0,0" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="10">
     <StackPanel IsEnabled="{Binding CanEditConfiguration}"><TextBlock Text="{Binding ConfigurationTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <WrapPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="市场（SSE上交所 / SZSE深交所）" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Markets}" SelectedItem="{Binding Market}" IsEnabled="{Binding IsNewConfiguration}" Width="210"/></StackPanel>
       <StackPanel Margin="0,0,12,12"><TextBlock Text="6位代码" Margin="0,0,0,5"/><TextBox Text="{Binding Ticker,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNewConfiguration}" Width="130" MaxLength="6"/></StackPanel>
       <StackPanel Margin="0,0,0,12"><TextBlock Text="ETF名称" Margin="0,0,0,5"/><TextBox Text="{Binding SecurityName,UpdateSourceTrigger=PropertyChanged}" Width="280" MaxLength="100"/></StackPanel>
      </WrapPanel>
      <WrapPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="跟踪指数 / 分组" Margin="0,0,0,5"/><TextBox Text="{Binding IndexGroup,UpdateSourceTrigger=PropertyChanged}" Width="210" MaxLength="64"/></StackPanel>
       <StackPanel Margin="0,0,0,12"><TextBlock Text="配置理由 / 备注" Margin="0,0,0,5"/><TextBox Text="{Binding Reason,UpdateSourceTrigger=PropertyChanged}" Width="420" MaxLength="500"/></StackPanel>
      </WrapPanel>
      <CheckBox Content="启用自动监控" IsChecked="{Binding MonitorEnabled}" Margin="0,0,0,12"/>
      <ui:Button Content="保存ETF配置" Command="{Binding SaveConfigurationCommand}" HorizontalAlignment="Left"/>
      <TextBlock Text="市场和代码是固定标识；需要更换代码时请新增标的。名称、分组、备注及监控状态均可修改。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
    <TextBlock Text="官方份额由SSE/SZSE自动采集并保存原件，关闭或锁定桌面后继续运行。执行计划在任务中心调整。候选名称与指数需核验；完整交易日历和NAV金额仍待核验。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,16"/>
   </StackPanel></TabItem>
   <!-- 日历边界和质量状态由后台判定，界面不得把缺口填成零。 -->
   <TabItem Header="成交统计修订"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12"><ui:Button Content="查询成交统计原件与修订" Command="{Binding RefreshActivityRevisionsCommand}"/><TextBlock Text="接受所选修订会否决当前已见的不同值；新来源变化仍须重新审核。" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0"/></WrapPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding ActivityRevisions}" SelectedItem="{Binding SelectedActivityRevision}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="市场" Binding="{Binding Market}"/><DataGridTextColumn Header="日期" Binding="{Binding Date}"/><DataGridTextColumn Header="成交额（元）" Binding="{Binding AmountYuan,StringFormat=N0}"/><DataGridTextColumn Header="成交量（股/份）" Binding="{Binding VolumeShares,StringFormat=N0}"/><DataGridTextColumn Header="审核状态" Binding="{Binding State}"/><DataGridTextColumn Header="官方来源" Binding="{Binding SourceUrl}" Width="*"/></DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="2" Margin="0,12"><TextBlock Text="审核人" VerticalAlignment="Center"/><TextBox Text="{Binding Reviewer}" Width="150" Margin="8,0"/><ui:Button Content="接受所选值" Command="{Binding AcceptActivityRevisionCommand}" IsEnabled="{Binding CanManage}"/><ui:Button Content="拒绝所选值" Command="{Binding RejectActivityRevisionCommand}" IsEnabled="{Binding CanManage}" Margin="8,0"/></WrapPanel>
   </Grid></TabItem>
   <TabItem Header="覆盖率与缺口"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel><TextBlock Text="先在概览选择ETF，再查询区间" VerticalAlignment="Center" Margin="0,0,12,0"/><DatePicker SelectedDate="{Binding CoverageFrom}" Width="140"/><TextBlock Text="至" VerticalAlignment="Center" Margin="8,0"/><DatePicker SelectedDate="{Binding CoverageTo}" Width="140"/><ui:Button Content="查询覆盖率" Command="{Binding ShowCoverageCommand}" Margin="12,0"/></WrapPanel>
    <TextBlock Grid.Row="1" Text="{Binding CoverageStatus}" TextWrapping="Wrap" Margin="0,12"/>
    <TabControl Grid.Row="2"><TabItem Header="交易日事实覆盖"><DataGrid Height="640" RowHeight="32" ColumnHeaderHeight="36" PreviewMouseWheel="OnTableMouseWheel" ItemsSource="{Binding CoverageDays}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="交易日" Binding="{Binding Date}"/><DataGridTextColumn Header="状态" Binding="{Binding StatusText}"/><DataGridTextColumn Header="本次采集" Binding="{Binding AttemptText}" Width="350"/><DataGridTextColumn Header="采集来源" Binding="{Binding LastAttempt.SourceUrl}" Width="180"/><DataGridTextColumn Header="解析版本" Binding="{Binding LastAttempt.ParserVersion}"/><DataGridTextColumn Header="事实修订" Binding="{Binding RevisionId}" Width="*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="采集尝试（含无日历日期）"><DataGrid Height="640" ItemsSource="{Binding CollectionAttempts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="日期" Binding="{Binding Date}"/><DataGridTextColumn Header="采集状态" Binding="{Binding StatusText}"/><DataGridTextColumn Header="原因" Binding="{Binding Reason}"/><DataGridTextColumn Header="记录时间" Binding="{Binding UpdatedAt}"/><DataGridTextColumn Header="官方来源" Binding="{Binding SourceUrl}" Width="180"/><DataGridTextColumn Header="解析版本" Binding="{Binding ParserVersion}"/><DataGridTextColumn Header="原件哈希" Binding="{Binding OriginalHash}" Width="200"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
   </Grid></TabItem>
   <TabItem Header="证据与修订审核"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="B 级市场客观数据：ETF全市场份额不代表任何机构持仓或买卖，不能据此计算机构穿透暴露。同日冲突与超过20%的相邻日跳变需人工审核。原始证据损坏时停止该数据的指标计算。" TextWrapping="Wrap" Margin="0,8"/>
    <DataGrid Grid.Row="1" Height="640" RowHeight="32" ColumnHeaderHeight="36" PreviewMouseWheel="OnTableMouseWheel" ItemsSource="{Binding Evidence}" SelectedItem="{Binding SelectedEvidence}" IsReadOnly="True" AutoGenerateColumns="True"/>
    <StackPanel Grid.Row="2" Margin="0,8"><WrapPanel><ui:Button Content="导出官方原文件" Command="{Binding ExportOriginalCommand}"/><ui:Button Content="导出标准化CSV" Command="{Binding ExportNormalizedCommand}" Margin="8,0"/></WrapPanel><CheckBox Content="已核实份额可比，排除未处理的基金折算或合并（此版本不支持折算调整）" IsChecked="{Binding ConfirmedComparable}" Margin="0,4"/><StackPanel Orientation="Horizontal"><TextBlock Text="审核人" VerticalAlignment="Center"/><TextBox Text="{Binding Reviewer}" Width="150" Margin="8,0"/><ui:Button Content="接受所选修订" Command="{Binding ApproveCommand}" IsEnabled="{Binding CanManage}"/><ui:Button Content="拒绝所选修订" Command="{Binding RejectCommand}" IsEnabled="{Binding CanManage}" Margin="8,0"/></StackPanel></StackPanel>
   </Grid></TabItem>
   <TabItem Header="预警中心"><p:ExitAlertPage xmlns:p="clr-namespace:CRS.Plugins.NationalTeamWatch.Presentation" DataContext="{Binding Alerts}"/></TabItem>
  </TabControl>
 </Grid>
 </ScrollViewer>
</UserControl>
