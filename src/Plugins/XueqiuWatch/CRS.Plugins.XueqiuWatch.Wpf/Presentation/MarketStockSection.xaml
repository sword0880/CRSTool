<UserControl x:Class="CRS.Plugins.XueqiuWatch.Wpf.MarketStockSection"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,4" LastChildFill="False">
   <StackPanel x:Name="Pager" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
    <Button x:Name="PriorPage" Content="‹" Width="28" Height="24" MinWidth="0" MinHeight="0" Padding="0"
            Click="PreviousPage" ToolTip="上一组" AutomationProperties.Name="上一组" Margin="0,0,4,0"/>
    <Button x:Name="NextPage" Content="›" Width="28" Height="24" MinWidth="0" MinHeight="0" Padding="0"
            Click="FollowingPage" ToolTip="下一组" AutomationProperties.Name="下一组"/>
   </StackPanel>
   <TextBlock x:Name="PageText" DockPanel.Dock="Right" VerticalAlignment="Center"
              Style="{DynamicResource UiHintText}" Margin="0,0,8,0"/>
  </DockPanel>
  <Grid Grid.Row="1" MinHeight="30">
   <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="Labels"/>
   <ScrollViewer x:Name="MatrixScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <Grid x:Name="Matrix"/>
   </ScrollViewer>
   <TextBlock x:Name="EmptyMessage" Grid.Column="1" Text="当前筛选范围内暂无股票" VerticalAlignment="Center"
              Margin="12,0" Style="{DynamicResource UiHintText}" Visibility="Collapsed"/>
  </Grid>
 </Grid>
</UserControl>
