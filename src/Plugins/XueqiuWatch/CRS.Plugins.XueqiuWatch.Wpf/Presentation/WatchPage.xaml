<UserControl x:Class="CRS.Plugins.XueqiuWatch.Wpf.WatchPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{DynamicResource UiPageRoot}">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <DockPanel LastChildFill="True" Margin="0,0,0,12">
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
    <Button Content="观察名单" Click="ManageAuthors" Margin="0,0,8,0"/>
    <Button Content="发言线索" Click="ShowLeads" Margin="0,0,8,0"/>
    <Button Content="录入 / 导入资料" Click="AddOpinion"/>
   </StackPanel>
   <TextBlock Text="雪球观点追踪" Style="{DynamicResource UiPageTitle}"/>
  </DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,10">
   <ComboBox x:Name="PeriodFilter" Width="96" Margin="0,0,8,4" SelectionChanged="FilterChanged"
             AutomationProperties.Name="时间范围"/>
   <ComboBox x:Name="AuthorFilter" Width="145" Margin="0,0,8,4" SelectionChanged="FilterChanged"
             DisplayMemberPath="Name" AutomationProperties.Name="作者筛选"/>
   <ComboBox x:Name="MarketFilter" Width="105" Margin="0,0,8,4" SelectionChanged="FilterChanged"
             AutomationProperties.Name="市场筛选"/>
   <ComboBox x:Name="IndustryFilter" Width="124" Margin="0,0,8,4" SelectionChanged="FilterChanged"
             AutomationProperties.Name="行业筛选"/>
   <TextBox x:Name="StockSearch" Width="148" MaxLength="80" Margin="0,0,6,4"
            KeyDown="SearchKeyDown" ToolTip="股票名称或代码" AutomationProperties.Name="股票名称或代码"/>
   <Button Content="搜索" Click="Search" Margin="0,0,8,4"/>
   <Button Content="刷新" Click="RefreshClicked" Margin="0,0,8,4"/>
  </WrapPanel>
  <Border Grid.Row="2" Style="{DynamicResource UiSurfaceCard}" Padding="11" Margin="0,0,0,8">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,7" LastChildFill="True">
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
      <TextBlock x:Name="StockPageText" VerticalAlignment="Center" Margin="0,0,8,0" Style="{DynamicResource UiHintText}"/>
      <Button x:Name="PriorStocks" Content="上一组" Click="PriorStockPage" Margin="0,0,6,0"/>
      <Button x:Name="NextStocks" Content="下一组" Click="NextStockPage"/>
     </StackPanel>
     <TextBlock Text="行业与股票" Style="{DynamicResource UiSectionTitle}" VerticalAlignment="Center"/>
    </DockPanel>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="MatrixLabels"/>
     <ScrollViewer x:Name="MatrixScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <Grid x:Name="Matrix"/>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Border>
  <TextBlock x:Name="Status" Grid.Row="3" TextWrapping="Wrap" Style="{DynamicResource UiStatusText}"
             AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
  <Border Grid.Row="4" Style="{DynamicResource UiSurfaceCard}" Padding="11">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="DetailTitle" Text="个股观点" Style="{DynamicResource UiSectionTitle}" Margin="0,0,0,7"/>
    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
     <Button Content="最新多空" Click="LatestClicked" Margin="0,0,6,3"/>
     <Button Content="观点时间线" Click="TimelineClicked" Margin="0,0,6,3"/>
     <Button Content="中性 / 待确认" Click="OtherClicked" Margin="0,0,6,3"/>
     <Button x:Name="PendingStocks" Content="待认领股票" Click="PendingClicked" Margin="0,0,6,3"/>
     <Button Content="待核实问题" Click="QuestionsClicked" Margin="0,0,6,3"/>
     <Button Content="编辑选中观点" Click="EditOpinion" Margin="0,0,6,3"/>
    </WrapPanel>
    <DataGrid Grid.Row="2" x:Name="Details" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
              SelectionMode="Single" Style="{DynamicResource UiDenseDataGrid}">
     <DataGrid.Columns>
      <DataGridTextColumn Header="多空" Width="100" Binding="{Binding Direction}"/>
      <DataGridTextColumn Header="作者" Width="125" Binding="{Binding Author}"/>
      <DataGridTextColumn Header="时间（北京时间）" Width="142" Binding="{Binding Time}"/>
      <DataGridTemplateColumn Header="内容" Width="*" MinWidth="160">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="5,4" VerticalAlignment="Center"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="原链接" Width="95">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <Button Content="查看原帖" IsEnabled="{Binding HasLink}" Click="OpenSource" HorizontalAlignment="Left"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
     <TextBlock x:Name="DetailPageText" VerticalAlignment="Center" Margin="0,0,8,0" Style="{DynamicResource UiHintText}"/>
     <Button x:Name="PriorDetails" Content="上一页" Click="PriorDetailPage" Margin="0,0,6,0"/>
     <Button x:Name="NextDetails" Content="下一页" Click="NextDetailPage"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
