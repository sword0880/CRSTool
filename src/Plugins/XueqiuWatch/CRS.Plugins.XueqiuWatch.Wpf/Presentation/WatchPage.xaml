<UserControl x:Class="CRS.Plugins.XueqiuWatch.Wpf.WatchPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Style="{DynamicResource UiPageRoot}">
 <UserControl.Resources>
  <Style x:Key="WatchIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Height" Value="36"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="MinWidth" Value="36"/>
   <Setter Property="Padding" Value="8,0"/>
  </Style>
  <ContextMenu x:Key="PostMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
   <MenuItem Header="打开原帖" Click="OpenPostFromMenu" IsEnabled="{Binding HasLink, FallbackValue=False}">
    <MenuItem.Icon><ui:SymbolIcon Symbol="Open20" FontSize="16"/></MenuItem.Icon>
   </MenuItem>
   <MenuItem Header="查看抓取后的正文" Click="ShowPostBody" IsEnabled="{Binding HasLink, FallbackValue=False}">
    <MenuItem.Icon><ui:SymbolIcon Symbol="Document20" FontSize="16"/></MenuItem.Icon>
   </MenuItem>
  </ContextMenu>
 </UserControl.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <DockPanel LastChildFill="True" Margin="0,0,0,10">
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
    <Grid Width="214" Margin="0,0,8,0">
     <TextBox x:Name="StockSearch" MaxLength="80" MinHeight="36" Padding="10,0,38,0"
              VerticalContentAlignment="Center" KeyDown="SearchKeyDown" AutomationProperties.Name="股票名称或代码"/>
     <TextBlock Text="股票名称或代码" Margin="11,0,36,0" VerticalAlignment="Center"
                Foreground="{DynamicResource BrandTextHintBrush}" IsHitTestVisible="False">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding Text, ElementName=StockSearch}" Value="">
          <Setter Property="Visibility" Value="Visible"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
     <Button Click="Search" Style="{StaticResource WatchIconButton}" Width="31" Height="29" MinWidth="0"
             Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Right"
             VerticalAlignment="Center" Margin="0,0,3,0" ToolTip="搜索股票" AutomationProperties.Name="搜索股票">
      <ui:SymbolIcon Symbol="Search20" FontSize="17"/>
     </Button>
    </Grid>
    <ComboBox x:Name="PeriodFilter" Width="100" MinHeight="36" Margin="0,0,8,0"
              SelectionChanged="FilterChanged" AutomationProperties.Name="时间范围"/>
    <ComboBox x:Name="AuthorFilter" Width="145" MinHeight="36" Margin="0,0,8,0"
              SelectionChanged="FilterChanged" DisplayMemberPath="Name" AutomationProperties.Name="作者筛选"/>
    <Button Click="RefreshClicked" Margin="0,0,8,0" Style="{StaticResource WatchIconButton}"
            ToolTip="刷新" AutomationProperties.Name="刷新">
     <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18"/>
    </Button>
    <Button Click="ManageAuthors" Margin="0,0,8,0" Style="{StaticResource WatchIconButton}"
            ToolTip="设置作者" AutomationProperties.Name="设置作者">
     <ui:SymbolIcon Symbol="Person24" FontSize="19"/>
    </Button>
    <Button x:Name="LeadsButton" Click="ShowLeads" Style="{StaticResource WatchIconButton}"
            ToolTip="发言线索" AutomationProperties.Name="发言线索">
     <StackPanel Orientation="Horizontal">
      <ui:SymbolIcon Symbol="Chat24" FontSize="19" VerticalAlignment="Center"/>
      <Border x:Name="LeadsBadge" Visibility="Collapsed" Margin="5,0,0,0" Padding="5,1" CornerRadius="8"
              Background="{DynamicResource BrandAccentPaleBrush}" VerticalAlignment="Center">
       <TextBlock x:Name="LeadsCount" FontSize="11" FontWeight="SemiBold"
                  Foreground="{DynamicResource BrandAccentDarkBrush}"/>
      </Border>
     </StackPanel>
    </Button>
   </StackPanel>
   <TextBlock Text="雪球观点追踪" Style="{DynamicResource UiPageTitle}"/>
  </DockPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
   <TextBlock Text="明细视图" VerticalAlignment="Center" Margin="0,0,8,0" Style="{DynamicResource UiHintText}"/>
   <TextBlock Text="原帖提及" VerticalAlignment="Center" Style="{DynamicResource UiHintText}"/>
  </StackPanel>
  <Border Grid.Row="2" Style="{DynamicResource UiSurfaceCard}" Padding="11" Margin="0,0,0,8">
   <Grid>
    <TabControl x:Name="MarketTabs" Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="股票市场" SelectionChanged="MarketChanged"/>
    <Button x:Name="StockVisibilityButton" Click="ShowStockVisibility" IsEnabled="False" Width="32" Height="32"
            MinWidth="0" MinHeight="0" Padding="5" HorizontalAlignment="Right" VerticalAlignment="Top"
            ToolTip="管理股票显示" AutomationProperties.Name="管理股票显示"/>
   </Grid>
  </Border>
  <TextBlock x:Name="Status" Grid.Row="3" TextWrapping="Wrap" Style="{DynamicResource UiStatusText}"
             AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
  <Border Grid.Row="4" Style="{DynamicResource UiSurfaceCard}" Padding="11">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="DetailTitle" Text="个股原帖提及" Style="{DynamicResource UiSectionTitle}" Margin="0,0,0,7"/>
    <ScrollViewer Grid.Row="1" x:Name="MentionAuthorSummary" Visibility="Collapsed" MaxHeight="78" Margin="0,0,0,6"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <TextBlock x:Name="MentionAuthorCounts" TextWrapping="Wrap" Style="{DynamicResource UiHintText}"
                AutomationProperties.LiveSetting="Polite"/>
    </ScrollViewer>
    <DataGrid Grid.Row="2" x:Name="Details" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
              SelectionMode="Single" Style="{DynamicResource UiDenseDataGrid}">
     <DataGrid.RowStyle>
      <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
       <Setter Property="ContextMenu" Value="{StaticResource PostMenu}"/>
      </Style>
     </DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn Header="方向 / 类型" Width="100" Binding="{Binding Direction}"/>
      <DataGridTextColumn Header="作者" Width="125" Binding="{Binding Author}"/>
      <DataGridTextColumn Header="时间（北京时间）" Width="142" Binding="{Binding Time}"/>
      <DataGridTemplateColumn Header="内容" Width="*" MinWidth="160">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Padding="5,4" Background="Transparent"
                   MouseLeftButtonDown="ContentMouseDown" Focusable="True" KeyDown="ContentKeyDown">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Style.Triggers>
            <DataTrigger Binding="{Binding HasLink}" Value="True">
             <Setter Property="Cursor" Value="Hand"/>
             <Setter Property="ToolTip" Value="右键查看原帖选项，双击内容打开原帖"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
     <TextBlock x:Name="DetailPageText" VerticalAlignment="Center" Margin="0,0,8,0" Style="{DynamicResource UiHintText}"/>
     <Button x:Name="PriorDetails" Content="上一页" Click="PriorDetailPage" Margin="0,0,6,0"/>
     <Button x:Name="NextDetails" Content="下一页" Click="NextDetailPage"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
