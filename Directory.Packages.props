<Project>
  <ItemGroup>
    <!-- 服务宿主使用当前离线缓存中可复现的扩展版本；与 .NET 10 联合构建验证。 -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <!-- 主程序集中拥有计划任务驱动，插件契约不引用Quartz。 -->
    <PackageVersion Include="Quartz" Version="4.1.0" />
    <!-- 邮件只在独立Worker发送，固定支持强制STARTTLS和465直接TLS的SMTP实现。 -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="DataGridExtensions" Version="2.9.1" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageVersion Include="NPOI" Version="2.8.1" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="NLog" Version="6.2.1" />
    <!-- 明确使用 SQLCipher 原生提供器，禁止标准 SQLite bundle 混入运行时。 -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <!-- 离线二维码仅生成内存 PNG，不保存绑定秘密。 -->
    <PackageVersion Include="QRCoder" Version="1.7.0" />
    <!-- 修复 GHSA-7hqp-7c5m-4vq6，统一覆盖 NPOI 引入的 XML 加密依赖。 -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- 固定间接依赖的修复版本，消除 GHSA-2fmv-rv2c-59x7 拒绝服务漏洞。 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- 本机日常登录由 Windows 当前用户保护密钥，跨机恢复仍使用独立恢复槽。 -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
</Project>
